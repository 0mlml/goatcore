%%{init: {'theme': 'base', 'themeVariables': {'fontSize': '13px'}}}%%
graph TB
  subgraph SOURCES["Audit sources"]
    direction TB
    S1[audit-logger interceptor<br/>0508]
    S2["Falco / osquery / auditd<br/>0800"]
    S3[policy-engine events<br/>0805]
    S4[admit-audit sidecar<br/>0816]
    S5[setup-key + ACL events]
  end

  subgraph TIER["Three-layer integrity tier"]
    direction TB
    L1["Layer 1: MinIO Object Lock<br/>compliance mode<br/>1y online + 6y archive"]
    L2["Layer 2: hash-chain ledger<br/>per-record + chain head signed"]
    L3["Layer 3: daily CI walk<br/>verifies every record<br/>alerts on chain break"]
    L1 --- L2
    L2 --- L3
  end

  XMOUNT["Cross-mount<br/>Router-A ↔ Router-B<br/>survives single-host loss"]:::xm

  SOURCES ==> TIER
  TIER -.- XMOUNT

  classDef xm fill:#fff3e0,stroke:#f57c00
  style SOURCES fill:#e3f2fd,stroke:#1976d2
  style TIER fill:#e8f5e9,stroke:#388e3c
