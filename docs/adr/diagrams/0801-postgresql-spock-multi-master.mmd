flowchart LR
  subgraph S1["Site 1"]
    S1_PA[("postgres-A<br/>PRIMARY<br/>Spock node ACTIVE")]
    S1_PB[("postgres-B<br/>streaming replica<br/>Spock dormant")]
    S1_PA ==>|"native PG streaming replication<br/>synchronous remote_write"| S1_PB
  end

  subgraph S2["Site 2"]
    S2_PA[("postgres-A<br/>PRIMARY<br/>Spock node ACTIVE")]
    S2_PB[("postgres-B<br/>streaming replica<br/>Spock dormant")]
    S2_PA ==>|"native PG streaming replication"| S2_PB
  end

  subgraph S3["Site 3"]
    S3_PA[("postgres-A<br/>PRIMARY<br/>Spock node ACTIVE")]
    S3_PB[("postgres-B<br/>streaming replica<br/>Spock dormant")]
    S3_PA ==>|"native PG streaming replication"| S3_PB
  end

  S1_PA <==>|"Spock logical multi-master<br/>(only active PRIMARY peers)"| S2_PA
  S2_PA <==>|"Spock logical multi-master"| S3_PA
  S1_PA <==>|"Spock logical multi-master"| S3_PA

  NOTE["Two replication mechanisms:<br/>(1) intra-site = native Postgres streaming (Router-A primary → Router-B warm replica) — see ADR 0205<br/>(2) cross-site = Spock multi-master between active primaries — every site can write<br/>Conflict resolution: per-table classes — LWW · server-id-in-PK.<br/>Cross-site PITR is NOT offered — see ADR 0803."]

