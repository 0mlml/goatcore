%%{init: {'theme': 'base', 'themeVariables': {'fontSize': '13px'}}}%%
graph TB
  subgraph SITE["Production site (Router-A / Router-B pair)"]
    direction LR
    subgraph RA["Router-A"]
      PA[(postgres-A)]
      SA[stanza:<br/>&lt;site&gt;-a-netbird]
      RAR[(/opt/docker-data/<br/>pgbackrest local NVMe)]
      PA -- archive WAL --> SA
      SA --> RAR
    end
    subgraph RB["Router-B"]
      PB[(postgres-B)]
      SB[stanza:<br/>&lt;site&gt;-b-netbird]
      RBR[(/opt/docker-data/<br/>pgbackrest local NVMe)]
      PB -- archive WAL --> SB
      SB --> RBR
    end
  end

  PITR["Site-local PITR<br/>7-day window<br/>(per stanza)"]:::ok
  RAR -. supports .-> PITR
  RBR -. supports .-> PITR

  CROSS["Cross-site site-loss durability<br/>via Spock multi-master (0801)<br/>(NOT cross-site PITR — see 0803)"]:::note

  NOCLOUD["No cloud in routine path<br/>(sovereign per-site)"]:::ok

  classDef ok fill:#c8e6c9,stroke:#2e7d32
  classDef note fill:#fff3e0,stroke:#f57c00
  style SITE fill:#e3f2fd,stroke:#1976d2
