%%{init: {'theme': 'base', 'themeVariables': {'fontSize': '13px'}}}%%
flowchart TB
  CLIENT[Mesh peer or service consumer]
  CLIENT --> VIP[("Virtual IP — keepalived VRRP<br/>only one host holds the VIP at a time")]

  subgraph SITE["Site (intra-site failover pair — two identical mgmt hosts)"]
    direction LR

    subgraph RA["Router-A · MASTER (currently active)"]
      direction TB
      RA_NB["NetBird mgmt + signal + rathole + dnsmasq"]
      RA_PG["Postgres PRIMARY<br/>+ Spock node ACTIVE<br/>(peers across sites)"]
      RA_BK["pgBackRest stanza<br/>local NVMe repo"]
      RA_NB --- RA_PG
      RA_PG --- RA_BK
    end

    subgraph RB["Router-B · BACKUP (warm standby)"]
      direction TB
      RB_NB["NetBird mgmt + signal + rathole + dnsmasq<br/>(installed; not bound to VIP)"]
      RB_PG["Postgres STREAMING REPLICA<br/>+ Spock node DORMANT<br/>(activates on promotion)"]
      RB_BK["pgBackRest stanza<br/>local NVMe repo"]
      RB_NB --- RB_PG
      RB_PG --- RB_BK
    end

    RA <-. "keepalived heartbeat<br/>failover &lt; 3s · pg_promote()" .-> RB
    RA_PG ==>|"native PG streaming replication<br/>synchronous remote_write over LAN"| RB_PG
  end

  VIP -. "binds to whichever<br/>host is MASTER" .-> RA

  RA_PG <==>|"Spock multi-master to other sites<br/>(only the active PRIMARY peers — see ADR 0204)"| OUT(("other sites"))

  NOTE["Both routers run identical software stacks. Only the active MASTER is the Postgres primary<br/>and the active Spock node; the BACKUP is a warm streaming replica that promotes on failover."]

  style SITE fill:#e3f2fd,stroke:#1976d2
  style VIP fill:#fff3e0,stroke:#f57c00,stroke-width:2px
  style RA fill:#c8e6c9,stroke:#2e7d32
  style RB fill:#fafafa,stroke:#9e9e9e
  style OUT fill:#fafafa,stroke:#9e9e9e,stroke-dasharray: 3 3
  style NOTE fill:#fafafa,stroke:#9e9e9e,stroke-dasharray: 3 3
