graph TB
  PEER["Peer<br/>(behind CGNAT / mobile / forward)"]

  DNS["netbird.legacy.example<br/>DNS round-robin (Cloudflare)"]

  subgraph VPSES["VPS relay set — 3 cloud regions"]
    R1["region 1<br/>rathole · Coturn · NB relay"]
    R2["region 2<br/>rathole · Coturn · NB relay"]
    R3["region 3<br/>rathole · Coturn · NB relay"]
  end

  HOST["Network host (mgmt plane)<br/>NetBird mgmt + signal + Spock"]

  PEER -- enrollment HTTPS:443 --> DNS
  DNS -. round-robin .-> R1
  DNS -. round-robin .-> R2
  DNS -. round-robin .-> R3
  R1 -- rathole tunnel --> HOST
  R2 -- rathole tunnel --> HOST
  R3 -- rathole tunnel --> HOST

  PEER -. STUN UDP:3478 .-> R1
  PEER -. data relay TCP:33073<br/>(P2P fallback) .-> R1

  NOTE["Concrete cloud-region selection<br/>lives in terraform/ — not in this ADR."]

  style VPSES fill:#fff3e0,stroke:#f57c00
  style HOST fill:#e8f5e9,stroke:#388e3c
  style PEER fill:#e3f2fd,stroke:#1976d2
  style NOTE fill:#fafafa,stroke:#9e9e9e,stroke-dasharray: 3 3
