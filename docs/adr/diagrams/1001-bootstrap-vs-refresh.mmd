%%{init: {'theme': 'base', 'themeVariables': {'fontSize': '13px'}}}%%
graph LR
  subgraph PHASE1["Phase 1: Bootstrap (once per env)"]
    direction TB
    B1[Terraform apply]
    B2[inventory/generate.sh<br/>SSM-connection inventory]
    B3["&lt;env&gt;-bootstrap.yml<br/>over AWS SSM<br/>~30-40 min"]
    B4[NetBird up<br/>+ enroll into mesh]
    B1 --> B2 --> B3 --> B4
  end

  subgraph PHASE2["Phase 2: Refresh (routine)"]
    direction TB
    R1[Fill mesh IPs into<br/>inventory/mgmt-hosts-mesh.ini]
    R2["&lt;env&gt;-refresh.yml<br/>over SSH-over-mesh<br/>~3-5 min"]
    R3[Drift-prone phases only<br/>obs / admit-audit / Zenoh]
    R1 --> R2 --> R3
  end

  PHASE1 ==> PHASE2

  REBUILD["Bootstrap remains available<br/>for full rebuilds /<br/>one-time-phase changes"]:::note

  PHASE2 -. fall back to .-> PHASE1

  classDef note fill:#fff3e0,stroke:#f57c00
  style PHASE1 fill:#e3f2fd,stroke:#1976d2
  style PHASE2 fill:#e8f5e9,stroke:#388e3c
