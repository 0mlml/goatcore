%%{init: {'theme': 'base', 'themeVariables': {'fontSize': '13px'}}}%%
graph LR
  subgraph PUBLIC["Public DNS tier (Cloudflare)"]
    direction TB
    CF[Cloudflare DNS<br/>+ DNSSEC]
    NB1[netbird.legacy.example]
    NB2[bridge.legacy.example]
    CF --- NB1
    CF --- NB2
  end

  subgraph MESH["Mesh-internal DNS tier"]
    direction TB
    CD[CoreDNS on network host]
    DM[dnsmasq on each VPS relay]
    ZONE[mesh-hosts zone file<br/>ops/dns/mesh-hosts]
    CD -. reads .- ZONE
    DM -. reads .- ZONE
  end

  EP[New peer<br/>enrolling]
  IP[Enrolled peer<br/>resolving service]

  EP -- enrollment HTTPS --> NB1
  IP -- "*.netbird.legacy.example<br/>resolved via mesh" --> CD

  style PUBLIC fill:#e3f2fd,stroke:#1976d2
  style MESH fill:#e8f5e9,stroke:#388e3c
