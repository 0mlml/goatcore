graph TB
  PEER["Mesh peer<br/>wants public egress"]

  T0{"Tier 0<br/>DNS egress control<br/>(block DoH/DoT)"}
  T1{"Tier 1<br/>nftables default-deny<br/>at Router-A/B"}
  T2{"Tier 2<br/>Squid HTTP/HTTPS<br/>SNI allowlist (no MITM)"}
  T3{"Tier 3<br/>dante SOCKS5<br/>narrow non-HTTP"}
  T4{"Tier 4<br/>direct CIDR allowlist<br/>time-bounded auto-expire"}

  PEER --> T0
  T0 -- mesh resolver only --> T1
  T1 -- forwarded --> T2
  T1 -. SOCKS class .-> T3
  T1 -. exception class<br/>(approved via 0805) .-> T4

  T2 -- match --> NET[Public internet]
  T3 -- match --> NET
  T4 -- match --> NET

  T1 -. deny .-> DROP[(blocked + audited)]
  T2 -. deny .-> DROP
  T3 -. deny .-> DROP

  AUDIT["§5.6 Audit-log integrity tier<br/>(MinIO Object Lock + ledger)"]:::audit
  T1 -.-> AUDIT
  T2 -.-> AUDIT
  T3 -.-> AUDIT
  T4 -.-> AUDIT

