graph TB
  HOST[mgmt-host disk layout]

  HOST --> T1
  HOST --> T2
  HOST --> T3

  T1["Tier 1: read-only system<br/>(/, /usr — read-only mounts)<br/>protected by Secure Boot +<br/>signed shim + dm-verity (0809)"]:::tier1

  T2["Tier 2: mutable system<br/>(/var, /home, /tmp, /etc)<br/>protected by LUKS (0604)"]:::tier2

  T3["Tier 3: data<br/>(/opt/docker-data)<br/>1TB+ NVMe (0905)<br/>LUKS-encrypted<br/>cross-mounted A↔B for audit (0811)"]:::tier3

  T3 -.- DB[(Postgres + Spock)]
  T3 -.- BACKUP[(pgBackRest stanza)]
  T3 -.- AUDIT[(MinIO audit objects)]
  T3 -.- METRICS[(Prometheus TSDB)]

  classDef tier1 fill:#fff3e0,stroke:#f57c00
  classDef tier2 fill:#e3f2fd,stroke:#1976d2
