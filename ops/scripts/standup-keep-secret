#!/usr/bin/env python3
"""standup-keep-secret NAME: keep a value a standup step just minted, where later phases read it.

Under a value store (env-file, sops, git-crypt; ADR 1204) every standup phase runs in
its own process and reads the store afresh (ops/scripts/standup-phase-run), so a value
a step loads into its own shell is gone by the next phase. This writes $NAME from this
process's environment into that store through posture.set_values: in-process, never
printed, never on a command line, never rotated if the store already holds one.
Under a reference store (1password, openbao, vaultwarden, custom) or env it changes
nothing: those drivers keep the value as they always have.

exit 0 kept, written or nothing to do · 1 NAME is empty here · 2 usage or store error
"""
import importlib.util
import os
import re
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parents[2]


def main(argv):
    if len(argv) != 1 or not re.fullmatch(r"[A-Z][A-Z0-9_]*", argv[0]):
        print("usage: standup-keep-secret NAME", file=sys.stderr)
        return 2
    name = argv[0]
    spec = importlib.util.spec_from_file_location("posture", REPO / "ops/secrets/posture.py")
    p = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(p)
    try:
        store = p.store(str(REPO))
    except p.PostureError as e:
        print(f"standup-keep-secret: {e}", file=sys.stderr)
        return 2
    if store not in p.VALUE_STORES:
        print(f"    {name}: the {store} store is not a value store; nothing stored here")
        return 0
    value = os.environ.get(name, "")
    if not value:
        print(f"standup-keep-secret: {name} is empty in this environment; nothing to keep", file=sys.stderr)
        return 1
    try:
        state = p.set_values({name: value}, str(REPO))[name]
    except p.PostureError as e:
        print(f"standup-keep-secret: {e}", file=sys.stderr)
        return 2
    print(f"    {name}: {state} in the {store} store, so the phases after this one read it")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
