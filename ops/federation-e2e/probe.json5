// A real zenoh session across the link holding a chosen identity: zenohd in client
// mode, driven over its REST plugin. The image ships no client binary.
{
  mode: "client",
  id: "__ZID__",
  connect: { endpoints: ["tls/__FAR_LINK_IP__:7448"] },
  listen: { endpoints: [] },
  scouting: { multicast: { enabled: false }, gossip: { enabled: false } },
  transport: {
    link: {
      tls: {
        enable_mtls: true,
        root_ca_certificate: "/probe/far-ca.pem",
        connect_certificate: "/probe/cert.pem",
        connect_private_key: "/probe/key.pem",
      },
    },
  },
  plugins_loading: { enabled: true, search_dirs: ["/"] },
  plugins: { rest: { http_port: "__REST_ADDR__:__REST_PORT__" } },
  adminspace: { permissions: { read: false, write: false } },
}
