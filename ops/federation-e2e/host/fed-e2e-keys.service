[Unit]
Description=Install the run's ssh key for the operator and root
Before=ssh.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'for h in /home/goat /root; do install -d -m 0700 $h/.ssh; install -m 0600 /etc/fed-e2e/id_ed25519.pub $h/.ssh/authorized_keys; install -m 0600 /etc/fed-e2e/id_ed25519 $h/.ssh/id_ed25519; printf "Host *\\n  StrictHostKeyChecking no\\n  UserKnownHostsFile /dev/null\\n  LogLevel ERROR\\n" > $h/.ssh/config; chmod 600 $h/.ssh/config; done; chown -R goat:goat /home/goat/.ssh'

[Install]
WantedBy=multi-user.target
