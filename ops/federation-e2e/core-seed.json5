// A sovereign's core router for the federation end-to-end run. The four marker
// regions are the ones acl-assemble.py splices (roles/goat-zenoh/files), and the
// generated fragment is the only thing that ever fills them, so what the edge is
// allowed to do on this core is exactly what `goat federate apply` rendered.
//
// The storages are the receiving side's record: tier 2 reads a delivery back from
// here, and our own wire name, `ops/fabric/**` and the not-granted prefix are held so
// that a refused key that did cross would be readable. The REST surface exists because
// this is a drill: on a container host it listens on the internal network, on a real
// host on loopback only.
{
  mode: "router",
  listen: { endpoints: ["tls/__CORE_LISTEN__:7447"] },
  scouting: { gossip: { enabled: false }, multicast: { enabled: false } },
  adminspace: { permissions: { read: true, write: false } },
  transport: {
    link: {
      tls: {
        root_ca_certificate: "/etc/goat-core/ca.pem",
        listen_certificate: "/etc/goat-core/core.pem",
        listen_private_key: "/etc/goat-core/core-key.pem",
        enable_mtls: true,
      },
    },
  },
  plugins_loading: { enabled: true, search_dirs: ["/"] },
  plugins: {
    rest: { http_port: "__CORE_REST__:8000" },
    storage_manager: {
      storages: {
        landing: { key_expr: "from/__THEM__/**", volume: "memory" },
        own_wire: { key_expr: "from/__US__/**", volume: "memory" },
        refused_ops: { key_expr: "ops/fabric/**", volume: "memory" },
        refused_prefix: { key_expr: "from/__THEM__-not-granted/**", volume: "memory" },
        // BEGIN: per-vendor storages
        // END: per-vendor storages
      },
    },
  },
  access_control: {
    enabled: true,
    default_permission: "deny",
    rules: [
      // BEGIN: per-vendor write rules
      // END: per-vendor write rules
    ],
    subjects: [
      // BEGIN: per-vendor subjects
      // END: per-vendor subjects
    ],
    policies: [
      // BEGIN: per-vendor policies
      // END: per-vendor policies
    ],
  },
}
