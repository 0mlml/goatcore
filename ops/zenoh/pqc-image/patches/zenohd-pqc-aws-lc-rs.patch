@@ -77,6 +77,16 @@ struct Args {
 }
 
 fn main() {
+    // goat PQC: install the aws-lc-rs CryptoProvider (X25519MLKEM768-capable)
+    // as the process default BEFORE any TLS/QUIC link initializes. zenoh's
+    // link crates call ring::default_provider().install_default().ok() and
+    // ignore the error when a provider is already installed, so this single
+    // call flips every rustls ClientConfig/ServerConfig built via builder()
+    // to the aws-lc-rs provider without touching any zenoh library crate.
+    rustls::crypto::aws_lc_rs::default_provider()
+        .install_default()
+        .expect("goat PQC: aws-lc-rs CryptoProvider install must be first");
+
