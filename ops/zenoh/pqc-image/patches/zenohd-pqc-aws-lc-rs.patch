--- a/zenohd/Cargo.toml
+++ b/zenohd/Cargo.toml
@@ -30,6 +30,10 @@ default = ["zenoh/default"]
 shared-memory = ["zenoh/shared-memory"]
 
 [dependencies]
+# goat PQC: pull in rustls with the aws-lc-rs provider + X25519MLKEM768
+# preferred, so main() can install it as the process-default CryptoProvider.
+# Additive with the workspace "ring" feature; the installed default wins.
+rustls = { workspace = true, features = ["aws-lc-rs", "prefer-post-quantum"] }
 clap = { workspace = true, features = ["derive"] }
 git-version = { workspace = true }
 json5 = { workspace = true }
