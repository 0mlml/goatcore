{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "goat/e2e-report/v1",
  "title": "One step of a deployment e2e run (docs/design/deployment-e2e.md §The run record)",
  "type": "object",
  "additionalProperties": false,
  "required": ["n", "name", "status", "command", "exit", "expected_exit", "duration_s", "started", "log"],
  "properties": {
    "n": {"type": "integer", "minimum": 1},
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "status": {"enum": ["pass", "fail", "xfail"]},
    "command": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "cwd": {"type": "string"},
    "exit": {"type": "integer"},
    "expected_exit": {"type": "integer"},
    "duration_s": {"type": "number", "minimum": 0},
    "started": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "log": {"type": "string"},
    "tail": {"type": "string"},
    "why": {"type": "string"},
    "xfail": {"type": "string"},
    "note": {"type": "string"},
    "ledger_rows": {
      "type": "array",
      "items": {"type": "object", "required": ["host", "component", "row"],
                "properties": {"host": {"type": "string"}, "component": {"type": "string"}, "row": {"type": "string"}}}
    }
  }
}
