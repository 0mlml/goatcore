#!/usr/bin/env bash
# A stand-in for `aws-vault` on the hermetic harness's PATH: `aws-vault exec
# <profile> [--no-session] -- <cmd…>` runs <cmd…> with no credentials at all.
# The hermetic hosts need none (ssh keys, a local registry); a real door or a
# real relay would fail here, which is the point: nothing in the hermetic tier
# can reach AWS. Recorded like the other stubs.
set -euo pipefail
if [ -n "${E2E_RECORD_DIR:-}" ]; then mkdir -p "$E2E_RECORD_DIR"; printf '{"tool":"aws-vault","argv":"%s"}\n' "$*" >> "$E2E_RECORD_DIR/aws-vault-calls.jsonl"; fi
while [ $# -gt 0 ]; do
  case "$1" in
    --) shift; exec "$@" ;;
    *) shift ;;
  esac
done
echo "aws-vault-stub: no command after --" >&2
exit 2
