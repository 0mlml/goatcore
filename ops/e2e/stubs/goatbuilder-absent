#!/usr/bin/env bash
# What the doc-as-test runs in place of goatbuilder when the harness was given no
# binary: refuses loudly, so a page line that needs the binary is reported as
# untestable here rather than silently passing.
echo "goatbuilder-absent: the harness was run without --goatbuilder; this page line needs the binary: goatbuilder $*" >&2
exit 3
