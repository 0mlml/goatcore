// Sovereign B's peering router. Everything here is B's own: its CA, its certs.
// Which certificate it presents is set per-test by swapping the mounted file.
{
  mode: "router",
  listen: { endpoints: ["tls/0.0.0.0:7449"] },
  connect: { endpoints: ["tls/edge-a:7448"] },
  scouting: { gossip: { enabled: false }, multicast: { enabled: false } },
  transport: { link: { tls: {
    root_ca_certificate: "/pki/a-ca.pem",     // to verify OUR edge's server cert
    listen_certificate:  "/pki/partner.pem",
    listen_private_key:  "/pki/partner-key.pem",
    connect_certificate: "/pki/partner.pem",  // what it presents to our edge
    connect_private_key: "/pki/partner-key.pem",
    enable_mtls: true,
  }}},
  access_control: { enabled: true, default_permission: "allow", rules: [], subjects: [], policies: [] },
}
