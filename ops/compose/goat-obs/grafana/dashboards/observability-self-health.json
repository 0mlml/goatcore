  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "options": {
        "mode": "markdown",
        "content": "### Observability Self-Health (meta)\n\"Is my monitoring even working?\" A single-glance scrape-target up/down matrix, currently-firing alerts (the `ALERTS` series), scrape durations, and TSDB growth. This is the board that catches the *co-resident-obs* failure mode where the thing watching dies silently. Grafana strength: the `ALERTS` table + a `up` state-timeline across every job."
      },
      "transparent": true,
      "gridPos": {
        "w": 24,
        "h": 4,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Targets up",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(up)",
          "refId": "A",
          "legendFormat": ""
        }
      ],
      "gridPos": {
        "w": 4,
        "h": 4,
        "x": 0,
        "y": 4
      }
    },
