    "prometheus"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "",
  "links": [
    {
      "title": "Dashboards",
      "type": "dashboards",
      "asDropdown": true,
      "icon": "external link",
