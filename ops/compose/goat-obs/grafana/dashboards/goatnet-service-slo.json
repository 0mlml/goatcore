  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "options": {
        "mode": "markdown",
        "content": "### Service SLO & Uptime \u2014 blackbox HTTPS / DNS\nAvailability over the dashboard window (`avg_over_time(probe_success)`), TLS-cert expiry countdown, the HTTP phase-latency breakdown, and DNS resolver answer-health. Grafana strengths on show: availability math, `probe_ssl_earliest_cert_expiry` days-left thresholds, stacked phase latency."
      },
      "transparent": true,
      "gridPos": {
        "w": 24,
        "h": 4,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Endpoints up",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(probe_success{job=\"blackbox-https\"})",
          "refId": "A",
          "legendFormat": ""
        }
      ],
      "gridPos": {
        "w": 4,
        "h": 4,
        "x": 0,
        "y": 4
      }
    },
