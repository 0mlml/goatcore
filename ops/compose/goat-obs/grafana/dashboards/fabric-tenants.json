  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "options": {
        "mode": "markdown",
        "content": "### Fabric Tenants & Silent-Denial Watch\nDistinct from the *GOAT Audit Subscriber* board (which watches the subscriber pipeline). This is the **tenant COP**: who is producing, how much, and the F-177 expected-vs-actual reconciliation \u2014 an expected-active vendor with zero samples is a likely silent denial; a producing vendor absent from the manifest is a squat. Grafana strength: bar-gauge leaderboard + the `goat_expected_vendor unless \u2026` join rendered as a table."
      },
      "transparent": true,
      "gridPos": {
        "w": 24,
        "h": 4,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Producing vendors (15m)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(sum by (vendor) (increase(goat_audit_samples_total[15m])) > 0)",
          "refId": "A",
          "legendFormat": ""
        }
      ],
      "gridPos": {
        "w": 4,
        "h": 4,
        "x": 0,
        "y": 4
      }
    },
