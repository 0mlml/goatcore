    {
      "id": 10,
      "type": "table",
      "title": "Healthcheck status now",
      "description": "docker HEALTHCHECK verdict per container (textfile publisher, ~5m freshness)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
