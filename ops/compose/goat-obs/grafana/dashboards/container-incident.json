    {
      "id": 11,
      "type": "state-timeline",
      "title": "Healthcheck verdict by container",
      "description": "worst verdict per container over time \u2014 unhealthy episodes band red",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "HEALTHY",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "STARTING",
                  "color": "yellow",
                  "index": 1
                },
                "2": {
                  "text": "UNHEALTHY",
                  "color": "red",
                  "index": 2
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "rowHeight": 0.9,
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (name) ((2 * goat_container_health_status{status=\"unhealthy\"}) or (1 * goat_container_health_status{status=\"starting\"}) or (0 * goat_container_health_status{status=\"healthy\"}))",
          "refId": "A",
          "legendFormat": "{{name}}"
        }
      ],
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 8
      }
    },
