{
  "uid": "audit-storage-integrity",
  "title": "Audit Integrity & MinIO Storage",
  "description": "MinIO bucket usage/quota forecast + audit-subscriber S3 health (ADR 0811, F-169, F-171).",
  "tags": [
    "goat-obs",
    "minio",
    "audit",
    "compliance"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "",
  "links": [
    {
      "title": "Dashboards",
      "type": "dashboards",
      "asDropdown": true,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": [
        "goat-obs"
      ],
      "targetBlank": false
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "options": {
        "mode": "markdown",
        "content": "### Audit Integrity & MinIO Storage\nThe compliance-grade storage board (ADR 0811). Bucket usage vs configured quota with a **`predict_linear` days-to-full forecast**, oldest-object age, and the audit-subscriber S3 put success/fail rate. Grafana strength: forecasting + ratio gauges + the put-fail early-warning that took 4 days to notice by hand."
      },
      "transparent": true,
      "gridPos": {
        "w": 24,
        "h": 4,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "audit-integrity quota used",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 85
              },
              {
                "color": "red",
                "value": 95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * minio_bucket_usage_total_bytes{bucket=\"audit-integrity\"} / on(bucket) group_left() minio_bucket_quota_total_bytes{bucket=\"audit-integrity\"}",
          "refId": "A",
          "legendFormat": ""
        }
      ],
      "gridPos": {
        "w": 5,
        "h": 6,
        "x": 0,
        "y": 4
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Days to quota-full (forecast)",
      "description": "predict_linear-style runway from 6h growth",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 7
              },
              {
                "color": "green",
                "value": 30
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(minio_bucket_quota_total_bytes{bucket=\"audit-integrity\"} - minio_bucket_usage_total_bytes{bucket=\"audit-integrity\"}) / clamp_min(deriv(minio_bucket_usage_total_bytes{bucket=\"audit-integrity\"}[6h]), 1) / 86400",
          "refId": "A",
          "legendFormat": ""
        }
      ],
      "gridPos": {
        "w": 5,
        "h": 4,
        "x": 5,
        "y": 4
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "S3 put fail/s (audit)",
      "description": "non-zero = audit events being dropped right now",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.001
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(goat_audit_write_errors_total[5m])",
          "refId": "A",
          "legendFormat": ""
        }
      ],
      "gridPos": {
        "w": 5,
        "h": 4,
        "x": 10,
        "y": 4
      }
    },
