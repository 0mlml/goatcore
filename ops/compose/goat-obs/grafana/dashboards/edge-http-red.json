  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "options": {
        "mode": "markdown",
        "content": "### Edge HTTP \u2014 RED method + latency (Traefik)\nRate / Errors / Duration on the public edge. **Metric names are Traefik v3 defaults and are not yet referenced elsewhere in-repo \u2014 confirm on first live load** (`/metrics` on the traefik job). If your build labels differ, only the queries here change. Grafana strength on show: `histogram_quantile` percentiles + a latency heatmap."
      },
      "transparent": true,
      "gridPos": {
        "w": 24,
        "h": 4,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Requests/s (edge)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(traefik_entrypoint_requests_total[5m]))",
          "refId": "A",
          "legendFormat": ""
        }
      ],
      "gridPos": {
        "w": 4,
        "h": 4,
        "x": 0,
        "y": 4
      }
    },
