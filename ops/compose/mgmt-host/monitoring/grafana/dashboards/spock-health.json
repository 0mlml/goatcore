{
  "annotations": {
    "list": [
      {
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "enable": true,
        "expr": "ALERTS{component=~\"spock|postgres\",alertstate=\"firing\"}",
        "iconColor": "red",
        "name": "Spock alerts firing",
        "step": "30s",
        "tagKeys": "alertname,severity,subscription_name,slot_name",
        "titleFormat": "{{alertname}}"
      }
    ]
  },
  "description": "Block 52A.5 — single-pane replication health for the Spock multi-master mgmt-plane. Pairs with docs/design/replication-consistency-observability.md and docs/operations/post-partition-convergence-runbook.md.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "title": "Replication & consistency observability design",
      "url": "https://github.com/usareur-af/goatcore/blob/main/docs/design/replication-consistency-observability.md",
      "type": "link",
      "icon": "doc",
      "targetBlank": true
    },
    {
      "title": "Post-partition convergence runbook",
      "url": "https://github.com/usareur-af/goatcore/blob/main/docs/operations/post-partition-convergence-runbook.md",
      "type": "link",
      "icon": "doc",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Subscription state (L1)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "Subscriptions replicating",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "spock_subscription_lag_replicating",
          "legendFormat": "{{site}}/{{subscription_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "text": "DOWN" } }, "type": "value" },
            { "options": { "1": { "color": "green", "text": "OK" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none" }
    },
    {
      "type": "timeseries",
      "title": "Subscription replay lag (seconds)",
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 1 },
      "id": 2,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "spock_subscription_lag_seconds",
          "legendFormat": "{{site}}/{{subscription_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "orange", "value": 30 },
              { "color": "red", "value": 60 }
            ]
          },
          "custom": { "drawStyle": "line", "lineWidth": 2, "thresholdsStyle": { "mode": "line" } }
        }
      }
    },
    {
      "type": "row",
      "title": "Slot health (L1)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 200,
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "Slots active",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 10 },
      "id": 3,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "pg_replication_slot_active",
          "legendFormat": "{{site}}/{{slot_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "text": "INACTIVE" } }, "type": "value" },
            { "options": { "1": { "color": "green", "text": "ACTIVE" } }, "type": "value" }
          ]
        }
      },
      "options": { "colorMode": "background" }
    },
    {
      "type": "stat",
      "title": "Slots invalidated (wal_status=lost)",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 10 },
      "id": 4,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "pg_replication_slot_wal_status_lost",
          "legendFormat": "{{site}}/{{slot_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "green", "text": "OK" } }, "type": "value" },
            { "options": { "1": { "color": "red", "text": "LOST" } }, "type": "value" }
          ]
        }
      },
      "options": { "colorMode": "background" }
    },
    {
      "type": "timeseries",
      "title": "Slot WAL retention (% of max_slot_wal_keep_size)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 5,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "100 * pg_replication_slot_retained_wal_bytes / scalar(spock_max_slot_wal_keep_size_bytes)",
          "legendFormat": "{{site}}/{{slot_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "orange", "value": 70 },
              { "color": "red", "value": 80 }
            ]
          },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "thresholdsStyle": { "mode": "area" } }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "WAL sender pending bytes (provider-side queue)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 18 },
      "id": 6,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "pg_stat_replication_pending_bytes",
          "legendFormat": "{{site}} → {{subscriber}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10485760 },
              { "color": "red", "value": 104857600 }
            ]
          },
          "custom": { "drawStyle": "line", "lineWidth": 2, "thresholdsStyle": { "mode": "line" } }
        }
      }
    },
    {
      "type": "row",
      "title": "Conflicts & drift (L1 + L2a)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "id": 300,
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Conflicts resolved and remote changes skipped — new rows per 5m",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 27 },
      "id": 7,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "increase(spock_resolutions_total[5m])",
          "legendFormat": "{{site}} conflicts resolved",
          "refId": "A"
        },
        {
          "expr": "increase(spock_exceptions_total[5m])",
          "legendFormat": "{{site}} remote changes skipped",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          },
          "custom": { "drawStyle": "bars", "fillOpacity": 80 }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "ACE drift rows by table-pair",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 27 },
      "id": 8,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "spock_ace_drift_rows",
          "legendFormat": "{{site}}/{{db}}/{{table_pair}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          },
          "custom": { "drawStyle": "line", "lineWidth": 2, "thresholdsStyle": { "mode": "line" } }
        }
      }
    },
    {
      "type": "stat",
      "title": "Drift-watch heartbeat age",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 35 },
      "id": 9,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "time() - spock_ace_drift_watch_last_run_seconds",
          "legendFormat": "{{site}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 3700 },
              { "color": "red", "value": 7200 }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "graphMode": "area" }
    },
    {
      "type": "stat",
      "title": "Drift-watch peers configured",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 35 },
      "id": 10,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "spock_ace_drift_watch_peers",
          "legendFormat": "{{site}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            { "options": { "from": 0, "to": 1, "result": { "color": "yellow", "text": "DORMANT" } }, "type": "range" },
            { "options": { "from": 2, "to": 9999, "result": { "color": "green", "text": "ACTIVE" } }, "type": "range" }
          ]
        }
      },
      "options": { "colorMode": "background" }
    },
    {
      "type": "alertlist",
      "title": "Spock + signal-server alerts firing",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 35 },
      "id": 11,
      "options": {
        "showOptions": "current",
        "maxItems": 20,
        "sortOrder": 1,
        "dashboardAlerts": false,
        "alertName": "",
        "stateFilter": { "firing": true, "pending": true },
        "tags": []
      }
    },
    {
      "type": "row",
      "title": "Federation (signal-server)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 43 },
      "id": 400,
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Forward RPC outcome rate (per 5m)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 44 },
      "id": 12,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(signal_server_forward_sent_total[5m])",
          "legendFormat": "{{site}} → {{peer}} / {{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "lineWidth": 2 }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Forward RPC duration p99 (seconds)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 44 },
      "id": 13,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, peer, site) (rate(signal_server_forward_duration_seconds_bucket[5m])))",
          "legendFormat": "{{site}} → {{peer}} (p99)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.2 },
              { "color": "red", "value": 0.5 }
            ]
          },
          "custom": { "drawStyle": "line", "lineWidth": 2, "thresholdsStyle": { "mode": "line" } }
        }
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 36,
  "tags": ["spock", "replication", "block-52", "consistency"],
  "templating": {
    "list": [
      {
        "name": "site",
        "label": "Site",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(spock_subscription_lag_seconds, site)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {},
  "timezone": "utc",
  "title": "Spock health (Block 52A)",
  "uid": "spock-health-block52",
  "version": 1
}
