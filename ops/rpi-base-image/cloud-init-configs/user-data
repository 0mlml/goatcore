#cloud-config
# =============================================================
# Generic Pi 5 Base Image — Cloud-Init Configuration
# =============================================================
# Creates the 'goatnet' user with your SSH key; key login only.
# Default 'ubuntu' user retained as a fallback login during build.
# For console access while debugging a build, set a password on the
# device with `sudo passwd goatnet`; never ship one in this file.
# =============================================================

users:
  - default
  - name: goatnet
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    lock_passwd: true
    # 00-prerequisites.sh replaces the placeholder below with your ~/.ssh/id_ed25519.pub
    ssh_authorized_keys:
      - REPLACE_WITH_YOUR_PUBLIC_KEY

ssh_pwauth: false
disable_root: true

timezone: UTC

ntp:
  enabled: true

write_files:
  # Stop cloud-init from regenerating /etc/netplan/50-cloud-init.yaml on
  # every boot. Otherwise stale lease state can cause cloud-init to put
  # the same IP on both eth0 and wlan0, which kills routing. Once the
  # initial netplan config exists, manual edits should be authoritative.
  - path: /etc/cloud/cloud.cfg.d/99-disable-network-config.cfg
    content: "network: {config: disabled}\n"
    permissions: '0644'

runcmd:
  - ['echo', '=== Base image first-boot setup complete ===']

final_message: |
  Base image first-boot complete.
  Login: ssh goatnet@<IP>  (key only).
