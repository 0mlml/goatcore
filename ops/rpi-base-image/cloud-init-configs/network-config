# =============================================================
# Network configuration for cloud-init (optional)
# =============================================================
# This file is copied to the boot partition by 02-flash.sh.
# Ethernet works by default (DHCP). Edit WiFi SSID + password
# for deployment site before flashing.
#
# Do NOT add MAC address matching or device-specific interface
# names (enx..., wlx...) — keep it generic so the same image
# works on any Pi.
# =============================================================

network:
  version: 2
  ethernets:
    eth0:
      optional: true
      dhcp4: true
  wifis:
    wlan0:
      optional: true
      dhcp4: true
      access-points:
        "REPLACE_WITH_WIFI_SSID":
          password: "REPLACE_WITH_WIFI_PASSWORD"