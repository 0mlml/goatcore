{
  "$id": "https://schemas.netbird.legacy.example/identity/admin.v1.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "goat operator identity",
  "description": "Identity schema for human admin + service-account principals managed by per-site Kratos. Block 21C.",
  "type": "object",
  "properties": {
    "traits": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "title": "Email",
          "ory.sh/kratos": {
            "credentials": {
              "password": {"identifier": true},
              "webauthn": {"identifier": true},
              "totp": {"account_name": true}
            },
            "verification": {"via": "email"},
            "recovery": {"via": "email"}
          }
        },
        "name": {
          "type": "string",
          "title": "Display name"
        },
        "site": {
          "type": "string",
          "title": "Home site",
          "description": "Site short-name (e.g. vega). Informational; authorization is service-side."
        },
        "groups": {
          "type": "array",
          "items": {"type": "string"},
          "title": "Authorization groups",
          "description": "Roles asserted via JWT 'groups' claim. Examples: admin, operator, viewer, observer, sensor-operator, c2-cell. Convention: lowercase, dashes."
        }
      },
      "required": ["email", "name"],
      "additionalProperties": false
    }
  }
}
