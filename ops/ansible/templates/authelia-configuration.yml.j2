---
# Authelia configuration — goat external access gate
# Templated by Ansible (nethost-authelia.yml) — do not edit on host

server:
  address: 'tcp://0.0.0.0:9091/'
  headers:
    csp_template: "default-src 'self'; font-src 'self' data:; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self' 'unsafe-inline'"

log:
  level: info
  format: json
  file_path: /config/authelia.log

totp:
  disable: true

webauthn:
  disable: true

authentication_backend:
  file:
    path: /config/users_database.yml
    password:
      algorithm: bcrypt

session:
  secret: '{{ authelia_session_secret }}'
  cookies:
    - domain: 'netbird.legacy.example'
      authelia_url: 'https://auth.netbird.legacy.example'
      default_redirection_url: 'https://c2-map-ext.netbird.legacy.example'
      expiration: 4h
      inactivity: 30m

storage:
  encryption_key: '{{ authelia_storage_encryption_key }}'
  local:
    path: /config/db.sqlite3

notifier:
  filesystem:
    filename: /config/notification.txt

access_control:
  default_policy: deny
  rules:
    - domain: 'c2-map-ext.netbird.legacy.example'
      policy: one_factor

identity_validation:
  reset_password:
    jwt_secret: '{{ authelia_jwt_secret }}'
