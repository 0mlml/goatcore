# Traefik dynamic configuration — goat
# Managed by Ansible (nethost-traefik-hardening.yml)
#
# Defines TLS options for FIPS 140-3 alignment.
# Loaded via --providers.file.filename on the Traefik container.

tls:
  options:
    default:
      minVersion: VersionTLS12
      cipherSuites:
        - TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384
        - TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256
        - TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384
        - TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256
