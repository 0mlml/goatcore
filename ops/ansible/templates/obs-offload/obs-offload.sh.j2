#!/usr/bin/env bash
# {{ ansible_managed }}
# Off-box copy of the SVK obs node's stateful data (Prometheus TSDB + Grafana
# state) to the SVK obs-backup node (usa2), over the mesh. Nightly.
set -euo pipefail
SRC="{{ obs_offload_src }}/"
DEST="{{ obs_offload_user }}@{{ obs_offload_dest_host }}:{{ obs_offload_dest_dir }}/"
KEY="{{ obs_offload_ssh_key }}"; LOG="{{ obs_offload_log }}"
echo "$(date -u +%FT%TZ) obs-offload start $SRC -> $DEST" >> "$LOG"
rsync -a --delete --timeout=180 \
  -e "ssh -i $KEY -o StrictHostKeyChecking=accept-new -o BatchMode=yes" \
  "$SRC" "$DEST" >> "$LOG" 2>&1
echo "$(date -u +%FT%TZ) obs-offload ok" >> "$LOG"
