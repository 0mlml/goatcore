# Rathole client — {{ relay_name }} relay
# Managed by Ansible.
#
# `rathole_client_netbird_mgmt_local_addr` defaults to 127.0.0.1:443 in
# ops/ansible/group_vars/all.yml. A site with a dedicated `enrollment` Traefik
# entrypoint overrides it to 127.0.0.1:8443 in its group_vars, which closes the
# mesh-only allowlist bypass that rathole's docker SNAT otherwise opens. Sites
# whose Traefik doesn't define the enrollment entrypoint keep the default :443
# forward; there is no allowlist bypass to close.

[client]
remote_addr = "{{ relay_ip }}:2333"
default_token = "{{ relay_token }}"
# ADR 1081 L3 rathole hardening. Per-goatnet vars (group_vars), NOT gated by
# egress_shaping_enabled — these are config defaults. Current fleet defaults
# live in group_vars/all.yml (heartbeat_timeout=40, retry_interval=1); a goatnet
# can override to the storm-hardened values (20 / 5).
#
# NOTE (verified against the pinned rathole {{ rathole_version | default('v0.5.0') }}):
# rathole's `retry_interval` is a FLAT integer of seconds — the config schema
# has no exponential-backoff field (DEFAULT_CLIENT_RETRY_INTERVAL_SECS: u64).
# A 1 s-flat reconnect can hammer ghost sessions; we
# cannot do the "1–30 s exponential" the design doc sketches without a fork, so
# storm-hardened goatnets raise the flat interval to 5 s to slow the hammer honestly.
heartbeat_timeout = {{ rathole_heartbeat_timeout | default(40) }}
retry_interval = {{ rathole_retry_interval | default(1) }}

[client.transport]
type = "noise"

[client.transport.noise]
remote_public_key = "{{ relay_pubkey }}"

{# Service name must match a [server.services.<name>] stanza on the relay.
   Default `netbird-mgmt` = the historical single-tunnel name (and backend #1
   in ingress-dispatch mode, ADR 1085). Additional mgmt-host backends set
   rathole_client_service_name to THEIR declared service (e.g. netbird-mgmt-b)
   — see docs/design/relay-ingress-dispatch.md. #}
[client.services.{{ rathole_client_service_name | default('netbird-mgmt') }}]
type = "tcp"
local_addr = "{{ rathole_client_netbird_mgmt_local_addr | default('127.0.0.1:443') }}"
