#!/usr/bin/env bash
# {{ ansible_managed }}
# Off-box copy of the SVK Thor's pgBackRest repo to the SVK backup node.
# Ciphertext only — the aes-256-cbc repo cipher key never leaves the Thor.
# Runs after the nightly backup window (see the systemd timer).
set -euo pipefail
SRC="{{ pgbackrest_offload_src }}/"
DEST="{{ pgbackrest_offload_user }}@{{ pgbackrest_offload_dest_host }}:{{ pgbackrest_offload_dest_dir }}/"
KEY="{{ pgbackrest_offload_ssh_key }}"
LOG="{{ pgbackrest_offload_log }}"
echo "$(date -u +%FT%TZ) offload start $SRC -> $DEST" >> "$LOG"
# --delete keeps the mirror exact (pgBackRest expires old backups; the mirror follows).
rsync -a --delete --timeout=120 \
  -e "ssh -i $KEY -o StrictHostKeyChecking=accept-new -o BatchMode=yes" \
  "$SRC" "$DEST" >> "$LOG" 2>&1
echo "$(date -u +%FT%TZ) offload ok" >> "$LOG"
