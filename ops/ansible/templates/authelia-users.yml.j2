---
# Authelia local user database — goat external viewer accounts
# Templated by Ansible (nethost-authelia.yml) — do not edit on host
#
# To add users, pass extra vars when running the playbook:
#   -e '{"authelia_users": [{"username": "viewer", "displayname": "External Viewer", "password_hash": "$2b$12$..."}]}'
#
# Generate a bcrypt hash:
#   docker run --rm authelia/authelia:latest authelia crypto hash generate bcrypt --password 'mypassword'

users:
{% for user in authelia_users %}
  {{ user.username }}:
    disabled: false
    displayname: "{{ user.displayname }}"
    password: "{{ user.password_hash }}"
    email: "{{ user.username }}@legacy.example"
    groups: []
{% endfor %}
