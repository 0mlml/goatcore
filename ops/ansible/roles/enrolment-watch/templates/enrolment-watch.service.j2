[Unit]
Description=netbird enrolment watch — find devices that cannot enrol and keep trying
Documentation=file:///usr/local/bin/enrolment-watch.sh
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/goat/enrolment-watch.env
ExecStart=/usr/local/bin/enrolment-watch.sh
# Exit 1 is the FINDING, not a crash — the unit must not restart-loop on a
# stuck peer, and its failure state is what the alert reads. Exit 2 (source
# unreadable) is a genuine failure and is left to surface as one.
SuccessExitStatus=0 1
Nice=10
IOSchedulingClass=idle
