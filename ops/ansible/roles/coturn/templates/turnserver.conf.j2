# Coturn STUN/TURN — all-Rust goat-relay tier. Managed by Ansible (coturn role).
# Re-added after the all-Rust migration dropped it; see F-192.

listening-port={{ coturn_listening_port }}
{% if coturn_external_ip %}
external-ip={{ coturn_external_ip }}
{% endif %}
fingerprint
use-auth-secret
static-auth-secret={{ coturn_turn_secret_resolved }}
realm={{ coturn_realm }}
no-software-attribute
no-cli
no-tls
no-dtls
{% if not coturn_turn_enabled %}
# STUN-only posture: TURN relay is not advertised and the goat-relay SG
# does not open the relay port range below, so allocations cannot relay media.
# STUN Binding still answers — that is the point. Enable TURN by flipping
# coturn_turn_enabled, opening 49152-65535 (terraform coturn_turn_enabled), and
# setting turn_hosts so management.json advertises the TURN servers.
{% endif %}

# Relay media port range
min-port={{ coturn_min_port }}
max-port={{ coturn_max_port }}

# Anti-abuse: prevent TURN relay to private networks (SSRF via TURN)
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
no-multicast-peers

# Rate limiting
total-quota=100
bps-capacity=0
stale-nonce=600
max-bps=10000000

# Logging
log-file=/var/log/turnserver.log
simple-log
