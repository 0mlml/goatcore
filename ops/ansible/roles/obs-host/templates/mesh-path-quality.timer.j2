# Rendered by ops/ansible/roles/obs-host/ — DO NOT EDIT ON HOST.
[Unit]
Description=Run the mesh path-quality probe periodically

[Timer]
# Every 5 minutes. Frequent enough that a degraded link is caught within one
# alert window, infrequent enough that ~20 pings x N peers is negligible.
OnBootSec=2min
OnUnitActiveSec={{ obs_mesh_pq_interval | default('5min') }}
# Spread across hosts so several obs hosts don't probe in lockstep.
RandomizedDelaySec=30
AccuracySec=30

[Install]
WantedBy=timers.target
