# {{ ansible_managed }}
# DO NOT COMMIT. mode 0600.
#
# S3 credentials for the audit-subscriber container. Picked up by
# `docker compose up` automatically from the sibling docker-compose.yml's
# `${VAR}` references.
{% if audit_subscriber_s3_endpoint | length > 0 %}
AUDIT_SUBSCRIBER_S3_ACCESS_KEY={{ audit_subscriber_s3_access_key_value }}
AUDIT_SUBSCRIBER_S3_SECRET_KEY={{ audit_subscriber_s3_secret_key_value }}
{% else %}
# observe-only mode (audit_subscriber_s3_endpoint is empty)
{% endif %}
