# {{ ansible_managed }}
# spiffe-helper for the onboard-runner (ZAGROS SPIRE Phase A). Fetches the runner's
# X509-SVID from the SPIRE agent Workload API and writes cert+key+bundle into the
# shared `svid` volume the runner reads as /svid. The runner uses these for the
# mint-capable onboarding-contract leg to goat-id-console (mTLS), verifying the
# console's SVID SPIFFE ID (docs/design/runner-console-mtls.md).
#
# The runner authenticates AS spiffe://{{ spire_trust_domain | default('zagros.zagros.example') }}/onboard-runner
# (set by the SPIRE registration entry whose selector matches this sidecar's
# compose label). It writes the client cert+key + the SPIRE trust bundle; the
# bundle verifies the console's server SVID.

agent_address         = "/run/spire/sockets/agent.sock"
cmd                   = ""
cmd_args              = ""
cert_dir              = "/svid"
svid_file_name        = "onboard-runner-cert.pem"
svid_key_file_name    = "onboard-runner-key.pem"
svid_bundle_file_name = "spire-bundle.pem"
renew_signal          = ""

# No file-mode keys: spiffe-helper 0.10.1 writes the key 0600 and ignores
# key_file_mode (and is distroless, so no chmod hook). The runner reads it
# anyway because the helper runs as the SAME nonroot UID as the runner and
# writes into a host bind dir chowned to that UID — see the onboard-runner role
# + docker-compose.yml.j2. So the 0600 key is owned by, and readable by, the
# runner without ever being world-readable.
