# Managed by ansible (roles/door-credential-audit). Do not edit on the host.
#
# Ships from the ROLE, not the shared ops/compose/goat-obs tree, so the absent()
# alert below exists only on goatnets that actually deployed the timer. In the
# shared tree it would fire forever everywhere that has not.
#
# The first two alerts are about the GUARD; only the third is about people. That
# ordering is deliberate — a guard that stopped running is a worse condition
# than a strand it reports, because the strand is at least visible.
groups:
  - name: door-credential-audit
    rules:
      - alert: DoorCredentialAuditNotReporting
        expr: absent(goat_door_audit_last_run_seconds)
        for: 2h
        labels:
          severity: warning
        annotations:
          summary: "The Kanidm door credential audit has published no metric at all"
          description: >-
            goat_door_audit_last_run_seconds is absent. Either the timer is not
            running, or it is writing its textfile into a directory this host's
            node_exporter does not read. Check
            `systemctl list-timers door-credential-audit.timer` first, then
            `ps -o args= -C node_exporter | grep textfile.directory`.

      - alert: DoorCredentialAuditStale
        expr: time() - goat_door_audit_last_run_seconds > 129600
        for: 1h
        labels:
          severity: warning
        annotations:
          summary: "Door credential audit ({% raw %}{{ $labels.plane }}{% endraw %}) has not run in 36h"
          description: >-
            The series exists and stopped advancing. The audit exits non-zero
            without stamping when it cannot read the door, so a blind guard
            appears here rather than as a cheerfully fresh timestamp over a run
            that saw nothing. `journalctl -u door-credential-audit -n 50`.

      # GROWTH, not level. The at-risk count is a standing backlog — 46 on the
      # public door the day this was written, several of them synthetic/bridge
      # accounts that will never set a credential. An alert on `> 0` would fire
      # permanently from the first deploy, get muted within a week, and then be
      # worth nothing on the day it mattered. What is actionable is a NEW person
      # joining the stranded set: somebody was invited, could not get in, and
      # has not told anyone. The standing backlog belongs on the report, which
      # is where it is.
      - alert: DoorInviteesNewlyStranded
        expr: >-
          goat_door_persons_at_risk - goat_door_persons_at_risk offset 7d > 0
        for: 6h
        labels:
          severity: warning
        annotations:
          summary: "More people are stuck at the {% raw %}{{ $labels.plane }}{% endraw %} door than a week ago"
          description: >-
            Someone was invited through the Kanidm door, never completed
            credential setup, and has no certain second way in. They will not
            necessarily tell you — the last one tried the same broken Submit
            button 17 times over five days before writing.
            Read {{ door_credential_audit_report_dir }}/last-run.txt for the
            handles, then re-issue: ops/scripts/kanidm-reissue-code.sh <handle>
