# Rendered by ops/ansible/roles/door-credential-audit/ — DO NOT EDIT ON HOST.
# Daily census of people invited through the {{ door_credential_audit_plane }}
# Kanidm door who never completed credential setup. READ-ONLY.
[Unit]
Description=Kanidm door credential audit ({{ door_credential_audit_plane }} plane)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/goat/door-credential-audit.env
TimeoutStartSec={{ door_credential_audit_timeout_sec }}

# The report is written by the unit, not the script, so the script stays a plain
# operator command that prints to stdout. `history/` keeps the last N runs — a
# month of "when did this handle first appear" — and prunes itself here rather
# than via a logrotate drop-in, because mgmt hosts have no logrotate and an
# inert rotation config would grow the directory forever.
ExecStart=/bin/sh -c '\
  set -e; \
  out="${DOOR_AUDIT_REPORT_DIR}/last-run.txt"; \
  /usr/local/sbin/kanidm-door-audit.sh --plane "${DOOR_AUDIT_PLANE}" --prom "${DOOR_AUDIT_PROM}" > "$out.tmp"; \
  mv "$out.tmp" "$out"; \
  cp "$out" "${DOOR_AUDIT_REPORT_DIR}/history/$(date -u +%%Y%%m%%dT%%H%%M%%SZ).txt"; \
  ls -1t "${DOOR_AUDIT_REPORT_DIR}/history" | tail -n +$((${DOOR_AUDIT_HISTORY_KEEP} + 1)) \
    | while read -r old; do rm -f "${DOOR_AUDIT_REPORT_DIR}/history/$old"; done; \
  cat "$out"'

# Confined against the host: it reads a cloud API and writes two directories.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ door_credential_audit_report_dir }} {{ door_credential_audit_textfile_dir }}

[Install]
WantedBy=multi-user.target
