# Rendered by ops/ansible/roles/door-credential-audit/ — DO NOT EDIT ON HOST.
[Unit]
Description=Daily Kanidm door credential audit ({{ door_credential_audit_plane }} plane)

[Timer]
OnCalendar={{ door_credential_audit_oncalendar }}
RandomizedDelaySec={{ door_credential_audit_jitter_sec }}
# A host that was off at 07:23 still owes the audit. Without this the metric
# simply stops moving, which is the shape the alert below cannot distinguish
# from a real strand.
Persistent=true
AccuracySec=1m

[Install]
WantedBy=timers.target
