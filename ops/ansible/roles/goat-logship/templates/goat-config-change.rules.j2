# Rendered by ops/ansible/roles/goat-logship on {{ ansible_date_time.iso8601 }}
# Anchor: ADR 1078 §7 — config:change producer for off-box cyber-logging.
#
# auditd file watches on the security-sensitive OS config. These catch the
# OUT-OF-BAND manual edit that config-as-code (git + ansible + the rollback
# ledger) cannot see — the whole point of watching. Events fire into
# /var/log/audit/audit.log (which goat-logship already tails) tagged with the
# key below; the auditd VRL transform classifies them to OCSF config:change.
#
# Scope is deliberately narrow (identity / privilege / remote-access / auth /
# audit-config) so it stays low-noise — these files change rarely.
{% for path in logship_config_change_watch_paths %}
-w {{ path }} -p wa -k {{ logship_config_change_key }}
{% endfor %}
