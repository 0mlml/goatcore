# Rendered by ops/ansible/roles/goat-logship on {{ ansible_date_time.iso8601 }}
# Anchor: ADR 1078 §4 — absence-alarming closes the F-169 silent-shipping
# class. A collector that silently stops shipping must page, not disappear.

groups:
  - name: goat_logship
    interval: 30s
    rules:

      - alert: GoatLogshipDown
        expr: up{job="goat_logship"} == 0
        for: 5m
        labels:
          severity: critical
          service: goat_logship
          site: "{{ logship_site_id }}"
        annotations:
          summary: "goat-logship collector down on {{ logship_host_id }}"
          description: |
            The off-box cyber-logging collector is unreachable for 5+ minutes.
            Host/OS + fabric security events are not being shipped to the
            durable off-box tier. This is the F-169 failure class — do not
            treat a silent collector as "no events".

      - alert: GoatLogshipStreamSilent
        # The F-169 closer: the S3 durable sink has flushed ZERO events for
        # 15m while the collector is up. Either every source went silent
        # (implausible on a live host) or shipping is broken upstream of the
        # buffer. Page either way.
        expr: |
          (up{job="goat_logship"} == 1)
          and
          (sum by (instance) (rate(vector_component_sent_events_total{component_id="durable"}[15m])) == 0)
        for: 15m
        labels:
          severity: critical
          service: goat_logship
          site: "{{ logship_site_id }}"
        annotations:
          summary: "goat-logship off-box shipping is silent on {{ logship_host_id }}"
          description: |
            The S3 durable sink has shipped no events for 15+ minutes while the
            collector is up. The stream has gone silent without an error the
            operator would otherwise never see. Check sink auth, the S3 bucket,
            and the disk buffer.

      - alert: GoatLogshipBufferFilling
        # Disk buffer is sized for a transport outage, not retention. Sustained
        # growth means the off-box path is down and local retention — which the
        # design deliberately keeps near-zero (§5) — is being consumed.
        expr: |
          vector_buffer_byte_size{component_id="durable"}
            > ({{ logship_buffer_max_bytes }} * 0.75)
        for: 10m
        labels:
          severity: warning
          service: goat_logship
          site: "{{ logship_site_id }}"
        annotations:
          summary: "goat-logship disk buffer >75% on {{ logship_host_id }}"
          description: |
            The transport buffer is filling — the off-box sink is not draining.
            When it fills, when_full=block backpressures collection. Restore the
            S3 path before the buffer caps.
