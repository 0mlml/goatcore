# relay-metrics-publish.timer — ADR 1058. Publishes this relay's metrics every
# {{ relay_metrics_publish_interval | default('15s') }} (matches the dashboard
# prober cadence). AccuracySec tight so the rolling-window rate diffs are even.
[Unit]
Description=goat relay metrics self-publish timer (ADR 1058)

[Timer]
OnBootSec=30s
OnUnitActiveSec={{ relay_metrics_publish_interval | default('15s') }}
AccuracySec=1s

[Install]
WantedBy=timers.target
