# relay-metrics-publish env — ADR 1058. Rendered mode 0600 (holds the bearer
# token). Sourced by relay-metrics-publish.service.
RELAY_NAME={{ relay_metrics_name }}
RELAY_METRICS_INGEST_URL={{ relay_metrics_ingest_url }}
RELAY_METRICS_INGEST_HOST={{ relay_metrics_ingest_host }}
RELAY_METRICS_BEARER_TOKEN={{ relay_metrics_bearer_token }}
{% if relay_metrics_ingest_url2 | default('') | length > 0 %}
# Second, DIRECT target (best-effort) — the cloud relay-health box's public
# ingest, so both dashboards get throughput parity (ADR 1058 §repoint-publishers).
RELAY_METRICS_INGEST_URL2={{ relay_metrics_ingest_url2 }}
{% endif %}
GOAT_RELAY_CONTAINER={{ goat_relay_container_name | default('goat-relay') }}
{% if (goat_relay_stats_addr | default('')) != '' %}
# ADR 1055 §2b — the Go relay-probe publisher reads this to fold the per-peer
# forwarded-byte distribution into the deep block (lights up at the Phase 3
# deploy-swap; the current bash metrics-publish.sh harmlessly ignores it, so
# per-peer rate-diffing stays out of bash per F-234).
RELAY_STATS_URL=http://{{ goat_relay_stats_addr }}/
{% endif %}
