# {{ ansible_managed }}
[Unit]
Description=Assemble this node's convergence facts (deploy ledger tips + applied-intent stamp)
# Best-effort. When this fails the publisher reads the staleness honestly and
# publishes an empty record that still identifies the node, rather than a stale
# one that looks current.

[Service]
Type=oneshot
ExecStart=/usr/bin/env python3 /usr/local/bin/consistency-snapshot.py \
  --ledger-root {{ consistency_health_ledger_root }} \
  --host-id {{ consistency_health_node }} \
  --docker-bin {{ consistency_health_docker_bin }} \
  --out {{ consistency_health_state_dir }}/snapshot.json{% if consistency_health_no_reconcile | bool %} --no-reconcile{% endif %}
