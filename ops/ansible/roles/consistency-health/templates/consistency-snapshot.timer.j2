# {{ ansible_managed }}
[Unit]
Description=Convergence-fact snapshot for goat-consistency-health (consistency-foundation.md §5.2)

[Timer]
OnBootSec={{ consistency_health_snapshot_boot_delay_s }}s
OnUnitActiveSec={{ consistency_health_snapshot_interval_s }}s
# Jitter, per ADR 1109 P9: the meter emits on an interval even when the fleet is
# quiet (there is no operational traffic that implies "this node's intent is
# current"), so the interval must not synchronise across a goatnet.
RandomizedDelaySec=60s
AccuracySec=30s

[Install]
WantedBy=timers.target
