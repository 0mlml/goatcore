# {{ ansible_managed }}
#
# goat-consistency-health for {{ consistency_health_node }}. Rendered by
# ops/ansible/roles/consistency-health/ (consistency-foundation.md §5,
# ADR 1110 / ADR 1036). mTLS Zenoh client peer of the router; reads the
# host-side snapshot (mounted read-only) and publishes
# ops/consistency/report/{{ consistency_health_node }}. Facts, never verdicts.
# No secrets, no .env.

services:
  consistency-health:
    image: {{ consistency_health_image }}
    container_name: consistency-health
    restart: unless-stopped
{% if consistency_health_join_zenoh_network | bool %}
    networks:
      - zenoh
{% endif %}
    environment:
      GCH_MODE: "publish"
      GCH_ENDPOINT: "{{ consistency_health_zenoh_endpoint }}"
      GCH_NODE: "{{ consistency_health_node }}"
      GCH_SNAPSHOT_FILE: "/state/snapshot.json"
      GCH_INTERVAL_MS: "{{ consistency_health_interval_ms }}"
      GCH_STALE_AFTER_MS: "{{ consistency_health_stale_after_ms }}"
      RUST_LOG: "{{ consistency_health_rust_log }}"
{% if consistency_health_zenoh_endpoint.startswith('tls/') %}
      GCH_CERT: "/certs/consistency-health-cert.pem"
      GCH_KEY_FILE: "/certs/consistency-health-key.pem"
      GCH_ROOT_CA: "/ca/ca-root.pem"
{% endif %}
    volumes:
      # Read-only, and NO docker socket: the privileged reconciliation happens
      # in the host-side collector, so this container cannot touch a container.
      - "{{ consistency_health_state_dir }}:/state:ro"
{% if consistency_health_zenoh_endpoint.startswith('tls/') %}
      - "{{ consistency_health_cert_dir }}:/certs:ro"
      - "{{ consistency_health_ca_root_src }}:/ca/ca-root.pem:ro"
{% endif %}

{% if consistency_health_rollup_enabled | bool %}
  # The passive per-goatnet rollup (this host only): subscribes
  # ops/consistency/report/**, grades against the committed intent artifact
  # through the shared library, and publishes
  # ops/consistency/health/{{ consistency_health_site }}. Persists nothing —
  # delete it and the view rebuilds from the bus in one interval.
  consistency-health-rollup:
    image: {{ consistency_health_image }}
    container_name: consistency-health-rollup
    restart: unless-stopped
{% if consistency_health_join_zenoh_network | bool %}
    networks:
      - zenoh
{% endif %}
    environment:
      GCH_MODE: "rollup"
      GCH_ENDPOINT: "{{ consistency_health_zenoh_endpoint }}"
      GCH_SITE: "{{ consistency_health_site }}"
      GCH_INTENT_FILE: "/intent/intent.json"
      # CF-5: the .sig sits beside the artifact on the same read-only mount;
      # the SPKI trust root is the committed public-keys set placed by the
      # role. Unverifiable => the rollup refuses to grade, honestly.
      GCH_PUBKEY_DIR: "/intent/public-keys"
      GCH_INTERVAL_MS: "{{ consistency_health_interval_ms }}"
      GCH_RECORD_STALE_AFTER_MS: "{{ consistency_health_record_stale_after_ms }}"
      RUST_LOG: "{{ consistency_health_rust_log }}"
{% if consistency_health_zenoh_endpoint.startswith('tls/') %}
      GCH_CERT: "/certs/consistency-health-cert.pem"
      GCH_KEY_FILE: "/certs/consistency-health-key.pem"
      GCH_ROOT_CA: "/ca/ca-root.pem"
{% endif %}
    volumes:
      - "{{ consistency_health_intent_dir }}:/intent:ro"
{% if consistency_health_zenoh_endpoint.startswith('tls/') %}
      - "{{ consistency_health_cert_dir }}:/certs:ro"
      - "{{ consistency_health_ca_root_src }}:/ca/ca-root.pem:ro"
{% endif %}
{% endif %}

{% if consistency_health_join_zenoh_network | bool %}
networks:
  zenoh:
    name: {{ consistency_health_zenoh_network }}
    external: true
{% endif %}
