# Rendered by ops/ansible/roles/host-net-publish/ — DO NOT EDIT ON HOST.
# iperf3 server used as the cross-node capacity-probe TARGET on a multi-node
# goatnet: the peer Thor's capacity-probe speed-tests to
# this, measuring the Thor<->Thor mesh path (the primary signal-federation
# transport). Bound to the MESH IP only, so only mesh peers (WireGuard-
# authenticated) can reach it — never the public interface.
[Unit]
Description=host-net iperf3 cross-node capacity-probe target (mesh-bound)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# --bind the mesh IP; if wt0 isn't up yet at boot the bind fails and Restart
# retries until netbird brings the mesh up (same pattern as relay-health).
ExecStart=/usr/bin/iperf3 --server --bind {{ host_net_iperf3_bind }} --port {{ host_net_iperf3_port }} --interval 0
Restart=always
RestartSec=10
DynamicUser=yes
Nice=10

[Install]
WantedBy=multi-user.target
