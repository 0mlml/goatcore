# Rendered by ops/ansible/roles/host-net-publish/ — DO NOT EDIT ON HOST.
# Measures link CAPACITY (a short iperf3 speed test to a stable target) — what
# the link CAN do, vs the usage rate. Oneshot: fired hourly by the timer, and
# on demand ("systemctl start capacity-probe" or capacity-probe.sh --on-demand,
# rate-limited to CAPACITY_MIN_INTERVAL_S). Writes capacity.json for the
# publisher to forward. Bounded by CAPACITY_DURATION_S so it never loads a link
# for long. See docs/design/relay-health-dashboard.md.
[Unit]
Description=relay-health link capacity probe (iperf3 speed test to {{ capacity_target_name }})
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile={{ host_net_publish_dir }}/host-net-publish.env
ExecStart={{ host_net_publish_dir }}/capacity-probe.sh
# Best-effort: a failed measurement (target down / link dark) is data, not a
# unit failure — keep last-known and try again next cycle.
SuccessExitStatus=0 2 3
Nice=10
