# Rendered by ops/ansible/roles/host-net-publish/ — DO NOT EDIT ON HOST.
# Hourly link-capacity measurement. On-demand runs go through the service
# directly (systemctl start capacity-probe) — the script's own lockfile keeps
# on-demand to at most once per CAPACITY_MIN_INTERVAL_S.
[Unit]
Description=hourly relay-health link capacity probe

[Timer]
OnBootSec=3min
OnUnitActiveSec={{ capacity_probe_interval }}
RandomizedDelaySec=90
AccuracySec=30s

[Install]
WantedBy=timers.target
