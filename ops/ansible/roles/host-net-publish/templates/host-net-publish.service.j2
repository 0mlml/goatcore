# Rendered by ops/ansible/roles/host-net-publish/ — DO NOT EDIT ON HOST.
# Site network host self-publishes its host-net health (uplink loss/rtt,
# tunnel flap counts, control-plane rates) to the relay-health ingest(s).
[Unit]
Description=host-net health self-publish (site network host)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile={{ host_net_publish_dir }}/host-net-publish.env
ExecStart={{ host_net_publish_dir }}/host-net-publish.sh
# The publisher is best-effort by design: on a dark uplink every POST fails —
# that is the exact condition the stored last-known state covers. Don't let
# systemd mark the unit failed-red for the thing the system is FOR.
SuccessExitStatus=0 1
