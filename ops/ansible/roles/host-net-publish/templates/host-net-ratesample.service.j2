# Rendered by ops/ansible/roles/host-net-publish/ — DO NOT EDIT ON HOST.
# Continuous peak-hold sampler for the default-route iface. The 60s host-net
# publish reports byte rate as a 60-SECOND AVERAGE, which smears a real burst
# away (a 14s@800Mbps burst reads ~150Mbps; a short burst ~1MB/s). This loop
# samples every host_net_sample_interval_s and records 1s peaks into a ring that
# host-net-publish.sh reads for iface.rx/tx_bps_peak. Reads only /proc/net/dev.
[Unit]
Description=host-net iface rate peak sampler (feeds host-net-publish peak)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile={{ host_net_publish_dir }}/host-net-publish.env
ExecStart={{ host_net_publish_dir }}/host-net-ratesample.sh
Restart=always
RestartSec=5
# Lowest-priority background work — must never contend with the data plane.
Nice=15
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
