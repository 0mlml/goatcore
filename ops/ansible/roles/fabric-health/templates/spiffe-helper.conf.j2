# {{ ansible_managed }}
# spiffe-helper for the fabric-health meter (ZAGROS SPIRE Phase A). Fetches the
# CN-bearing X509-SVID from the SPIRE agent Workload API and writes cert+key
# into the shared `svid` volume that the fabric-health container reads as
# /certs. The SVID's Subject CN = fabric-health-trial-peer (set via the SPIRE
# registration entry's first dns_name) so the CN-only Zenoh ACL admits it.
#
# NOTE: this writes the client cert+key only. The router's server cert is
# verified by fabric-health against the OFFLINE-CA root (mounted separately at
# /ca/ca-root.pem), NOT the SPIRE bundle — the two CAs serve opposite
# directions of the mTLS handshake.

agent_address       = "/run/spire/sockets/agent.sock"
cmd                 = ""
cmd_args            = ""
cert_dir            = "/svid"
svid_file_name      = "fabric-health-cert.pem"
svid_key_file_name  = "fabric-health-key.pem"
svid_bundle_file_name = "spire-bundle.pem"
renew_signal        = ""

# No file-mode keys: spiffe-helper 0.10.1 writes the key 0600 and ignores
# key_file_mode (and is distroless, so no chmod hook). The meter reads it
# anyway because the helper runs as the SAME nonroot UID as the meter (65532)
# and writes into a host bind dir chowned to that UID — see the fabric-health
# role + docker-compose.yml.j2. So the 0600 key is owned by, and readable by,
# the meter without ever being world-readable.
