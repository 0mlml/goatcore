# icam-mtls-proxy — refresh the proxy's server certificate from Traefik's acme.json
# (roles/icam-mtls-proxy, icam_mtls_proxy_tls: traefik-acme). Fired by the timer.
[Unit]
Description=card sign-in proxy: copy the site certificate out of Traefik's acme.json
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 {{ icam_mtls_proxy_compose_dir }}/acme-cert-sync.py --acme {{ icam_mtls_proxy_acme_json }} --resolver {{ icam_mtls_proxy_acme_resolver }} --hostname {{ icam_mtls_proxy_hostname }} --out-dir {{ icam_mtls_proxy_compose_dir }}/certs --reload {{ icam_mtls_proxy_compose_dir }}
SuccessExitStatus=0 3
