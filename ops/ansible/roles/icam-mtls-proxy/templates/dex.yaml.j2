# Dex — the local OIDC shim for sovereign PKI card sign-in (ADR 1209). nginx mTLS
# authenticates the card and passes X-Remote-User = "<pki>:<identifier>"; the
# authproxy connector turns it into an OIDC token (preferred_username) that Kratos
# consumes through ops/identity/claim-maps/sovereign-pki.jsonnet.
issuer: {{ icam_mtls_proxy_issuer_url }}
storage:
  type: memory
web:
  http: 0.0.0.0:5556
oauth2:
  skipApprovalScreen: true
connectors:
  - type: authproxy
    id: card
    name: Certificate (smart card)
    config:
      userHeader: X-Remote-User
      emailHeader: X-Remote-Email
staticClients:
  - id: kratos
    secretEnv: ICAM_MTLS_KRATOS_CLIENT_SECRET   # from the role-written .env via compose
    name: Kratos
    redirectURIs:
      - {{ icam_mtls_proxy_kratos_redirect }}
