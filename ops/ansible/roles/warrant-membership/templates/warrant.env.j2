# Managed by ansible (roles/warrant-membership). Do not edit on the host.
# Mode 0600, root-owned. Holds the svc-{{ site_id }}-warrant NetBird PAT (role admin).
GOAT_NB_API_TOKEN={{ lookup('env', warrant_membership_token_env) }}
GOAT_NB_MGMT_URL={{ warrant_membership_api_url }}
GOAT_OPERATOR_HANDLE={{ warrant_membership_operator_handle }}
# The converger runs on the management host beside Kratos. Security-quarantine
# checks read the local admin API before any NetBird write; no Ory credential is
# copied into this file and no unauthenticated admin endpoint leaves loopback.
GOAT_ONBOARD_KRATOS_LOCAL=1
{% if warrant_membership_operator_age_recipients %}
# Operator-action audit encrypt roster: the converger's
# OperatorActionV1 is age-encrypted to these recipients. Resolved at deploy from
# the operator env, never committed.
GOAT_OPERATOR_AGE_RECIPIENTS={{ warrant_membership_operator_age_recipients }}
{% endif %}
