# Managed by ansible (roles/warrant-membership). Do not edit on the host.
[Unit]
Description=Warrant membership converger every {{ warrant_membership_interval }} (ADR 1189)
Documentation=https://github.com/usareur-af/goatcore/blob/main/docs/design/mesh-change-control.md

[Timer]
OnBootSec={{ warrant_membership_boot_delay }}
OnUnitActiveSec={{ warrant_membership_interval }}
RandomizedDelaySec={{ warrant_membership_jitter_sec }}
