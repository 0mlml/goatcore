## Rendered by ops/ansible/roles/apt-cacher-ng on {{ ansible_date_time.iso8601 }}.
## Source: ops/ansible/roles/apt-cacher-ng/templates/acng.conf.j2
##
## DO NOT EDIT THIS FILE ON THE HOST — it will be overwritten on next
## Ansible run. Edit the .j2 template + re-run the role.
##
## Directive set is the minimal-valid subset accepted by
## apt-cacher-ng 3.7.4 (Ubuntu 22.04 jammy package). Omitting
## directives the daemon doesn't recognize is required — the daemon
## treats unknown directives as fatal, not warnings.

CacheDir: {{ apt_cacher_ng_cache_dir }}
LogDir:   {{ apt_cacher_ng_log_dir }}

Port:     {{ apt_cacher_ng_port }}

{% if apt_cacher_ng_bind_addresses | length > 0 %}
BindAddress: {{ apt_cacher_ng_bind_addresses | join(' ') }}
{% endif %}

# Daily cleanup retention.
ExTreshold: {{ apt_cacher_ng_expire_days }}

# Verbosity. 7 is upstream default.
VerboseLog: {{ apt_cacher_ng_verbosity }}

# Default behaviour: serve files even if HEAD fails (e.g. mirror is
# down) when we have a fresh-enough cached copy. Critical for
# island-mode operation.
ExAbortOnProblems: 0

# Pull in per-distro mirror lists (one file per upstream, rendered
# alongside this config).
{% for item in apt_cacher_ng_remap %}
Remap-{{ item.name }}: file:{{ item.name }}_mirrors {{ item.backends_url }}
{% endfor %}

# /acng-report.html lives at /
ReportPage: acng-report.html

# Allow LAN clients to query the report page; otherwise it 403s on a
# remote browser. The page exposes cache stats only — no client data.
LocalDirs: acng-doc /usr/share/doc/apt-cacher-ng
