[Unit]
Description=Publish this goatnet's relay rollup to sibling relay-health boxes (goatnets.html)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile={{ relay_health_dir }}/goatnet-summary-publish.env
ExecStart=/usr/bin/env bash {{ relay_health_dir }}/goatnet-summary-publish.sh
# Best-effort by design: a sibling being unreachable is normal — it may be down,
# which is exactly when its neighbour's dashboard matters. The script exits 0
# regardless so this unit's health never becomes a proxy for the sibling's.
