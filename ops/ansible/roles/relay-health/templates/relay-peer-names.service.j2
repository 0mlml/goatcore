# Rendered by ops/ansible/roles/relay-health/ — DO NOT EDIT ON HOST.
# ADR 1055 — resolve relay per-peer hashed IDs to friendly NetBird names.
# Reads (pubkey,name) from the mgmt Postgres, computes hex("sha-")+sha256(pubkey)
# (the exact id the relay stats endpoint emits), and publishes the {hex:name} map
# to the local ingest dir + the cloud ingest so both dashboards render names.
# Thor-only: needs mgmt-store access (docker exec into the postgres container).
[Unit]
Description=relay-health peer-id -> NetBird name resolver (ADR 1055)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile={{ relay_health_dir }}/relay-peer-names.env
ExecStart=/usr/bin/env python3 {{ relay_health_dir }}/relay-peer-names.py
