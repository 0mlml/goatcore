# Rendered by ops/ansible/roles/relay-health/ — DO NOT EDIT ON HOST.
# Gauges on the portal registry's SQLite files (db/WAL/shm) → node-exporter
# textfile, so rules/registry-wal.yml can watch the FILE. The 2026-08-15 WAL
# leak recurred at ~200 GB/day in bursts and grew registry.db-wal to 91.4 GB
# unnoticed: ThorDiskRunwayShort derives runway from the 24h AVERAGE burn,
# which smoothed the bursts to a ~19-day runway that never crossed its 14-day
# threshold. Runs as root: the registry lives in the portal's data dir, owned
# by the container's user.
[Unit]
Description=portal registry WAL gauges (node-exporter textfile)
After=local-fs.target

[Service]
Type=oneshot
EnvironmentFile={{ relay_health_dir }}/registry-wal-signals.env
ExecStart={{ relay_health_dir }}/registry-wal-signals.py --registry ${REGISTRY_DB} --out ${REGISTRY_PROM_OUT}
