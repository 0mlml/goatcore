# Rendered by ops/ansible/roles/relay-health/ — DO NOT EDIT ON HOST.
[Unit]
Description=Run the zenoh fabric cardinality sampler every {{ zenoh_fabric_sampler_interval_s | default(60) }}s

[Timer]
# 60s (not 30s like the health probe) — the full `**` walk is the expensive read
# this instrument is about; keep its observer-cost low.
OnBootSec=90
OnUnitActiveSec={{ zenoh_fabric_sampler_interval_s | default(60) }}s
AccuracySec=5s

[Install]
WantedBy=timers.target
