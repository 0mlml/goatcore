# Rendered by ops/ansible/roles/relay-health/ — DO NOT EDIT ON HOST.
# registry-wal-signals.py config. Mode 0644 — unlike the zenoh probe's env,
# this one carries no bearer token, only two paths.
#
# REGISTRY_DB must match the portal role's portal_db_path
# (roles/goat-zenoh-portal/defaults: portal_data_dir + /registry.db); override
# registry_wal_db_path in group_vars if a goatnet moves the data dir.
REGISTRY_DB={{ registry_wal_db_path | default('/opt/goat-zenoh-portal/registry.db') }}
# Written into the same node-exporter textfile dir the relay-health bridge
# already uses, so the goatnet's Prometheus picks it up with no scrape change.
REGISTRY_PROM_OUT={{ registry_wal_prom_out | default((relay_health_textfile_out | dirname) ~ '/registry-wal.prom') }}
