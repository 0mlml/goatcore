# Rendered by ops/ansible/roles/relay-health/ — DO NOT EDIT ON HOST.
# ADR 1093 Phase 1 — publish the ACTIVE Kratos roster to the relay-health box's
# allowlist ingest, so the public dashboard gate follows membership. Thor-only
# (needs Kratos on the mgmt network). Fail-safe: the box keeps last-good on a
# below-floor list, so a broken read here never locks the fleet out.
[Unit]
Description=relay-health dashboard allowlist auto-sync (ADR 1093 Phase 1)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile={{ relay_health_dir }}/relay-health-allowlist-publish.env
ExecStart=/usr/bin/env bash {{ relay_health_dir }}/relay-health-allowlist-publish.sh
