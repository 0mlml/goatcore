# Rendered by ops/ansible/roles/relay-health/ — DO NOT EDIT ON HOST.
# iperf3 server used as the capacity-probe TARGET. Bound to the MESH IP only, so
# only mesh peers (authenticated by WireGuard) can reach it — never the public
# interface. This is why the target lives on a mesh peer (the cloud relay-health
# box), NOT on the relays, which are public-facing and not mesh peers.
[Unit]
Description=iperf3 capacity-probe target (mesh-bound)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# --bind the mesh IP; if wt0 isn't up yet at boot the bind fails and Restart
# retries until netbird brings the mesh up.
ExecStart=/usr/bin/iperf3 --server --bind {{ relay_health_iperf3_bind }} --port {{ relay_health_iperf3_port }} --interval 0
Restart=always
RestartSec=10
DynamicUser=yes
# One long-lived server; a client's short test never keeps it busy for long.
Nice=10

[Install]
WantedBy=multi-user.target
