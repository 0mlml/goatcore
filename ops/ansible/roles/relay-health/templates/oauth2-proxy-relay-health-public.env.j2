# oauth2-proxy env — relay-health PUBLIC break-glass gate (ADR 1061 Phase 2).
# Rendered by ops/ansible/roles/relay-health (mode 0600). DO NOT EDIT ON HOST.
#
# Login via the PUBLIC Dex (Kanidm-backed). This is the
# permanent off-mesh break-glass path. Distinct from the Thor mode's Ory/Hydra
# oauth2-proxy (oauth2-proxy-relay-health.env.j2) — that one is mesh-internal.
#
# GATE = EXPLICIT EMAIL ALLOWLIST. The public Dex broker emits no `groups`
# claim, so this proxy cannot use ALLOWED_GROUPS like the mesh gate does.
# Instead only the addresses in the mounted authenticated-emails file pass —
# whichever upstream (Google/Microsoft/Kanidm) authenticated them. The list is
# relay_health_public_allowed_emails (group_vars), rendered to the file below;
# a fail-closed assert refuses to deploy with an empty list. A RELAY-HEALTH
# group claim is the durable form once Dex carries groups (public-plane
# follow-on). Was: EMAIL_DOMAINS=* (admitted any authenticated user — closed).

OAUTH2_PROXY_PROVIDER=oidc
OAUTH2_PROXY_OIDC_ISSUER_URL={{ relay_health_public_oidc_issuer }}
OAUTH2_PROXY_CLIENT_ID={{ relay_health_public_oidc_client_id }}
OAUTH2_PROXY_CLIENT_SECRET={{ relay_health_public_oidc_client_secret }}
OAUTH2_PROXY_COOKIE_SECRET={{ relay_health_public_cookie_secret }}

# The single public host this proxy fronts.
OAUTH2_PROXY_REDIRECT_URL=https://{{ relay_health_fqdn }}/oauth2/callback
OAUTH2_PROXY_COOKIE_DOMAINS={{ relay_health_fqdn }}
OAUTH2_PROXY_WHITELIST_DOMAINS={{ relay_health_fqdn }}

# Upstream = the internal dashboard nginx (compose service name).
OAUTH2_PROXY_UPSTREAMS=http://relay-health:80
OAUTH2_PROXY_HTTP_ADDRESS=0.0.0.0:4180
OAUTH2_PROXY_REVERSE_PROXY=true

# Gate: ONLY the emails in this file pass (explicit allowlist). No EMAIL_DOMAINS
# wildcard — that would OR with the file and re-open the door to anyone. The
# file is mounted read-only into the container by docker-compose.public.yml.
OAUTH2_PROXY_AUTHENTICATED_EMAILS_FILE=/etc/oauth2-proxy/authenticated-emails.txt
# Kanidm/Dex emails may be unverified, so still accept them for allowlist match.
OAUTH2_PROXY_INSECURE_OIDC_ALLOW_UNVERIFIED_EMAIL=true
OAUTH2_PROXY_SCOPE=openid email profile

# Refusal page — F-334. The stock 403 states neither which identity it received
# nor that authorization here is an email allowlist at all, so someone refused
# by a correctly-configured door has no reason to suspect their own address
# rather than the service. The override explains the rule and prints the request
# id, which is what lets an admin find the presented address in the access log.
# It CANNOT print that address itself: oauth2-proxy v7.6.0 does not pass it to
# the error template. Only error.html is overridden; sign_in.html stays stock.
OAUTH2_PROXY_CUSTOM_TEMPLATES_DIR=/etc/oauth2-proxy/templates

# Cookies: public HTTPS only.
OAUTH2_PROXY_COOKIE_SECURE=true
OAUTH2_PROXY_COOKIE_SAMESITE=lax

# Straight to Dex (one connector), pass identity headers to the dashboard.
OAUTH2_PROXY_SKIP_PROVIDER_BUTTON=true
OAUTH2_PROXY_SET_XAUTHREQUEST=true
OAUTH2_PROXY_PASS_USER_HEADERS=true
OAUTH2_PROXY_PASS_ACCESS_TOKEN=false
# Parallel login flows (a page and its favicon/XHRs racing through
# /oauth2/start together) each mint a CSRF cookie; without per-request
# cookies the later flow overwrites the earlier one's and the first
# callback 403s ("CSRF token mismatch, potential attack") even though
# authentication succeeded.
OAUTH2_PROXY_COOKIE_CSRF_PER_REQUEST=true
OAUTH2_PROXY_COOKIE_CSRF_EXPIRE=15m

# SESSION_COOKIE_MINIMAL — F-310.
#
# With no session store configured oauth2-proxy defaults to `cookie` and packs
# the WHOLE session into it: id_token + access_token + refresh_token, plus the
# groups claim the fence gates on. That exceeds the browser's per-cookie limit,
# the cookie is dropped, and the session evaporates a minute or two after a
# successful login — every refresh re-authenticates. oauth2-proxy logs NO
# warning for this: it warns when it SPLITS a cookie, never when the browser
# then declines to keep it, so the failure is invisible server-side.
#
# Without this a session with an 8 h expiry re-authenticates within minutes;
# with it, dozens of authenticated requests need only a login or two.
#
# `minimal` keeps email + user + groups and drops the three tokens. Verified
# compatible with SET_XAUTHREQUEST (tested against v7.6.0: the proxy starts and
# validates) — the X-Auth-Request-* headers are built from session fields, not
# from the tokens, so in-app group scoping is unaffected.
#
# COOKIE_REFRESH is REMOVED where it was set: it is mutually exclusive with
# minimal, because a refresh needs the refresh token minimal does not keep.
# Consequence stated rather than discovered — the session now lives to
# COOKIE_EXPIRE instead of being silently renewed, and Kratos's 24 h SSO makes
# the eventual re-auth a redirect, not a password prompt.
OAUTH2_PROXY_SESSION_COOKIE_MINIMAL=true
