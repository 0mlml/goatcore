# Managed by ansible (roles/mesh-membership-reconcile). Do not edit on the host.
#
#   systemctl list-timers mesh-membership-reconcile.timer
#   journalctl -u mesh-membership-reconcile.service -n 50
#   cat {{ mesh_membership_reconcile_report_dir }}/last-run.txt
[Unit]
Description=Daily NetBird membership audit
Documentation=https://github.com/usareur-af/goatcore/blob/main/docs/design/live-state-guard-scheduling.md

[Timer]
OnCalendar={{ mesh_membership_reconcile_oncalendar }}
RandomizedDelaySec={{ mesh_membership_reconcile_jitter_sec }}
AccuracySec=1min
# Persistent so a host that was down at 06:41 audits when it comes back rather
# than skipping a day in silence. Catching up late is a worse audit than
# on-time; no audit is the failure this whole finding is about.
Persistent=true
Unit=mesh-membership-reconcile.service

[Install]
WantedBy=timers.target
