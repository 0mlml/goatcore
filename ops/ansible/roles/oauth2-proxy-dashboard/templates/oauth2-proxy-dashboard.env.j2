# Rendered by ops/ansible/roles/oauth2-proxy-dashboard/ — DO NOT EDIT ON HOST.
# Mode 0600 root:root.
#
# Consumed by the oauth2-proxy-dashboard container in
# docker-compose.oauth2-proxy-dashboard.yml.

# --- OIDC provider (site Hydra) ---
OAUTH2_PROXY_PROVIDER=oidc
OAUTH2_PROXY_OIDC_ISSUER_URL={{ dashboard_oauth2_proxy_oidc_issuer_url }}
OAUTH2_PROXY_CLIENT_ID={{ dashboard_oauth2_proxy_oidc_client_id }}
OAUTH2_PROXY_CLIENT_SECRET={{ dashboard_oauth2_proxy_client_secret }}

# Scopes — `groups` is the load-bearing one for the ADMINS gate. Without it
# the JWT carries no groups claim and OAUTH2_PROXY_ALLOWED_GROUPS can never
# match. The patched site-Hydra consent UI (ADR 0857) forwards Kratos
# traits.groups into this claim. `offline_access` requests a refresh_token
# so oauth2-proxy can silently roll the session at the COOKIE_REFRESH=1h
# boundary below; without it the access_token expires (Hydra default ~1h),
# refresh fails, and the user gets bounced through the full login flow
# every ~1h — that's the user-visible "auth fails" / "rough navigation"
# symptom. Must match the OIDC client's allowed scopes (kept in sync via
# the oauth2-proxy-dashboard-oidc-client role's scopes list).
OAUTH2_PROXY_SCOPE=openid profile email groups offline_access

# --- Authorization (the whole point of this sidecar) ---
# Refuse with 403 when the JWT's `groups` claim doesn't intersect this list.
# OAUTH2_PROXY_EMAIL_DOMAINS=* allows any verified email; the ALLOWED_GROUPS
# check then narrows to admins. (Setting only ALLOWED_GROUPS without
# EMAIL_DOMAINS leaves oauth2-proxy in pre-7.0 'no email check' mode which
# rejects everyone.)
OAUTH2_PROXY_EMAIL_DOMAINS=*
OAUTH2_PROXY_ALLOWED_GROUPS={{ dashboard_oauth2_proxy_allowed_groups }}

# --- Cookie / session ---
# Random 32-byte secret base64-encoded. Sourced from
# NOVA_DASHBOARD_OAUTH2_PROXY_COOKIE_SECRET (or per-site analog).
OAUTH2_PROXY_COOKIE_SECRET={{ dashboard_oauth2_proxy_cookie_secret }}
# Scope cookie to the dashboard hostname so a stolen cookie can't be
# replayed against auth.* / oauth2.* / mgmt.* on sibling subdomains.
OAUTH2_PROXY_COOKIE_DOMAINS={{ dashboard_oauth2_proxy_cookie_domain }}
OAUTH2_PROXY_COOKIE_SECURE=true
OAUTH2_PROXY_COOKIE_HTTPONLY=true
OAUTH2_PROXY_COOKIE_SAMESITE=lax
OAUTH2_PROXY_COOKIE_EXPIRE=8h
# SESSION_COOKIE_MINIMAL — F-310.
#
# The default cookie session packs id_token + access_token + refresh_token
# alongside the claims. Past ~4 KB the browser silently drops the cookie, the
# proxy sees no session, and the user is bounced to the IdP on EVERY page load
# — which reads as "it keeps logging me out" rather than as a size limit.
#
# `minimal` stores only what the fence needs — email, user, groups — and drops
# the three tokens. Safe here: SET_AUTHORIZATION_HEADER is false and nothing
# downstream reads a token; SET_XAUTHREQUEST populates its headers from the
# session fields that minimal keeps.
#
# COOKIE_REFRESH is REMOVED because it is mutually exclusive with minimal — a
# refresh needs the refresh token minimal deliberately does not keep, and
# oauth2-proxy refuses to start with both ("cookie_refresh > 0 requires oauth
# tokens in sessions"). Consequence, stated rather than discovered later: the
# session now lives to COOKIE_EXPIRE (8 h) instead of being renewed at 1 h.
# Not a regression in practice — Kratos holds a 24 h SSO session, so the 8 h
# re-auth is a redirect, not a password prompt.
OAUTH2_PROXY_SESSION_COOKIE_MINIMAL=true

# --- Listener / routing ---
OAUTH2_PROXY_HTTP_ADDRESS=0.0.0.0:4180
OAUTH2_PROXY_REVERSE_PROXY=true
OAUTH2_PROXY_WHITELIST_DOMAINS={{ dashboard_oauth2_proxy_fqdn }}
OAUTH2_PROXY_REDIRECT_URL=https://{{ dashboard_oauth2_proxy_fqdn }}/oauth2/callback

# --- Upstream: forward authenticated requests to the netbird-dashboard
#     nginx container. The Hydra/Kratos UI dialog happens above this layer;
#     once oauth2-proxy has a valid session cookie + ADMINS group, requests
#     pass through to dashboard:80 and the SPA loads. ---
OAUTH2_PROXY_UPSTREAMS={{ dashboard_oauth2_proxy_upstream }}

# --- Pass identity downstream so the dashboard SPA (or future admin-only
#     features) can read X-Auth-Request-* without re-decoding the JWT. ---
OAUTH2_PROXY_PASS_USER_HEADERS=true
OAUTH2_PROXY_SET_XAUTHREQUEST=true
OAUTH2_PROXY_SET_AUTHORIZATION_HEADER=false

# --- Skip provider-button page; jump straight to Hydra. ---
OAUTH2_PROXY_SKIP_PROVIDER_BUTTON=true

# --- Logging ---
OAUTH2_PROXY_REQUEST_LOGGING=true
OAUTH2_PROXY_AUTH_LOGGING=true
OAUTH2_PROXY_STANDARD_LOGGING=true
# Parallel login flows (a page and its favicon/XHRs racing through
# /oauth2/start together) each mint a CSRF cookie; without per-request
# cookies the later flow overwrites the earlier one's and the first
# callback 403s ("CSRF token mismatch, potential attack") even though
# authentication succeeded.
OAUTH2_PROXY_COOKIE_CSRF_PER_REQUEST=true
OAUTH2_PROXY_COOKIE_CSRF_EXPIRE=15m
