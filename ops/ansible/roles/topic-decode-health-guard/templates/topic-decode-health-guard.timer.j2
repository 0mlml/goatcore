# Managed by ansible (roles/topic-decode-health-guard). Do not edit on the host.
#
#   systemctl list-timers topic-decode-health-guard.timer
#   journalctl -u topic-decode-health-guard.service -n 60
#   cat {{ topic_decode_health_guard_report_dir }}/last-run.txt
[Unit]
Description=Hourly topic decode-health audit

[Timer]
# Hourly at :43 — offset from mesh-membership-reconcile (06:41) and
# machine-provenance-guard (:17). The bug this catches stood for WEEKS, so the
# gap between hourly and six-hourly is not what matters; not landing on another
# timer's second is.
OnCalendar={{ topic_decode_health_guard_oncalendar }}
RandomizedDelaySec={{ topic_decode_health_guard_jitter_sec }}
AccuracySec=1min
# Persistent so a host that was down at :43 audits when it returns rather than
# skipping in silence. A late audit beats no audit; no audit is the failure this
# whole role is about.
Persistent=true
Unit=topic-decode-health-guard.service

[Install]
WantedBy=timers.target
