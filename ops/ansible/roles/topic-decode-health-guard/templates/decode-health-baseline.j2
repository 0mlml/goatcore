# Managed by ansible (roles/topic-decode-health-guard). DO NOT EDIT ON THE HOST.
# Rendered from topic_decode_health_guard_baseline in this goatnet's group_vars,
# so every entry costs a reviewed commit that states why it is here.
#
# Format, tab-separated:  <key>\t<verdict>\t<clear_by>\t<why>
#
# An entry whose clear_by has passed stops suppressing and the topic fails
# again. That is deliberate: a baseline without an expiry is just deleting the
# check, slowly.
{% for b in topic_decode_health_guard_baseline %}
{{ b.key }}	{{ b.verdict }}	{{ b.clear_by }}	{{ b.why }}
{% endfor %}
