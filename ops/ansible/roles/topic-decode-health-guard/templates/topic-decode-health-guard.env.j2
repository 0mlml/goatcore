# Managed by ansible (roles/topic-decode-health-guard). Do not edit on the host.
# Mode 0600, root-owned. Holds a portal operator key.
#
# PORTAL_OPERATOR_API_KEY is the name the check itself reads (see its argparse
# env fallbacks) — do not rename it here without changing the check.
PORTAL_BASE_URL={{ topic_decode_health_guard_portal_url }}
PORTAL_OPERATOR_API_KEY={{ topic_decode_health_guard_portal_key }}
ZENOH_REST_URL={{ topic_decode_health_guard_router_url }}
# Grades that make this unit FAIL. Everything else is reported, counted and not
# treated as a regression — the contract's "never fail on a backlog".
FAIL_ON={{ topic_decode_health_guard_fail_on | join(',') }}
STALE_AFTER={{ topic_decode_health_guard_stale_after }}
{% if topic_decode_health_guard_baseline | length > 0 %}
BASELINE_FILE=/etc/goat/decode-health-baseline
{% endif %}
REPORT_DIR={{ topic_decode_health_guard_report_dir }}
TEXTFILE_DIR={{ topic_decode_health_guard_textfile_dir }}
LIB_DIR={{ topic_decode_health_guard_lib_dir }}
