# Generated by the consistency-console role (tasks/aggregate.yml) — do not
# edit on host. Rendered to
# {{ consistency_aggregator_traefik_dynamic_dir }}/consistency-aggregator.yml,
# a SIBLING of relay-health.yml in the same relay-health Traefik file
# provider — one Traefik, two surfaces, one LE resolver.
#
# Fence chain: Traefik -> oauth2-proxy-consistency-aggregator:4180
# (PLATFORM-ADMIN group gate against the hosting goatnet's Hydra) ->
# consistency-aggregator:9760. No CLI-bypass router: the console validates no
# bearer of its own, so a bypass would be an ungated door.

http:
  routers:
    consistency-aggregator:
      rule: "Host(`{{ consistency_aggregator_hostname }}`)"
      entryPoints:
        - websecure
      service: consistency-aggregator
      tls:
        certResolver: {{ consistency_aggregator_traefik_cert_resolver }}
        domains:
          - main: "{{ consistency_aggregator_hostname }}"

  services:
    consistency-aggregator:
      loadBalancer:
        servers:
{% if consistency_aggregator_oauth2_proxy_enabled | bool %}
          - url: "http://oauth2-proxy-consistency-aggregator:4180"
{% else %}
          # Fence disabled (bring-up only — NEVER a steady state).
          - url: "http://consistency-aggregator:9760"
{% endif %}
