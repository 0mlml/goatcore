# Rendered by ops/ansible/roles/consistency-console tasks/aggregate.yml —
# DO NOT EDIT ON HOST. Mode 0600 root:root. Consumed by
# oauth2-proxy-consistency-aggregator in docker-compose.yml. The fence IS the
# authorization layer, in one of two modes (consistency_aggregator_gate):
# hydra-groups = the per-goatnet console ceremony (oauth2-proxy-microscope
# shape, ADR 0860; allowed-groups parity-ratcheted, ADR 1073);
# dex-allowlist = the relay-health public-door ceremony (ADR 1061 Phase 2;
# roster-synced email allowlist, ADR 1093).

{% if consistency_aggregator_gate | default('hydra-groups') == 'dex-allowlist' %}
# --- OIDC provider (the PUBLIC Dex broker — relay-health door ceremony) ---
OAUTH2_PROXY_PROVIDER=oidc
OAUTH2_PROXY_OIDC_ISSUER_URL={{ consistency_aggregator_dex_issuer_url }}
OAUTH2_PROXY_CLIENT_ID={{ consistency_aggregator_dex_client_id }}
OAUTH2_PROXY_CLIENT_SECRET={{ consistency_aggregator_dex_client_secret }}

# Dex emits no `groups` claim — the email allowlist IS the authorization.
OAUTH2_PROXY_SCOPE=openid email profile

# --- Authorization: ONLY the emails in the roster-synced file pass. No
# EMAIL_DOMAINS wildcard — that would OR with the file and re-open the door
# (the relay-health public gate's hard-learned rule). ---
OAUTH2_PROXY_AUTHENTICATED_EMAILS_FILE=/etc/oauth2-proxy/authenticated-emails.txt
# Kanidm/Dex emails may be unverified; still accept them for allowlist match.
OAUTH2_PROXY_INSECURE_OIDC_ALLOW_UNVERIFIED_EMAIL=true
{% else %}
# --- OIDC provider (the HOSTING goatnet's Hydra) ---
OAUTH2_PROXY_PROVIDER=oidc
OAUTH2_PROXY_OIDC_ISSUER_URL={{ consistency_aggregator_oauth2_proxy_oidc_issuer_url }}
OAUTH2_PROXY_CLIENT_ID={{ consistency_aggregator_oauth2_proxy_client_id }}
OAUTH2_PROXY_CLIENT_SECRET={{ consistency_aggregator_oauth2_proxy_client_secret }}

# `groups` is load-bearing for the admin gate; offline_access enables silent refresh.
OAUTH2_PROXY_SCOPE=openid profile email groups offline_access

# --- Authorization: platform-operator group only (case-sensitive, F-198) ---
OAUTH2_PROXY_EMAIL_DOMAINS=*
OAUTH2_PROXY_ALLOWED_GROUPS={{ consistency_aggregator_oauth2_proxy_allowed_groups }}
{% endif %}

# --- Cookie / session ---
OAUTH2_PROXY_COOKIE_SECRET={{ consistency_aggregator_oauth2_proxy_cookie_secret }}
OAUTH2_PROXY_COOKIE_DOMAINS={{ consistency_aggregator_hostname }}
OAUTH2_PROXY_COOKIE_SECURE=true
OAUTH2_PROXY_COOKIE_HTTPONLY=true
OAUTH2_PROXY_COOKIE_SAMESITE=lax
OAUTH2_PROXY_COOKIE_EXPIRE=8h
# Parallel login flows (page + favicon/XHR racing /oauth2/start) overwrite
# each other's CSRF cookie without these.
OAUTH2_PROXY_COOKIE_CSRF_PER_REQUEST=true
OAUTH2_PROXY_COOKIE_CSRF_EXPIRE=15m

# --- Listener / routing ---
OAUTH2_PROXY_HTTP_ADDRESS=0.0.0.0:4180
OAUTH2_PROXY_REVERSE_PROXY=true
OAUTH2_PROXY_WHITELIST_DOMAINS={{ consistency_aggregator_hostname }}
OAUTH2_PROXY_REDIRECT_URL=https://{{ consistency_aggregator_hostname }}/oauth2/callback

# --- Upstream: the aggregator ---
OAUTH2_PROXY_UPSTREAMS=http://consistency-aggregator:9760

# Pass identity downstream.
OAUTH2_PROXY_PASS_USER_HEADERS=true
OAUTH2_PROXY_SET_XAUTHREQUEST=false
OAUTH2_PROXY_SET_AUTHORIZATION_HEADER=false

# Skip the provider-button page; jump straight to Hydra.
OAUTH2_PROXY_SKIP_PROVIDER_BUTTON=true

# --- Logging (auth denials ship via goat-logship's oauth2_proxy source) ---
OAUTH2_PROXY_REQUEST_LOGGING=true

# SESSION_COOKIE_MINIMAL — F-310.
#
# With no session store configured oauth2-proxy defaults to `cookie` and packs
# the WHOLE session into it: id_token + access_token + refresh_token, plus the
# groups claim the fence gates on. That exceeds the browser's per-cookie limit,
# the cookie is dropped, and the session evaporates a minute or two after a
# successful login — every refresh re-authenticates. oauth2-proxy logs NO
# warning for this: it warns when it SPLITS a cookie, never when the browser
# then declines to keep it, so the failure is invisible server-side.
#
# `minimal` keeps email + user + groups and drops the three tokens. Verified
# compatible with SET_XAUTHREQUEST (tested against v7.6.0: the proxy starts and
# validates) — the X-Auth-Request-* headers are built from session fields, not
# from the tokens, so in-app group scoping is unaffected.
#
# COOKIE_REFRESH is REMOVED where it was set: it is mutually exclusive with
# minimal, because a refresh needs the refresh token minimal does not keep.
# Consequence stated rather than discovered — the session now lives to
# COOKIE_EXPIRE instead of being silently renewed, and Kratos's 24 h SSO makes
# the eventual re-auth a redirect, not a password prompt.
OAUTH2_PROXY_SESSION_COOKIE_MINIMAL=true
