# {{ ansible_managed }}
#
# CF-7 aggregator config (consistency-foundation.md §7.8) — rendered by
# ops/ansible/roles/consistency-console tasks/aggregate.yml from
# consistency_aggregator_goatnets. Paths are CONTAINER paths (absolute, so
# nothing resolves against this file's location).
#
# An unreachable endpoint renders that goatnet indeterminate-with-age — never
# green, never absent. Declaring a goatnet before its transport exists is
# deliberate: it makes the gap visible (the relay_health_goatnets precedent).
goatnets:
{% for g in consistency_aggregator_goatnets %}
  - name: "{{ g.name }}"
    site: "{{ g.site }}"
    endpoint: "{{ g.endpoint }}"
    intent_file: /intent/{{ g.goatnet }}/intent.json
    pubkey_dir: /intent/public-keys
{% if g.console_url is defined and g.console_url %}
    # This goatnet's OWN console — the copy that still answers when the WAN is
    # cut (consistency-foundation.md §7.9 island mode). Optional; omitted =
    # link hidden, never dead.
    console_url: "{{ g.console_url }}"
{% endif %}
{% if g.endpoint is match('^tls/') %}
    cert: /certs/{{ g.name }}/leaf-cert.pem
    key: /certs/{{ g.name }}/leaf-key.pem
    root_ca: /certs/{{ g.name }}/ca-root-cert.pem
{% endif %}
{% endfor %}
