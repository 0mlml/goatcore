# Generated by the consistency-console Ansible role — do not edit on host.
# Rendered to {{ consistency_console_traefik_dynamic_dir }}/{{ consistency_console_traefik_dynamic_filename }}.
#
# Fence chain (consistency-foundation.md §7.2, the microscope shape):
# Traefik (mesh-only middleware, defense in depth) ->
# oauth2-proxy-consistency-console:4180 (PLATFORM-ADMIN group gate) ->
# consistency-console:9760. No CLI-bypass router: the console validates no
# bearer of its own, so a bypass would be an ungated door, not a convenience.

http:
  routers:
    {{ consistency_console_traefik_router_name }}:
      rule: "Host(`{{ consistency_console_hostname }}`)"
      entryPoints:
        - websecure
      service: {{ consistency_console_traefik_router_name }}
{% if consistency_console_traefik_mesh_only_middleware | default('') | length > 0 %}
      middlewares:
        - "{{ consistency_console_traefik_mesh_only_middleware }}"
{% endif %}
      tls:
        certResolver: {{ consistency_console_traefik_cert_resolver }}

  services:
    {{ consistency_console_traefik_router_name }}:
      loadBalancer:
        servers:
{% if consistency_console_oauth2_proxy_enabled | bool %}
          - url: "http://oauth2-proxy-consistency-console:4180"
{% else %}
          # Fence disabled (bring-up only — NEVER a steady state).
          - url: "http://consistency-console:9760"
{% endif %}
