{
  "realm": "{{ icam_keycloak_cac_realm }}",
  "enabled": true,
  "sslRequired": "external",
  "directGrantFlow": "x509 direct grant",
  "browserFlow": "x509 browser",
  "clients": [
    {
      "clientId": "{{ icam_keycloak_cac_kratos_client_id }}",
      "enabled": true,
      "publicClient": false,
      "secret": "${ICAM_KC_KRATOS_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": ["{{ icam_keycloak_cac_kratos_redirect }}"],
      "protocolMappers": [
        {
          "name": "edipi",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "username",
            "claim.name": "edipi",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "authenticationFlows": [
    {
      "alias": "x509 direct grant",
      "description": "Direct grant authenticated by a CAC x509 client certificate.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {"authenticator": "direct-grant-auth-x509-username", "requirement": "REQUIRED", "priority": 10, "authenticatorConfig": "x509-edipi-config"}
      ]
    },
    {
      "alias": "x509 browser",
      "description": "Browser flow authenticated by a CAC x509 client certificate.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {"authenticator": "auth-x509-client-username-form", "requirement": "ALTERNATIVE", "priority": 10, "authenticatorConfig": "x509-edipi-config"}
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "x509-edipi-config",
      "config": {
        "x509-cert-auth.mapping-source-selector": "Match SubjectDN using regular expression",
        "x509-cert-auth.regular-expression": "{{ icam_keycloak_cac_edipi_dn_regex }}",
        "x509-cert-auth.mapper-selector": "Username or Email",
        "x509-cert-auth.canonical-dn-enabled": "false",
        "x509-cert-auth.timestamp-validation-enabled": "true",
        "x509-cert-auth.crl-checking-enabled": "{{ icam_keycloak_cac_crl_enabled | bool | lower }}",
        "x509-cert-auth.ocsp-checking-enabled": "{{ icam_keycloak_cac_ocsp_enabled | bool | lower }}"
      }
    }
  ]
}
