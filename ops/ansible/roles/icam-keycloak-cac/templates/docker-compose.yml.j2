# icam-keycloak-cac — Keycloak CAC front-end (toggle-switch path #3). Rendered by the
# role when icam_keycloak_cac_enabled. Proven shape: ops/identity/keycloak-cac-proof/.
# Mesh-only: ports bind the netbird mesh IP (no public plane).
services:
  keycloak:
    image: {{ icam_keycloak_cac_image }}
    command: ["start", "--import-realm", "--https-client-auth=request", "--hostname={{ icam_keycloak_cac_issuer_url | regex_replace('^https?://([^/]+)/.*$', '\\1') }}", "--proxy-headers=xforwarded"]
    environment:
      KC_BOOTSTRAP_ADMIN_USERNAME: "{{ icam_keycloak_cac_admin_user | default('admin') }}"
      KC_BOOTSTRAP_ADMIN_PASSWORD: "${ICAM_KC_ADMIN_PASSWORD:?set ICAM_KC_ADMIN_PASSWORD}"
      KC_HTTPS_CERTIFICATE_FILE: /certs/server.crt
      KC_HTTPS_CERTIFICATE_KEY_FILE: /certs/server.key
      KC_TRUSTSTORE_PATHS: /certs/ca-bundle.pem
      KC_HTTP_ENABLED: "true"
      KC_DB: "{{ icam_keycloak_cac_db | default('dev-file') }}"
    volumes:
      - ./certs/server.crt:/certs/server.crt:ro
      - ./certs/server.key:/certs/server.key:ro
      - ./certs/ca-bundle.pem:/certs/ca-bundle.pem:ro
      - ./realm-goat.json:/opt/keycloak/data/import/realm-goat.json:ro
    ports:
      - "{{ icam_keycloak_cac_bind_ip | default('127.0.0.1') }}:{{ icam_keycloak_cac_https_port }}:8443"
      - "{{ icam_keycloak_cac_bind_ip | default('127.0.0.1') }}:{{ icam_keycloak_cac_http_port }}:8080"
    restart: unless-stopped
