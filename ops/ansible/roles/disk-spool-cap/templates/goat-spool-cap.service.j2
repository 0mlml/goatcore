# {{ ansible_managed }}
[Unit]
Description=Trim mgmt-host spools to their byte ceilings
Documentation=file://{{ disk_spool_cap_script }}

[Service]
Type=oneshot
ExecStart={{ disk_spool_cap_script }}
# A trim that cannot run must not be silent: the timer keeps firing, and the
# failed unit is what systemctl --failed and the obs scrape both surface.
