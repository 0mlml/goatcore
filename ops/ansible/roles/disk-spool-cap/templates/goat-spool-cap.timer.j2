# {{ ansible_managed }}
[Unit]
Description=Trim mgmt-host spools to their byte ceilings, every {{ disk_spool_cap_interval }}

[Timer]
OnBootSec=5min
OnUnitActiveSec={{ disk_spool_cap_interval }}
# A missed run (box off, maintenance) trims on the next boot rather than
# waiting a full interval on a disk that may already be over.
Persistent=true

[Install]
WantedBy=timers.target
