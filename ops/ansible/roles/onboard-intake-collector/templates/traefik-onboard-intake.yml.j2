# {{ ansible_managed }}
# Traefik dynamic config for the public onboarding front desk (ADR 1062 stage 1).
# A single router on the ENROLLMENT entrypoint (the public rathole path, F-153)
# for the intake hostname → the thin collector. Carries its OWN cert
# (tls.domains) so the intake hostname never lands in the public enrollment
# cert's SAN list (the SNI-leak discipline of a public posture).
http:
  routers:
    onboard-intake:
      priority: 100
      rule: "Host(`{{ onboard_intake_public_fqdn }}`)"
      entryPoints:
        - {{ onboard_intake_entrypoint }}
      service: onboard-intake
      tls:
        certResolver: {{ onboard_intake_cert_resolver }}
        domains:
          - main: "{{ onboard_intake_public_fqdn }}"
  services:
    onboard-intake:
      loadBalancer:
        servers:
          - url: "http://{{ onboard_intake_container_name }}:80"
        passHostHeader: true
