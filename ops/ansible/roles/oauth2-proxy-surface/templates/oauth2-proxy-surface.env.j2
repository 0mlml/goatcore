# Rendered by ops/ansible/roles/oauth2-proxy-surface/ for the
# {{ oauth2_proxy_surface_name }} door — DO NOT EDIT ON HOST.
# Mode 0600 root:root.

# --- OIDC provider (site Hydra) ---
OAUTH2_PROXY_PROVIDER=oidc
OAUTH2_PROXY_OIDC_ISSUER_URL={{ oauth2_proxy_surface_oidc_issuer_url }}
OAUTH2_PROXY_CLIENT_ID={{ oauth2_proxy_surface_oidc_client_id }}
OAUTH2_PROXY_CLIENT_SECRET={{ oauth2_proxy_surface_client_secret }}

# `groups` is in scope even where no group is gated on: the claim is what a
# downstream app reads to scope its own view, and adding it later means
# re-consenting every identity.
OAUTH2_PROXY_SCOPE={{ oauth2_proxy_surface_oidc_scope }}

{% if oauth2_proxy_surface_allowed_groups | length > 0 %}
# --- Authorization: GROUP GATE. The matrix row for this surface must say
#     `door: group-gated`, and the group list here must equal the set the
#     matrix grants — ops/ci/check-group-permissions-parity.sh fails the build
#     on divergence. ---
OAUTH2_PROXY_ALLOWED_GROUPS={{ oauth2_proxy_surface_allowed_groups }}
{% else %}
# --- Authorization: AUTHENTICATED DOOR. No OAUTH2_PROXY_ALLOWED_GROUPS, on
#     purpose. Any identity the site Hydra issues a token for passes; nobody is
#     refused by group. The matrix row must say `door: authenticated`.
#
#     The door's job on these surfaces is ATTRIBUTION, not refusal: Hydra
#     records one consent grant per (person, client), and that grant is what
#     microscope's hydra-consents adapter reads to answer "who reached this".
#     A surface with no door emits no grant and no session, so it is invisible
#     to that machinery however much of it is built. ---
OAUTH2_PROXY_EMAIL_DOMAINS=*
{% endif %}

# --- Cookie / session ---
OAUTH2_PROXY_COOKIE_SECRET={{ oauth2_proxy_surface_cookie_secret }}
# Locked to this surface's own FQDN so a stolen cookie cannot be replayed
# against kratos, hydra or a sibling console on a neighbouring subdomain. The
# cost is one silent redirect round-trip per surface: Kratos holds the SSO
# session, so the second surface a person opens re-authenticates without ever
# showing them a password prompt.
OAUTH2_PROXY_COOKIE_DOMAINS={{ oauth2_proxy_surface_hostname }}
OAUTH2_PROXY_COOKIE_SECURE=true
OAUTH2_PROXY_COOKIE_HTTPONLY=true
OAUTH2_PROXY_COOKIE_SAMESITE=lax
OAUTH2_PROXY_COOKIE_EXPIRE={{ oauth2_proxy_surface_cookie_expire }}

# --- Listener / routing ---
OAUTH2_PROXY_HTTP_ADDRESS=0.0.0.0:4180
OAUTH2_PROXY_REVERSE_PROXY=true
OAUTH2_PROXY_WHITELIST_DOMAINS={{ oauth2_proxy_surface_hostname }}
OAUTH2_PROXY_REDIRECT_URL={{ oauth2_proxy_surface_oidc_redirect_uri }}

# --- Upstream ---
OAUTH2_PROXY_UPSTREAMS=http://{{ oauth2_proxy_surface_upstream_host }}:{{ oauth2_proxy_surface_upstream_port }}

# --- Identity headers downstream ---
# PASS_USER_HEADERS sets X-Forwarded-* on the upstream request from the
# validated session. oauth2-proxy STRIPS that family from client input, which
# is what makes it the unforgeable one an app may trust.
# SET_XAUTHREQUEST populates X-Auth-Request-* on the /oauth2/auth RESPONSE for
# nginx-style consumers; those are NOT stripped from client input in
# reverse-proxy mode, so no app may read them for an authorization decision.
OAUTH2_PROXY_PASS_USER_HEADERS=true
OAUTH2_PROXY_SET_XAUTHREQUEST=true
OAUTH2_PROXY_SET_AUTHORIZATION_HEADER=false

# --- Skip the provider-button page; jump straight to Hydra. ---
OAUTH2_PROXY_SKIP_PROVIDER_BUTTON=true

# --- Logging ---
# REQUEST_LOGGING is what carries per-request identity, and it is the source
# the visit-history capture reads. AUTH_LOGGING records the login events.
OAUTH2_PROXY_REQUEST_LOGGING=true
OAUTH2_PROXY_AUTH_LOGGING=true
OAUTH2_PROXY_STANDARD_LOGGING=true

# The request log is a CONTRACT, not a convenience, because goat-surface-visit
# parses it into SurfaceVisitV1. The stock format is positional
# (`<ip> - <req-id> - <user> [<ts>] <host> <method> <upstream> "<path>" ...`),
# which is ambiguous the moment a field is empty — an unauthenticated request
# renders `- -` and the user field is only findable by counting separators —
# and upstream is free to reorder it in a minor release without anything here
# failing loudly. Pinning an explicit JSON format makes the parse total and the
# breakage visible: a field that disappears becomes a missing key, not a
# silently shifted column.
#
# oauth2-proxy RENDERS .RequestURI AND .UserAgent ALREADY QUOTED. Wrapping them
# in quotes here produces `"path":""/""` — invalid JSON, so every line parses as
# garbage and the emitter reports zero visits while the door logs normally.
# Caught on the live log 2026-09-05; .Timestamp and .Host are NOT pre-quoted and
# do need their own.
# {{ '{{' }}.Username{{ '}}' }} is the session identity oauth2-proxy validated, not a
# client-supplied header. It is empty (rendered "-") for anything that reached
# an api_route or a skip_auth_route, which is exactly the traffic that must not
# count as a visit.
{% if oauth2_proxy_surface_request_log_file | length > 0 %}
# Request lines go to a FILE so the visit emitter can read this one door's log
# without being given Docker's container-log directory (root:root 0710, and
# every container's output). Startup and config failures still reach stderr and
# therefore `docker logs`, because they happen before this file is opened.
OAUTH2_PROXY_LOGGING_FILENAME={{ oauth2_proxy_surface_request_log_file }}
{% endif %}
OAUTH2_PROXY_REQUEST_LOGGING_FORMAT={"ts":"{{ '{{' }}.Timestamp{{ '}}' }}","user":"{{ '{{' }}.Username{{ '}}' }}","host":"{{ '{{' }}.Host{{ '}}' }}","method":"{{ '{{' }}.RequestMethod{{ '}}' }}","path":{{ '{{' }}.RequestURI{{ '}}' }},"status":{{ '{{' }}.StatusCode{{ '}}' }},"dur":{{ '{{' }}.RequestDuration{{ '}}' }},"client":"{{ '{{' }}.Client{{ '}}' }}"}

# Parallel login flows (a page and its favicon racing through /oauth2/start)
# each mint a CSRF cookie; without per-request cookies the later flow
# overwrites the earlier one's and the first callback 403s with "CSRF token
# mismatch, potential attack" even though authentication succeeded.
OAUTH2_PROXY_COOKIE_CSRF_PER_REQUEST=true
OAUTH2_PROXY_COOKIE_CSRF_EXPIRE=15m

{% if oauth2_proxy_surface_api_routes | length > 0 %}
# API_ROUTES — the other half of per-request CSRF. A match returns 401
# instead of starting an OIDC flow, so a polling XHR, an SSE reconnect or a
# dropped websocket fails the way an XHR should and mints nothing. Interactive
# navigation still redirects to login normally.
OAUTH2_PROXY_API_ROUTES={{ oauth2_proxy_surface_api_routes }}
{% endif %}
{% if oauth2_proxy_surface_skip_auth_routes | length > 0 %}
# SKIP_AUTH_ROUTES — unauthenticated passthrough for machine callers. A prober
# has no cookie jar and no way to log in, so gating it buys nothing and makes
# every probe a guaranteed login-initiation. The Prometheus `blackbox-https`
# job reaches the health path through this front door, so a fenced health
# endpoint without this line turns a healthy service red.
OAUTH2_PROXY_SKIP_AUTH_ROUTES={{ oauth2_proxy_surface_skip_auth_routes }}
{% endif %}

{% if oauth2_proxy_surface_session_cookie_minimal | bool %}
# SESSION_COOKIE_MINIMAL — F-310. Without it the whole session (id_token +
# access_token + refresh_token) goes in the cookie, the browser drops it for
# size, and the session evaporates ~86 s into an 8 h expiry. The proxy logs no
# warning: it warns when it SPLITS a cookie, never when the browser then
# declines to keep it, so the failure is invisible server-side. `minimal` keeps
# email, user and groups. COOKIE_REFRESH is deliberately absent — it is
# mutually exclusive with minimal, because a refresh needs the refresh token
# minimal does not keep.
OAUTH2_PROXY_SESSION_COOKIE_MINIMAL=true
{% endif %}
