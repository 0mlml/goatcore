#!/bin/bash
# pubsub-state-mirror.sh — fetch a fresh state snapshot from the local
# portal, push it to the per-site Forgejo repo if any content changed,
# and shadow-write the same tarball to MinIO for cold-start recovery.
#
# Generated by ops/ansible/roles/pubsub-state-repo. Do not edit on host —
# changes will be overwritten on the next ansible apply.
#
# Block 86 (docs/design/pubsub-state-as-code.md). Exit codes:
#   0 — success (committed OR up-to-date)
#   1 — fatal error (portal unreachable, git push failed, etc.)

set -euo pipefail

PORTAL_URL='{{ pubsub_state_portal_url }}'
PORTAL_API_KEY='{{ pubsub_state_portal_api_key }}'
FORGEJO_URL='{{ pubsub_state_forgejo_url }}'
FORGEJO_TOKEN='{{ pubsub_state_forgejo_token }}'
FORGEJO_USER='{{ pubsub_state_forgejo_user }}'
ORG='{{ pubsub_state_org }}'
REPO='{{ pubsub_state_repo }}'
WORKDIR='{{ pubsub_state_workdir }}'
MINIO_ALIAS='{{ pubsub_state_minio_alias }}'
MINIO_BUCKET='{{ pubsub_state_minio_bucket }}'
GIT_AUTHOR_NAME='{{ pubsub_state_git_author_name }}'
GIT_AUTHOR_EMAIL='{{ pubsub_state_git_author_email }}'
PORTAL_CONTAINER='{{ pubsub_state_portal_container }}'
PORTAL_PORT='{{ pubsub_state_portal_port }}'

cd "$WORKDIR"
TS="$(date -u +%Y%m%dT%H%M%SZ)"

# 0. Portal-by-container resolve (opt-in). When PORTAL_CONTAINER is set the
# portal's 8090 is not host-published; resolve its docker-network IP fresh on
# every cycle so a portal redeploy (new container IP) does not strand us.
if [ -n "$PORTAL_CONTAINER" ]; then
  PIP=$(docker inspect "$PORTAL_CONTAINER" \
    -f '{% raw %}{{ (index .NetworkSettings.Networks "{% endraw %}{{ pubsub_state_portal_network }}{% raw %}").IPAddress }}{% endraw %}' 2>/dev/null || true)
  if [ -z "$PIP" ]; then
    echo "ERROR: could not resolve $PORTAL_CONTAINER on network {{ pubsub_state_portal_network }}" >&2
    exit 1
  fi
  PORTAL_URL="http://$PIP:$PORTAL_PORT"
fi

# 1. Fetch tarball from portal snapshot endpoint.
TARBALL="$WORKDIR/snapshot-$TS.tar.gz"
HTTP_CODE=$(curl -sS -o "$TARBALL" -w '%{http_code}' \
  -H "Authorization: Bearer $PORTAL_API_KEY" \
  -D "$WORKDIR/headers-$TS.txt" \
  "$PORTAL_URL/api/admin/snapshot")
if [ "$HTTP_CODE" != "200" ]; then
  echo "ERROR: portal snapshot returned HTTP $HTTP_CODE" >&2
  rm -f "$TARBALL"
  exit 1
fi
CONTENT_HASH=$(grep -i '^X-Pubsub-Content-Sha256:' "$WORKDIR/headers-$TS.txt" | awk '{print $2}' | tr -d '\r\n')
rm -f "$WORKDIR/headers-$TS.txt"

# 2. MinIO shadow write (best-effort; do not fail the mirror on MinIO error).
if [ -n "$MINIO_ALIAS" ] && [ -n "$MINIO_BUCKET" ] && command -v mc >/dev/null 2>&1; then
  if mc cp "$TARBALL" "$MINIO_ALIAS/$MINIO_BUCKET/snapshot-$TS.tar.gz" 2>/dev/null; then
    mc cp "$TARBALL" "$MINIO_ALIAS/$MINIO_BUCKET/latest.tar.gz" 2>/dev/null || true
  else
    echo "WARN: MinIO push failed (alias=$MINIO_ALIAS bucket=$MINIO_BUCKET); continuing" >&2
  fi
fi

# 3. Forgejo path: clone-or-pull, replace contents from tarball, commit if drift.
# Preserve the scheme from FORGEJO_URL (mesh-internal Forgejo serves plain http
# on 3030) — do NOT force https, or git hits gnutls_handshake against an http port.
FORGEJO_SCHEME="${FORGEJO_URL%%://*}"
FORGEJO_HOSTPART="${FORGEJO_URL#*://}"
CLONE_URL="${FORGEJO_SCHEME}://${FORGEJO_USER}:${FORGEJO_TOKEN}@${FORGEJO_HOSTPART}/$ORG/$REPO.git"
GIT_DIR="$WORKDIR/repo"
if [ ! -d "$GIT_DIR/.git" ]; then
  rm -rf "$GIT_DIR"
  git clone --depth=1 "$CLONE_URL" "$GIT_DIR"
fi
cd "$GIT_DIR"
git config user.name "$GIT_AUTHOR_NAME"
git config user.email "$GIT_AUTHOR_EMAIL"
git fetch --depth=1 origin main || true
git reset --hard origin/main 2>/dev/null || true

# Replace tree contents in full — the export's "current-state-only"
# invariant means we wipe and re-extract on every cycle.
find . -mindepth 1 -maxdepth 1 \
  ! -name '.git' \
  -exec rm -rf {} +
tar xzf "$TARBALL" --strip-components=1

# Commit + push when there's drift.
git add -A
if git diff --cached --quiet; then
  echo "up-to-date; nothing to commit ($CONTENT_HASH)"
  rm -f "$TARBALL"
  exit 0
fi
git commit -m "mirror: pubsub state @ $TS

content_sha256: $CONTENT_HASH
generated_by: pubsub-state-mirror.sh
"
git push origin main
echo "committed @ $TS ($CONTENT_HASH)"

# Trim old local tarballs (keep last 10).
ls -1t "$WORKDIR"/snapshot-*.tar.gz 2>/dev/null | tail -n +11 | xargs -r rm -f
rm -f "$TARBALL"
exit 0
