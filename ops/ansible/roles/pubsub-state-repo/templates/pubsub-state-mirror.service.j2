[Unit]
Description=Mirror goat-zenoh-portal state to per-site Forgejo + MinIO snapshot (Block 86)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/pubsub-state-mirror.sh
# Best-effort: a single-cycle failure shouldn't block the next timer fire.
Restart=no
TimeoutStartSec=120
# State + tarballs land here; keep it dedicated.
StateDirectory=pubsub-state-mirror
