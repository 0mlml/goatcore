# {{ ansible_managed }}
# One-shot body of spire-trust-sync.timer — see spire-trust-sync.sh for what
# the two self-heal arms do.
[Unit]
Description=Sync SPIRE CA into the zenoh router trust bundle + rescue a join-token-dead agent
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/spire-trust-sync.sh
