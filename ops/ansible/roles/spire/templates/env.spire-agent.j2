# {{ ansible_managed }}
# Overlay env for docker-compose.spire-agent.yml (ADR 0412 Phase B, agent-only).
# Loaded via `--env-file .env.spire-agent` alongside the mgmt-host .env.
# mode 0600 — it can carry a live join token.
#
# NO SPIRE_SERVER_IMAGE and NO SPIRE_DB_PASSWORD, deliberately: this node runs
# no server and owns no logical database. If either ever appears here, someone
# has pointed the co-located overlay at an agent-only host.
SPIRE_AGENT_IMAGE={{ spire_agent_image | default('') }}
SPIRE_JOIN_TOKEN={{ spire_join_token | default('') }}
