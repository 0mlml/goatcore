# {{ ansible_managed }}
# Overlay env for docker-compose.spire.yml. Loaded via
# `--env-file .env.spire` alongside the mgmt-host .env. mode 0600.
SPIRE_SERVER_IMAGE={{ spire_server_image | default('') }}
SPIRE_AGENT_IMAGE={{ spire_agent_image | default('') }}
SPIRE_DB_PASSWORD={{ spire_db_password }}
SPIRE_JOIN_TOKEN={{ spire_join_token | default('') }}
# Where the server's attestation port is published. Loopback unless this
# goatnet has an agent-only node; see roles/spire/defaults.
SPIRE_SERVER_BIND={{ spire_server_bind_address }}
SPIRE_SERVER_HOST_PORT={{ spire_server_host_port }}
