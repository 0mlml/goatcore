# docker-compose.yml — rendered by ops/ansible/roles/goat-public-mtls-crutch
# Block 80 / ADR 0843 — Public mTLS-gated crutch tier.

services:
  traefik:
    image: "{{ crutch_traefik_image }}"
    container_name: goat-public-mtls-crutch-traefik
    restart: unless-stopped
    network_mode: host
    command:
      - --configFile=/etc/traefik/static.yml
    volumes:
      - ./traefik/static.yml:/etc/traefik/static.yml:ro
      - ./traefik/dynamic.yml:/etc/traefik/dynamic.yml:ro
      - ./traefik/offline-ca-root.pem:{{ crutch_offline_ca_root_path_host }}:ro
{% if crutch_offline_ca_intermediate_path_local | default('', true) | length > 0 %}
      - ./traefik/offline-ca-intermediate.pem:{{ crutch_offline_ca_intermediate_path_host }}:ro
{% endif %}
      - ./traefik/crl.pem:{{ crutch_crl_path_host }}:ro
      - {{ crutch_server_cert_path | dirname }}:{{ crutch_server_cert_path | dirname }}:ro
      - ./traefik/log:/var/log/traefik
    healthcheck:
      test:
        - CMD
        - traefik
        - healthcheck
        - --ping
      interval: 30s
      timeout: 5s
      retries: 3
