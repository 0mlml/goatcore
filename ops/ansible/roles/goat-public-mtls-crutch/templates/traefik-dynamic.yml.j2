## Traefik dynamic config — rendered by ops/ansible/roles/goat-public-mtls-crutch
## Source-of-truth: ops/ansible/roles/goat-public-mtls-crutch/templates/traefik-dynamic.yml.j2
## Block 80 / ADR 0843 — Public mTLS-gated crutch tier (design §5).
##
## DO NOT EDIT THIS FILE ON THE HOST — overwritten on next Ansible run.
##
## Per-route map per design §4:
##   mgmt-router   Host(`{{ crutch_mgmt_host }}`)   → {{ crutch_inner_mgmt_backend }}
##   signal-router Host(`{{ crutch_signal_host }}`) → {{ crutch_inner_signal_backend }}
##   relay-router  Host(`{{ crutch_relay_host }}`)  → {{ crutch_inner_relay_backend }}

tls:
  options:
    crutch-mtls:
      ## Hard gate, NOT VerifyClientCertIfGiven (per design §5 + ADR 0843
      ## risk row "mTLS strict-required is a hard gate, not defense-in-depth").
      ## The post-deploy self-test asserts a no-cert handshake fails at the
      ## TLS layer; CI catches config drift that would degrade this.
      clientAuth:
        clientAuthType: RequireAndVerifyClientCert
        caFiles:
          - {{ crutch_offline_ca_root_path_host }}
{% if crutch_offline_ca_intermediate_path_local | default('', true) | length > 0 %}
          ## Intermediate-CA also trusted as an anchor. Required because the
          ## current root carries BasicConstraints pathlen:0; chains
          ## `leaf -> intermediate -> root` would otherwise trip Go's
          ## path-length verifier on every inbound client cert.
          - {{ crutch_offline_ca_intermediate_path_host }}
{% endif %}
      minVersion: VersionTLS13
      cipherSuites:
        - TLS_AES_256_GCM_SHA384
        - TLS_CHACHA20_POLY1305_SHA256
  certificates:
    - certFile: {{ crutch_server_cert_path }}
      keyFile: {{ crutch_server_key_path }}

http:
  middlewares:
    extract-client-cn:
      ## Forwards verified client-cert info to the upstream so it can correlate
      ## audit-log entries to the originating device. Uses Traefik's built-in
      ## passTLSClientCert middleware (the real per-request primitive). An
      ## earlier shape attempted customRequestHeaders with a Go-template
      ## interpolation of the client cert CN — Traefik v3's file provider does
      ## NOT template customRequestHeaders at request time, so the whole
      ## dynamic config silently failed to load with "can't evaluate field
      ## ClientCertificate in type bool" and Traefik degraded to the default
      ## self-signed cert + catch-all router. passTLSClientCert sets the
      ## standard X-Forwarded-Tls-Client-Cert-Info header with the requested
      ## subject fields; upstreams that want a stable device-id key can read
      ## the CN out of it.
      passTLSClientCert:
        info:
          subject:
            commonName: true
            organization: true
            organizationalUnit: true
          serialNumber: true
          notAfter: true
    strip-inbound-goat-device-id:
      ## Refuses inbound spoofing of the device-id family of headers. The
      ## passTLSClientCert middleware above is the only legitimate source.
      headers:
        customRequestHeaders:
          X-Goat-Device-Id: ""
          X-Forwarded-Tls-Client-Cert-Info: ""

  routers:
    mgmt-router:
      rule: "Host(`{{ crutch_mgmt_host }}`)"
      entryPoints:
        - websecure
      service: mgmt-backend
      tls:
        options: crutch-mtls
      middlewares:
        - strip-inbound-goat-device-id
        - extract-client-cn

    signal-router:
      rule: "Host(`{{ crutch_signal_host }}`)"
      entryPoints:
        - websecure
      service: signal-backend
      tls:
        options: crutch-mtls
      middlewares:
        - strip-inbound-goat-device-id
        - extract-client-cn

    relay-router:
      rule: "Host(`{{ crutch_relay_host }}`)"
      entryPoints:
        - websecure
      service: relay-backend
      tls:
        options: crutch-mtls
      middlewares:
        - strip-inbound-goat-device-id
        - extract-client-cn

  services:
    mgmt-backend:
      loadBalancer:
        servers:
          - url: "{{ crutch_inner_mgmt_backend }}"
    signal-backend:
      loadBalancer:
        servers:
          - url: "{{ crutch_inner_signal_backend }}"
    relay-backend:
      loadBalancer:
        servers:
          - url: "{{ crutch_inner_relay_backend }}"
