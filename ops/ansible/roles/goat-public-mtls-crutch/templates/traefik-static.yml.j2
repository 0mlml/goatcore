## Traefik static config — rendered by ops/ansible/roles/goat-public-mtls-crutch
## Source-of-truth: ops/ansible/roles/goat-public-mtls-crutch/templates/traefik-static.yml.j2
## Block 80 / ADR 0843 — Public mTLS-gated crutch tier (design §5).
##
## DO NOT EDIT THIS FILE ON THE HOST — overwritten on next Ansible run.

entryPoints:
  websecure:
    address: ":443"

providers:
  file:
    filename: /etc/traefik/dynamic.yml
    watch: true

api:
  insecure: false
  dashboard: false

log:
  level: INFO

accessLog:
  filePath: /var/log/traefik/access.log
  filters:
    statusCodes:
      - "400-599"
  fields:
    headers:
      defaultMode: drop
      names:
        # X-Goat-Device-Id is set by the gate from the verified client-cert
        # CN — keep it in access logs for audit-log correlation.
        X-Goat-Device-Id: keep
