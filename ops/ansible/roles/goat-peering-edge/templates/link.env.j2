# {{ ansible_managed }}
# Interface parameters for the {{ peering_edge_name }} peering link.
# Contains no secret: addresses, an MTU and a local interface id.
LINK_IFNAME={{ peering_edge_link_ifname }}
LINK_IF_ID={{ peering_edge_xfrm_if_id }}
LINK_UNDERLAY_DEV={{ peering_edge_link_underlay_dev }}
LINK_ADDR={{ peering_edge_local_link_ip }}
LINK_PREFIX_LEN={{ peering_edge_link_prefix_len }}
LINK_MTU={{ peering_edge_mtu }}
LINK_CLAMP_MSS={{ 1 if peering_edge_clamp_mss | bool else 0 }}
