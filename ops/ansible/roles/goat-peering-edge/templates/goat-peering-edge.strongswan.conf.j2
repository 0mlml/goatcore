# {{ ansible_managed }}
#
# strongswan.d drop-in for the cross-sovereign peering edge.

charon {
    # Route-based: the xfrm interface owns the link subnet route. Letting
    # charon install its own routes puts a second writer on the main table.
    install_routes = no
    install_virtual_ip = no

    # The peering identity is a DNS-shaped name (fed.<issuer>.<counterparty>.
    # <ordinal>) matched as a whole string by the far side. Never accept an
    # identity we did not agree to.
    follow_redirects = no
    accept_unencrypted_mainmode_messages = no
}
