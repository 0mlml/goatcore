# {{ ansible_managed }}
[Unit]
Description=Cross-sovereign peering link interface (%i)
Documentation=file:///etc/goat-peering-edge/%i.link.env
After=network-online.target
Wants=network-online.target
# The CHILD_SA binds to this interface by if_id, so it must exist first.
Before={{ peering_edge_service }}

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/goat-peering-edge/%i.link.env
ExecStart=/usr/local/sbin/goat-peering-link up
ExecStop=/usr/local/sbin/goat-peering-link down

[Install]
WantedBy=multi-user.target
