# snitch-probe environment — managed by ansible role snitch-bundle.
# Block 61 / offline-enrollment §11.6a. Mode 0600 because SNITCH_PROBE_KEY
# is the device's authenticated channel to the snitch collector.
#
# SNITCH_PROBE_KEY wire format: "snitch_" + hex(raw_32_bytes_from_bundle).
# bundle-create stores the 32 random bytes; bundle-extract --hex emits
# them as 64 hex chars; this template prepends the literal "snitch_"
# prefix so the bearer matches the SHA-256 digest the collector's auth
# layer computed at registration. If snitch_probe_key_resolved was
# supplied via inventory and ALREADY carries the snitch_ prefix
# (legacy / ad-hoc path), the operator should pass the raw hex without
# the prefix; the template is the single source of prefixing.
SNITCH_COLLECTOR={{ snitch_collector_url }}
SNITCH_INTERVAL={{ snitch_probe_interval }}
SNITCH_CYCLE_BUDGET={{ snitch_probe_cycle_budget }}
SNITCH_PROBE_KEY=snitch_{{ snitch_probe_key_resolved }}
{% if snitch_relay_urls | length > 0 %}
SNITCH_RELAY_URLS={{ snitch_relay_urls }}
{% endif %}
{% if snitch_probe_disabled | length > 0 %}
# Local kill switch — non-empty value forces PolicyOff regardless of
# the fleet policy from the collector. Block 61 do-no-harm escape valve.
# To re-enable: clear this var via `ansible -e snitch_probe_disabled=""`
# OR remove the line + `systemctl restart snitch-probe`.
SNITCH_PROBE_DISABLED={{ snitch_probe_disabled }}
{% endif %}
