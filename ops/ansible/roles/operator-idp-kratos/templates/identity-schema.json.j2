{
  "$id": "https://schemas.ory.sh/operator-idp/identity.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Operator identity (per ADR 0842 — site-local; obs/utility consumers; per-service authorization via groups[])",
  "type": "object",
  "properties": {
    "traits": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "title": "Operator email",
          "ory.sh/kratos": {
            "credentials": {
              "webauthn": {
                "identifier": true
              }
            },
            "verification": {
              "via": "email"
            },
            "recovery": {
              "via": "email"
            }
          },
          "maxLength": 320
        },
        "name": {
          "type": "string",
          "title": "Operator display name",
          "maxLength": 256
        },
        "groups": {
          "type": "array",
          "title": "Operator authorization groups",
          "description": "Each operator carries an array of group memberships. Group strings are surfaced in the JWT `groups` claim; each consumer maps the strings it cares about to its internal authorization. Special groups: `obs-admin` grants admin on every observability consumer; `obs-readonly` grants read-only on every observability consumer. Service-specific groups (`<service>-admin`, `<service>-readonly`) scope access to one consumer. Multiple groups compose by union.",
          "items": {
            "type": "string",
            "enum": [
              "obs-admin",
              "obs-readonly",
              "grafana-admin",
              "grafana-readonly",
              "minio-admin",
              "minio-readonly",
              "openobserve-admin",
              "openobserve-readonly",
              "forgejo-admin",
              "forgejo-user",
              "prometheus-readonly",
              "alertmanager-admin",
              "ollama-user"
            ]
          },
          "uniqueItems": true,
          "minItems": 1
        }
      },
      "required": ["email", "name", "groups"],
      "additionalProperties": false
    }
  }
}
