# systemd drop-in for mgmt-host-compose-watch.service.
# Rendered by the role from `mgmt_host_compose_watch_services` (defaults
# to empty = preserve all-services revival behavior). Per-site
# group_vars override sets the allowlist when migration-style services
# are in the compose stack (e.g. kratos-migrate / hydra-migrate post-Ory).
#
# Empty value is safe — the watcher script's `[ -n "$WATCH_SERVICES" ]`
# guard reverts to "revive everything" when the env var is unset OR empty.
[Service]
Environment="MGMT_HOST_COMPOSE_WATCH_SERVICES={{ mgmt_host_compose_watch_services }}"
# F-335: the script already honoured MGMT_HOST_COMPOSE_WATCH_METRICS_DIR, but
# nothing ever set it, so the metric always landed at the script's built-in
# default. On the zagros mgmt host node_exporter reads a DIFFERENT directory, so
# compose_service_running has never reached Prometheus — and
# monitoring/rules/compose-orphans.yml alerts on it, which makes that alert
# unable to fire and indistinguishable from one finding nothing wrong.
Environment="MGMT_HOST_COMPOSE_WATCH_METRICS_DIR={{ mgmt_host_compose_watch_metrics_dir }}"
