# Rendered by ops/ansible/roles/deadman-watch — do not edit on the host.
[Unit]
Description=Run the dead-man's switch staleness check every {{ deadman_watch_check_interval }}
Documentation=file://{{ deadman_watch_install_dir }}/deadman-check.sh

[Timer]
# Starts shortly after boot rather than waiting a full interval: a reboot is
# exactly when the pipeline is most likely to be broken.
OnBootSec=2min
OnUnitActiveSec={{ deadman_watch_check_interval }}
AccuracySec=10s
Persistent=true

[Install]
WantedBy=timers.target
