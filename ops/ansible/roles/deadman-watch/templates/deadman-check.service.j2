# Rendered by ops/ansible/roles/deadman-watch — do not edit on the host.
[Unit]
Description=Dead-man's switch staleness check
Documentation=file://{{ deadman_watch_install_dir }}/deadman-check.sh
After=network-online.target

[Service]
Type=oneshot
Environment=DEADMAN_STATE_FILE={{ deadman_watch_state_dir }}/last-heartbeat
Environment=DEADMAN_THRESHOLD_SECONDS={{ deadman_watch_threshold_seconds }}
Environment=DEADMAN_ROUTING_KEY={{ deadman_watch_routing_key }}
Environment=DEADMAN_EVENTS_URL={{ deadman_watch_events_url }}
Environment=DEADMAN_SOURCE={{ inventory_hostname }}
Environment="DEADMAN_EXPECTED_SOURCES={{ deadman_watch_expected_sources | join(' ') }}"
ExecStart=/bin/bash {{ deadman_watch_install_dir }}/deadman-check.sh
