# Rendered by ops/ansible/roles/deadman-watch — do not edit on the host.
[Unit]
Description=Dead-man's switch heartbeat receiver
Documentation=file://{{ deadman_watch_install_dir }}/deadman-receive.py
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ deadman_watch_user }}
Group={{ deadman_watch_user }}
Environment=DEADMAN_STATE_FILE={{ deadman_watch_state_dir }}/last-heartbeat
Environment=DEADMAN_LISTEN_ADDR={{ deadman_watch_listen_addr }}
Environment=DEADMAN_LISTEN_PORT={{ deadman_watch_listen_port }}
Environment=DEADMAN_TOKEN={{ deadman_watch_token }}
ExecStart=/usr/bin/python3 {{ deadman_watch_install_dir }}/deadman-receive.py
Restart=always
RestartSec=5
# Hardening: this listens on the network and needs almost nothing.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ deadman_watch_state_dir }}

[Install]
WantedBy=multi-user.target
