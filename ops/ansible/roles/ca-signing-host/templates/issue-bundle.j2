#!/bin/bash
# issue-bundle — wrapper for bundle-create that wires up the fixed flags
# (CA blob path, age identity = stdin, CA ID, root cert, relays file,
# allowlist path) so operators only have to pass the per-bundle args.
#
# Operator usage from their laptop:
#
#   ssh orin-c.vega issue-bundle \
#     --site vega \
#     --device-id mgmt-foo-orin \
#     --wg-cp0-address 198.18.0.20/24 \
#     --acl-groups VEGA,VEGA-MGMT \
#     --out /tmp/foo.bundle.cbor \
#     < ~/.config/age/keys.txt
#
# The age identity flows from the operator's laptop file → SSH stdin →
# this script's stdin → bundle-create's --age-identity /dev/stdin →
# age.ParseIdentities. Never lands on Orin-C disk.
#
# Generated by ops/ansible/roles/ca-signing-host. Do not hand-edit.

set -euo pipefail

GOAT_CA_DIR="{{ ca_signing_host_workdir }}"
BIN="{{ ca_signing_host_bindir }}/bundle-create"

if [ ! -t 0 ] && [ -p /dev/stdin -o -f /dev/stdin -o -c /dev/stdin ]; then
    : # stdin is a pipe / file / char device — good
elif [ -t 0 ]; then
    echo "issue-bundle: refusing to run with terminal stdin." >&2
    echo "  Pipe your age identity in, e.g.:" >&2
    echo "    ssh orin-c.vega issue-bundle ... < ~/.config/age/keys.txt" >&2
    exit 64
fi

CA_ID=$(cat "${GOAT_CA_DIR}/ca-id")

exec "${BIN}" \
    --ca-key "${GOAT_CA_DIR}/ca.key.age" \
    --age-identity /dev/stdin \
    --ca-id "${CA_ID}" \
    --tls-trust-anchor "${GOAT_CA_DIR}/root-cert.pem" \
    --wg-cp0-relays "${GOAT_CA_DIR}/wg-cp0-relays.json" \
    --update-allowlist "${GOAT_CA_DIR}/repo/{{ ca_signing_host_allowlist_relpath }}" \
    "$@"
