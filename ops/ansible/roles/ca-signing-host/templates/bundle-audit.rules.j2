# auditd rules for the dev-CA signing host (Block 22M interim).
# Records every execve of the load-bearing binaries so the audit log answers
# "who ran what, when" for the duration of the interim mode.
#
# Generated by ops/ansible/roles/ca-signing-host. Do not hand-edit.

# Bundle-create itself — direct invocation (uncommon; operators normally use
# the issue-bundle wrapper but a power user might call bundle-create directly).
-a always,exit -F arch=b64 -S execve -F path={{ ca_signing_host_bindir }}/bundle-create -k bundle_create

# Bundle-extract — used to inspect bundles after issuance.
-a always,exit -F arch=b64 -S execve -F path={{ ca_signing_host_bindir }}/bundle-extract -k bundle_extract

# Issue-bundle wrapper — the primary operator entrypoint.
-a always,exit -F arch=b64 -S execve -F path={{ ca_signing_host_bindir }}/issue-bundle -k issue_bundle
