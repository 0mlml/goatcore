# {{ ansible_managed }}
[Unit]
Description=node-net-health bandwidth attribution sample (ADR 1128, --fast)
# Separate unit from the hourly snapshot ON PURPOSE. Bandwidth needs a minute
# cadence to be useful for capacity work; the security inventory needs an hour
# and writes a much heavier snapshot. One timer cannot serve both, and coupling
# them would mean either an hourly bandwidth chart or 60x the inventory cost.
# The two runs keep SEPARATE delta baselines (mesh-prev-fast.json vs
# mesh-prev.json) so neither one's interval depends on when the other last ran.

[Service]
Type=oneshot
Environment=NNH_STATE_DIR={{ node_net_health_state_dir }}
Environment=NNH_BASELINE={{ node_net_health_etc_dir }}/baseline.json
Environment=NNH_MESH_CIDRS={{ node_net_health_mesh_cidrs }}
Environment=NNH_INTERNAL_CIDRS={{ node_net_health_internal_cidrs }}
Environment=NNH_FABRIC_PORTS={{ node_net_health_fabric_ports }}
Environment=NNH_FABRIC_COMMS={{ node_net_health_fabric_comms }}
Environment=NNH_STALE_HANDSHAKE_S={{ node_net_health_stale_handshake_s }}
Environment=NNH_TEXTFILE={{ node_net_health_textfile_path }}
Environment=NNH_PEER_ATTRIBUTION={{ '1' if node_net_health_peer_attribution else '0' }}
ExecStart=/usr/bin/env python3 /usr/local/bin/nnh-snapshot.py --fast
# `ss -i` on a busy host is the only real cost here; cap it so a pathological
# socket table can never starve the node it is measuring.
CPUQuota=25%
Nice=10
