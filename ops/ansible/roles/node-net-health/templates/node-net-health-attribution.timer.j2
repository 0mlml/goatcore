# {{ ansible_managed }}
[Unit]
Description=Bandwidth attribution sample for goat-net-attribution (ADR 1128)

[Timer]
OnBootSec={{ node_net_health_attribution_boot_delay_s }}s
OnUnitActiveSec={{ node_net_health_attribution_interval_s }}s
# NO RandomizedDelaySec. The hourly snapshot randomises to spread fleet load,
# but this one's output is a RATE: the sample gap is the denominator, and
# jittering it makes every derived bytes/s slightly wrong for no benefit. The
# real gap is carried in goat_net_attribution_sample_gap_seconds either way.
AccuracySec=5s

[Install]
WantedBy=timers.target
