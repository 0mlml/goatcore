# {{ ansible_managed }}
[Unit]
Description=Hourly connection snapshot for goat-node-net-health (node-net-health.md)

[Timer]
OnBootSec={{ node_net_health_snapshot_boot_delay_s }}s
OnUnitActiveSec={{ node_net_health_snapshot_interval_s }}s
RandomizedDelaySec=60s
AccuracySec=30s

[Install]
WantedBy=timers.target
