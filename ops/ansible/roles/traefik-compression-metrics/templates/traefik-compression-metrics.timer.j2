# {{ ansible_managed }}
[Unit]
Description=Run the Traefik compression metrics exporter every {{ traefik_compression_metrics_interval }}

[Timer]
OnBootSec=3min
OnUnitActiveSec={{ traefik_compression_metrics_interval }}
# Spread across hosts so two Orins do not both shell out to `docker logs` on
# the same second.
RandomizedDelaySec=30
AccuracySec=15s
Persistent=false

[Install]
WantedBy=timers.target
