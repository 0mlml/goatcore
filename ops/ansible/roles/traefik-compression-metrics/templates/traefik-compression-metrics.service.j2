# {{ ansible_managed }}
[Unit]
Description=Publish Traefik response-compression metrics from the access log
Documentation=https://github.com/usareur-af/goatcore/blob/main/docs/design/surface-overload-protection.md
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
# Reads `docker logs` and writes into the node_exporter textfile dir; both need
# root on this fleet. The script itself opens no network socket.
User=root
ExecStart=/usr/local/sbin/traefik-compression-metrics.py \
  --container {{ traefik_compression_metrics_container }} \
  --window {{ traefik_compression_metrics_window_s }} \
  --max-bytes {{ traefik_compression_metrics_max_bytes }} \
  --out {{ traefik_compression_metrics_textfile_dir }}/{{ traefik_compression_metrics_prom_file }}
# A failed run publishes `_up 0` and carries prior counters forward, so a
# non-zero exit is information rather than something to retry into a storm.
TimeoutStartSec=120
Nice=10
IOSchedulingClass=idle
