# Rendered by ops/ansible/roles/operator-idp-postgres on {{ ansible_date_time.iso8601 }}
# Source: ops/ansible/roles/operator-idp-postgres/templates/docker-compose.yml.j2
# Anchor: ADR 0842 (dedicated operator IdP for observability + utility services).
#
# Operator-IdP Postgres — single-instance, NOT in postgres-spock cluster,
# NOT in pgBackRest stanza. Sealed unit on Orin-C; only Kratos + Hydra
# (also on Orin-C) connect.
#
# DO NOT EDIT THIS FILE ON THE HOST — it will be overwritten on next
# Ansible run. Edit the .j2 template + re-run the role.

services:
  postgres:
    image: {{ operator_idp_pg_image }}
    container_name: {{ operator_idp_pg_container_name }}
    restart: unless-stopped
    deploy:
      resources:
        limits: { cpus: "1.0", memory: 512M }
        reservations: { memory: 64M }
    env_file:
      # Sourced from .env rendered by the role; carries
      # POSTGRES_PASSWORD + OPERATOR_IDP_PG_APP_PASSWORD. Mode 0600 on
      # disk; only the docker daemon (root) reads it at container
      # start. Kept separate from compose env to avoid leaking through
      # `docker inspect` ps output.
      - .env
    environment:
      # Page checksums on — cheap CPU cost, catches on-disk corruption
      # at read time. Set via initdb args; only takes effect on a fresh
      # cluster (no-op on already-initialized data dir).
      POSTGRES_INITDB_ARGS: "--data-checksums"
      PGDATA: "/var/lib/postgresql/data/pgdata"
    volumes:
      - {{ operator_idp_data_root }}/pgdata:/var/lib/postgresql/data
      - {{ operator_idp_compose_dir }}/init:/docker-entrypoint-initdb.d:ro
    ports:
      # Bind to localhost only — Kratos + Hydra connect via the docker
      # bridge from the same host. Operator-IdP DB does NOT serve mesh
      # peers; this is the same isolation principle as the dump path.
      - "127.0.0.1:{{ operator_idp_pg_host_port }}:5432"
    networks:
      - operator-idp
    healthcheck:
      # postgres:16-alpine ships pg_isready. healthchecks roll up to
      # `docker compose ps` and to obs-host monitoring later.
      test: ["CMD", "pg_isready", "-U", "postgres"]
      interval: 10s
      timeout: 5s
      retries: 6

networks:
  operator-idp:
    name: operator-idp
    driver: bridge
