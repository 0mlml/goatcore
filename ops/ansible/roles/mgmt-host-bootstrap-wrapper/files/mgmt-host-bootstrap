#!/usr/bin/env bash
# /usr/local/bin/mgmt-host-bootstrap — operator wrapper for the sovereign
# netbird account/setup-key CLI. Installed by
# ops/ansible/roles/mgmt-host-bootstrap-wrapper/.
#
# Forwards args to the bootstrap-profile container in the mgmt-host compose
# stack. The container is ephemeral (--rm); each invocation is one shot.
#
# Examples:
#   mgmt-host-bootstrap create-account --owner person-85@example.org --site-name vega
#   mgmt-host-bootstrap create-setup-key --account acc_vega_<id> --role peer --ttl 2160h
#   mgmt-host-bootstrap list-peers --account acc_vega_<id>
#
# ADR 0410. Source: ops/mgmt-host-bootstrap/.

set -euo pipefail

COMPOSE_DIR=${MGMT_HOST_COMPOSE_DIR:-/opt/mgmt-host}

if [[ ! -f "$COMPOSE_DIR/docker-compose.yml" ]]; then
  echo "mgmt-host-bootstrap: $COMPOSE_DIR/docker-compose.yml not found." >&2
  echo "Set MGMT_HOST_COMPOSE_DIR=<path> if the stack lives elsewhere." >&2
  exit 1
fi

# `--profile bootstrap run --rm` brings up just this container, attaches
# stdio, runs the CLI, and removes it on exit. The .env file in the
# compose dir provides POSTGRES_SUPERUSER_PASSWORD; we don't need to
# duplicate it here.
exec docker compose -f "$COMPOSE_DIR/docker-compose.yml" --profile bootstrap \
  run --rm mgmt-host-bootstrap "$@"
