[Unit]
Description=Pull the pubsub-state warm standby checkout (Block 86 recovery side)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/pubsub-state-pull.sh
# The pull is best-effort: a Forgejo blip must not spam failure state. The next
# timer tick retries. A stale-but-present checkout still beats no checkout.
SuccessExitStatus=0 1
