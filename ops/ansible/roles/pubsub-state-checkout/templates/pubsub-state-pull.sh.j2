#!/bin/bash
# pubsub-state-pull.sh — keep a warm standby checkout of the per-site
# pubsub-state Forgejo repo current. Recovery side of Block 86
# (docs/design/pubsub-state-as-code.md).
#
# Generated by ops/ansible/roles/pubsub-state-checkout. Do not edit on host —
# overwritten on the next ansible apply.
#
# This script only PULLS. It never runs pubsub-apply (that mutates the portal
# and is a deliberate failover action — see RECOVERY.md next to the checkout).
#
# Exit codes: 0 — current (pulled or already up-to-date); 1 — fatal.

set -euo pipefail

FORGEJO_URL='{{ pubsub_state_checkout_forgejo_url }}'
TOKEN='{{ pubsub_state_checkout_token }}'
USER='{{ pubsub_state_checkout_user }}'
ORG='{{ pubsub_state_checkout_org }}'
REPO='{{ pubsub_state_checkout_repo }}'
DIR='{{ pubsub_state_checkout_dir }}'

REPO_DIR="$DIR/repo"
# Preserve the scheme from FORGEJO_URL (mesh-internal Forgejo serves plain http
# on 3030) — do NOT force https, or git hits gnutls_handshake against an http port.
FORGEJO_SCHEME="${FORGEJO_URL%%://*}"
FORGEJO_HOSTPART="${FORGEJO_URL#*://}"
CLONE_URL="${FORGEJO_SCHEME}://${USER}:${TOKEN}@${FORGEJO_HOSTPART}/$ORG/$REPO.git"

if [ ! -d "$REPO_DIR/.git" ]; then
  rm -rf "$REPO_DIR"
  git clone --depth=1 "$CLONE_URL" "$REPO_DIR"
else
  cd "$REPO_DIR"
  # Refresh the remote URL in case the token rotated.
  git remote set-url origin "$CLONE_URL"
  git fetch --depth=1 origin main
  git reset --hard origin/main
fi

echo "pulled @ $(date -u +%Y%m%dT%H%M%SZ) ($ORG/$REPO)"
exit 0
