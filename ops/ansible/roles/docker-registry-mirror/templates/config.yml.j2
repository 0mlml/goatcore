# Rendered by ops/ansible/roles/docker-registry-mirror on {{ ansible_date_time.iso8601 }}.
# Source: ops/ansible/roles/docker-registry-mirror/templates/config.yml.j2
#
# registry:2 config for upstream "{{ item.name }}" → {{ item.upstream }}.
# Pull-through cache mode: clients request blobs by digest; on miss the
# registry pulls from upstream, caches locally, and serves on subsequent
# requests.

version: 0.1
log:
  level: info
  formatter: json
storage:
  filesystem:
    rootdirectory: /var/lib/registry
{% if docker_registry_mirror_blob_ttl != "0s" %}
  delete:
    enabled: true
{% endif %}
{% if docker_registry_mirror_storage_read_only %}
  maintenance:
    readonly:
      enabled: true
{% endif %}
http:
  addr: :5000
  headers:
    X-Content-Type-Options: [nosniff]
  debug:
    addr: :5001
    prometheus:
      enabled: true
      path: /metrics
proxy:
  remoteurl: {{ item.upstream }}
  # Anonymous access — clients of the mirror authenticate (or not) with
  # the upstream via their own credentials passed through. The mirror
  # itself does not store upstream credentials.
