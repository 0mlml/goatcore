#!/usr/bin/env bash
# Rendered by ops/ansible/roles/docker-registry-mirror on {{ ansible_date_time.iso8601 }}.
#
# Run registry:2's garbage-collect against each upstream's storage.
# Drops blobs no longer referenced by any tag.

set -euo pipefail

{% for item in docker_registry_mirror_upstreams %}
echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] gc registry-{{ item.name }}"
docker exec registry-{{ item.name }} \
  /bin/registry garbage-collect /etc/docker/registry/config.yml || true
{% endfor %}
