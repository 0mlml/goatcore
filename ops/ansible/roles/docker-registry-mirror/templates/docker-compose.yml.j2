# Rendered by ops/ansible/roles/docker-registry-mirror on {{ ansible_date_time.iso8601 }}.
# DO NOT EDIT THIS FILE ON THE HOST — it will be overwritten on next
# Ansible run. Edit the .j2 template + re-run the role.

services:
{% for item in docker_registry_mirror_upstreams %}
  registry-{{ item.name }}:
    image: {{ docker_registry_mirror_image }}
    container_name: registry-{{ item.name }}
    restart: unless-stopped
    deploy:
      resources:
        limits: { cpus: "1.0", memory: 512M }
        reservations: { memory: 64M }
    volumes:
      - {{ docker_registry_mirror_compose_dir }}/config-{{ item.name }}.yml:/etc/docker/registry/config.yml:ro
      - {{ docker_registry_mirror_storage_root }}/{{ item.name }}:/var/lib/registry
    ports:
      - "{{ item.bind | default('0.0.0.0') }}:{{ item.host_port }}:5000"
    networks:
      - registry-mirror-net
    # The /v2/ endpoint never returns sensitive data; no auth needed
    # at the cache layer (clients re-auth at the upstream as needed).

{% endfor %}
networks:
  registry-mirror-net:
    name: {{ docker_registry_mirror_network }}
