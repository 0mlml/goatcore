# Managed by ansible (roles/zenoh-rest-tap). Do not edit on the host.
[Unit]
Description=Zenoh REST port connection tap (source address + timestamp)
After=docker.service

[Service]
ExecStart=/usr/local/sbin/zenoh-rest-tap.sh {{ zenoh_rest_tap_router_container }} {{ zenoh_rest_tap_port }} {{ zenoh_rest_tap_log }}
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
