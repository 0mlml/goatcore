# Managed by ansible (roles/zenoh-rest-tap). Do not edit on the host.
{{ zenoh_rest_tap_log }} {
    # /var/log is group-writable by syslog; logrotate refuses it without su.
    su root syslog
    daily
    rotate {{ zenoh_rest_tap_rotate_days }}
    compress
    missingok
    notifempty
    maxsize {{ zenoh_rest_tap_max_size }}
    copytruncate
}
