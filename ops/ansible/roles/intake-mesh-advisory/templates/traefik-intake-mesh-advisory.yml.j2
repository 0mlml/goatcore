---
# SPDX-License-Identifier: Apache-2.0
# Generated by the intake-mesh-advisory Ansible role - do not edit on host.
#
# Low-priority mesh-facing Traefik router for public-enrollment hostnames
# reached over the mesh. When a candidate opens their invitation link from
# a mesh-connected device and DNS lands them on Thor's mesh-facing Traefik,
# this router matches the Host header on the websecure entrypoint and serves
# a static advisory page instead of a bare 404.

{% set _hosts = intake_mesh_advisory_hostnames | default([]) %}

http:
  routers:
{% for host in _hosts %}
    {{ intake_mesh_advisory_traefik_router_name }}-{{ loop.index0 }}:
      rule: "Host(`{{ host }}`)"
      # Low-priority catch-all for this hostname on the mesh-facing
      # websecure entrypoint; any future router for the same Host() can
      # outrank this advisory by setting a higher priority.
      priority: 1
      entryPoints:
        - websecure
      service: {{ intake_mesh_advisory_traefik_router_name }}
{% if intake_mesh_advisory_mesh_only_middleware | default('') | length > 0 %}
      middlewares:
        - "{{ intake_mesh_advisory_mesh_only_middleware }}"
{% endif %}
      tls:
        certResolver: {{ intake_mesh_advisory_traefik_cert_resolver }}
{% endfor %}

  services:
    {{ intake_mesh_advisory_traefik_router_name }}:
      loadBalancer:
        servers:
          - url: "http://{{ intake_mesh_advisory_container_name }}:{{ intake_mesh_advisory_internal_port }}"
