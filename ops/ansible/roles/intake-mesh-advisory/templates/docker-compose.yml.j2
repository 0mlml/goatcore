---
# SPDX-License-Identifier: Apache-2.0
# Generated by the intake-mesh-advisory Ansible role - do not edit on host.
# A tiny nginx container serving a static HTML advisory page behind the
# existing mgmt-host Traefik. No app logic, no state; all behaviour is in
# the rendered nginx.conf and index.html.

services:
  {{ intake_mesh_advisory_container_name }}:
    image: "{{ intake_mesh_advisory_image }}"
    container_name: "{{ intake_mesh_advisory_container_name }}"
    restart: unless-stopped
    # Same hardening the sibling onboard-intake-collector carries on this
    # host. Static nginx, but this container is reachable by every mesh peer
    # through the 100.64.0.0/10 allowlist — partner candidates included —
    # so it meets the bar its neighbour already meets.
    read_only: true
    tmpfs:
      - /var/cache/nginx
      - /var/run
    cap_drop:
      - ALL
    # Stock nginx runs a root master that chowns its cache/temp dirs and
    # spawns workers as the unprivileged `nginx` user — the minimal caps for
    # that model. The master binds the listen port as root, so no
    # NET_BIND_SERVICE is needed.
    cap_add:
      - CHOWN
      - SETUID
      - SETGID
    security_opt:
      - no-new-privileges:true
    networks:
      # `mgmt` - Traefik resolves {{ intake_mesh_advisory_container_name }}:{{ intake_mesh_advisory_internal_port }} on this network.
      - "{{ intake_mesh_advisory_traefik_network }}"
    expose:
      - "{{ intake_mesh_advisory_internal_port }}"
    volumes:
      - "{{ intake_mesh_advisory_compose_dir }}/nginx.conf:/etc/nginx/conf.d/default.conf:ro"
      - "{{ intake_mesh_advisory_compose_dir }}/index.html:/usr/share/nginx/html/index.html:ro"
    # No Traefik docker labels - routing is via file-provider config.
    labels:
      - "traefik.enable=false"
    logging:
      driver: json-file
      options:
        max-size: "5m"
        max-file: "3"

networks:
  "{{ intake_mesh_advisory_traefik_network }}":
    external: true
    name: "{{ intake_mesh_advisory_traefik_network }}"

