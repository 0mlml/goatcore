[Unit]
# F-251: Tegra Orin/Thor have no battery RTC — cold boot starts at 1970-01-01
# and every mTLS handshake fails "not yet valid" until a network time source
# is reached. Restore the last-saved wall clock BEFORE anything time-sensitive
# starts; `fake-hwclock load` only advances the clock, never regresses it, so
# this is a no-op on an RTC-equipped or already-correct host.
Description=Restore saved wall clock before network/TLS services
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target chrony-presync.service chronyd.service

[Service]
Type=oneshot
ExecStart=/sbin/fake-hwclock load
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target
