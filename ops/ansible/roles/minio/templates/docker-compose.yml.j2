# Rendered by ops/ansible/roles/minio on {{ ansible_date_time.iso8601 }}
# Source: ops/ansible/roles/minio/templates/docker-compose.yml.j2
# Anchors: ADR 0811 (Object Lock audit-integrity bucket) + ADR 0822
# (telemetry-otlp bucket on the same instance) + ADR 0826 (Orin-C
# observability + storage tier).
#
# DO NOT EDIT THIS FILE ON THE HOST — it will be overwritten on next
# Ansible run. Edit the .j2 template + re-run the role.
#
# Network model: each obs-tier service (MinIO, OpenObserve, OTel
# Collector) runs in its own compose project on its own bridge network.
# Cross-service comms goes via host.docker.internal:<port> so each
# service can be lifecycle-managed independently. The legacy obs-host
# stack (Prom + Alertmanager + Grafana + node_exporter) is on its own
# `obs` network and is unaffected.

services:
  minio:
    image: {{ minio_image }}
    container_name: minio
    restart: unless-stopped
    user: "{{ minio_uid }}:{{ minio_gid }}"
    deploy:
      resources:
        # 4G (was 2G): ZAGROS's working set sat at 1.83G/2G — mostly page
        # cache from audit-integrity reads, but cgroup reclaim pressure
        # at the cap degrades read throughput and risks OOM on spikes.
        # 8G (was 4G), 2026-09-11: zagros sat at 3.4G/4G again ahead of a
        # ~600-peer event; same reclaim-pressure argument, one more doubling.
        limits: { cpus: "2.0", memory: 8G }
        reservations: { memory: 512M }
    command:
      - server
      - /data
      - --address
      - ":{{ minio_api_port }}"
      - --console-address
      - ":{{ minio_console_port }}"
    environment:
      MINIO_ROOT_USER: "${MINIO_ROOT_USER}"
      MINIO_ROOT_PASSWORD: "${MINIO_ROOT_PASSWORD}"
      # Distribute prometheus metrics auth via env so Block 17D scrape
      # configs (Phase 2 follow-on) can authenticate without parsing
      # MinIO's per-tenant access keys. `public` exposes /minio/v2/metrics/
      # cluster without bearer-token auth — fine on the mesh-internal
      # interface; Phase 2 hardens this when Traefik fronts the API.
      MINIO_PROMETHEUS_AUTH_TYPE: "public"
{% if (minio_operator_idp_enabled | default(operator_idp_enabled | default(false))) | bool %}
      # ============================================================
      # Block 21H.3c — operator-IdP OIDC. ADR 0842.
      # MinIO consumes the JWT `groups` claim as a list of policy
      # names (CLAIM_NAME=groups overrides upstream default 'policy').
      # Policies named obs-admin / obs-readonly / minio-admin /
      # minio-readonly are created by the mc-init.sh extension below
      # as aliases to MinIO's built-in consoleAdmin / readonly.
      # The local-root path (MINIO_ROOT_*) above stays as break-glass.
      #
      # Gated on minio_operator_idp_enabled (defaults to the broad
      # operator_idp_enabled for back-compat) so a site can turn on
      # MinIO's OIDC WITHOUT enabling it for the whole obs stack
      # (openobserve / obs-host also read operator_idp_enabled).
      #
      # CONFIG_URL derives from minio_oidc_issuer_url (role default
      # tracks the vega `oauth2.ops.<site>` shape; sites whose Hydra is
      # at a different host — e.g. ZAGROS's `oauth2.<site>` — override the
      # var in group_vars). BROWSER_REDIRECT_URL is required for the
      # console to build correct login/redirect links when it is
      # fronted by Traefik on a different host than localhost:9001.
      # ============================================================
      MINIO_IDENTITY_OPENID_CONFIG_URL: "{{ minio_oidc_issuer_url }}/.well-known/openid-configuration"
      MINIO_IDENTITY_OPENID_CLIENT_ID: "minio"
      MINIO_IDENTITY_OPENID_CLIENT_SECRET: "{{ operator_idp_minio_client_secret }}"
      MINIO_IDENTITY_OPENID_CLAIM_NAME: "groups"
      MINIO_IDENTITY_OPENID_DISPLAY_NAME: "Operator IdP"
      MINIO_IDENTITY_OPENID_SCOPES: "openid,profile,email,groups"
      MINIO_IDENTITY_OPENID_REDIRECT_URI: "https://minio.{{ site_id }}.{{ site_dns_zone }}/oauth_callback"
      MINIO_BROWSER_REDIRECT_URL: "{{ minio_oidc_browser_redirect_url }}"
{% endif %}
    volumes:
      - {{ minio_data_root }}:/data
    ports:
      - "{{ minio_api_port }}:{{ minio_api_port }}"
      - "{{ minio_console_port }}:{{ minio_console_port }}"
    healthcheck:
      # wget, not curl: the Chainguard image carries busybox wget only.
      test: ["CMD", "wget", "-q", "--spider", "http://localhost:{{ minio_api_port }}/minio/health/live"]
      interval: 30s
      timeout: 5s
      retries: 5
    networks:
      - minio-net
    extra_hosts:
      - "host.docker.internal:host-gateway"
{% if minio_oidc_host_entry | default('') | length > 0 %}
      # F-126 — Docker's embedded resolver only forwards to host
      # /etc/resolv.conf on :53; mesh CoreDNS listens on :5353, so the
      # container cannot resolve the Hydra issuer hostname through the
      # normal path. Static map of the OIDC issuer host → the mgmt-host
      # mesh IP so OIDC discovery lands on Traefik → hydra-public.
      - "{{ minio_oidc_host_entry }}"
{% endif %}

  # One-shot init container. `restart: no` + run via `docker compose
  # run --rm mc-init` from the role. The script is idempotent so a
  # second invocation is safe.
  mc-init:
    image: {{ minio_mc_image }}
    container_name: minio-mc-init
    restart: "no"
    profiles: ["init"]
    depends_on:
      minio:
        condition: service_healthy
    environment:
      MC_HOST_local: "http://${MINIO_ROOT_USER}:${MINIO_ROOT_PASSWORD}@minio:{{ minio_api_port }}"
{% if minio_extra_users %}
    env_file:
      # Per-extra-user secrets — one KEY=VALUE per entry in minio_extra_users.
      # Rendered by the role (mode 0600); referenced by mc-init.sh for the
      # `mc admin user add` step so secrets never land in the script.
      - {{ minio_compose_dir }}/mc-extra-users.env
{% endif %}
    volumes:
      - {{ minio_compose_dir }}/mc-init.sh:/mc-init.sh:ro
{% if minio_extra_users %}
      - {{ minio_compose_dir }}/policies:/policies:ro
{% endif %}
    entrypoint: ["/bin/sh", "/mc-init.sh"]
    networks:
      - minio-net

networks:
  minio-net:
    name: minio-net
