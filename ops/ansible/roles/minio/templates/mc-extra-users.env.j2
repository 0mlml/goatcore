# Rendered by ops/ansible/roles/minio on {{ ansible_date_time.iso8601 }}
# Mode 0600. One KEY=VALUE pair per entry in `minio_extra_users`.
# Consumed by the mc-init compose service via env_file; mc-init.sh.j2
# references each variable to mint the user's secret atomically.
#
# Do NOT commit this file from the host — it carries the per-user secret.
# The role refuses to render if any entry's secret_envvar resolves empty.
{% for user in minio_extra_users %}
{{ (user.name | upper | replace('-', '_')) + '_SECRET' }}={{ lookup('env', user.secret_envvar) }}
{% endfor %}
