# /etc/wireguard/{{ wg_cp0_interface_name }}.conf
# Rendered by ansible/roles/wg-cp0-client (Block 22 / ADR 0313).
# DO NOT EDIT MANUALLY — re-running the role overwrites this file.
#
# Network host wg-cp0 client for {{ inventory_hostname }}.
# Local address: {{ wg_cp0_client_address }} ({{ wg_cp0_subnet }})
# Connects to {{ wg_cp0_relays | length }} relay(s).

[Interface]
PrivateKey = {{ wg_cp0_privkey_b64 }}
Address    = {{ wg_cp0_client_address }}/{{ wg_cp0_subnet | regex_replace('^.*/(\\d+)$', '\\1') }}
# Network host doesn't accept inbound connections — no ListenPort.

{% for relay in wg_cp0_relays %}

[Peer]
# {{ relay.name }}
PublicKey  = {{ relay.pubkey }}
Endpoint   = {{ relay.endpoint }}
AllowedIPs = {{ relay.allowed_ips | join(', ') }}{% if wg_cp0_route_subnet_via_first_relay and loop.index == 1 %}, {{ wg_cp0_subnet }}{% endif %}

PersistentKeepalive = {{ wg_cp0_persistent_keepalive }}
{% endfor %}
