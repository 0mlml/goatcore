# {{ ansible_managed }}
# spiffe-helper for goat-id-console (ZAGROS SPIRE Phase A). Fetches the console's
# X509-SVID from the SPIRE agent Workload API and writes cert+key+bundle into the
# shared `svid` volume the console reads as /svid. The console's :9443 mTLS
# onboarding listener presents this SVID and verifies the onboard-runner's SVID
# SPIFFE ID against the bundle (docs/design/runner-console-mtls.md).
#
# The console authenticates AS spiffe://{{ spire_trust_domain | default('zagros.zagros.example') }}/goat-id-console
# (set by the SPIRE registration entry whose selector matches this sidecar's
# compose label).

agent_address         = "/run/spire/sockets/agent.sock"
cmd                   = ""
cmd_args              = ""
cert_dir              = "/svid"
svid_file_name        = "goat-id-console-cert.pem"
svid_key_file_name    = "goat-id-console-key.pem"
svid_bundle_file_name = "spire-bundle.pem"
renew_signal          = ""

# No file-mode keys: spiffe-helper 0.10.1 writes the key 0600 and ignores
# key_file_mode (and is distroless, so no chmod hook). The console reads it
# anyway because the helper runs as the SAME nonroot UID as the console and
# writes into a host bind dir chowned to that UID — see the id-admin-console role
# + docker-compose.id-admin-console.yml.j2. So the 0600 key is owned by, and
# readable by, the console without ever being world-readable.
