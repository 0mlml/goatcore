# {{ ansible_managed }}
# Managed by ops/ansible/roles/vxlan — do not edit by hand.
#
# Applies the FULL kernel state for goat L2 segments at boot via bash +
# iproute2 (NOT systemd-networkd — see F-051).

[Unit]
Description=VXLAN segment runtime state (full bash+iproute2 apply)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/vxlan/segments.conf

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/vxlan-runtime-state.sh
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
