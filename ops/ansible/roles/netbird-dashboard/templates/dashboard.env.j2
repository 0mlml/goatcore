## Block 21D.1 — netbird-dashboard env file (rendered by ops/ansible/roles/netbird-dashboard).
## Do NOT edit by hand on the mgmt-host. Re-render via:
##   OBJC_DISABLE_INITIALIZE_FORK_SAFETY=YES \
##     ansible-playbook -i inventory/mgmt-hosts.ini \
##       dashboard-deploy.yml -e site_id={{ site_id }}
##
## Mode 0600 owner=root. The OIDC client_secret is here; treat as sensitive.

# -- mgmt-API the dashboard talks to ---------------------------------------
NETBIRD_MGMT_API_ENDPOINT={{ netbird_dashboard_mgmt_api_endpoint }}
NETBIRD_MGMT_GRPC_API_ENDPOINT={{ netbird_dashboard_mgmt_grpc_api_endpoint }}

# -- OIDC (Hydra issuer at oauth2.<site>) ----------------------------------
# IMPORTANT: netbirdio/dashboard's init_react_envs.sh expects these
# WITHOUT the NETBIRD_ prefix on auth-related vars (the prefix is only
# for mgmt-API + telemetry vars). Env-var names are upstream-contract
# per /usr/local/init_react_envs.sh inside the dashboard image.
#
# Trailing slash on AUTH_AUTHORITY matches Hydra's iss claim format
# (Hydra always returns `iss` with trailing slash); without it the
# @axa-fr/oidc-client lib does an extra normalization pass.
AUTH_AUTHORITY=https://oauth2.{{ site_id }}.{{ site_dns_zone }}/
AUTH_AUDIENCE={{ netbird_dashboard_oidc_client_id }}
AUTH_CLIENT_ID={{ netbird_dashboard_oidc_client_id }}
AUTH_CLIENT_SECRET={{ netbird_dashboard_oidc_client_secret }}
AUTH_SUPPORTED_SCOPES={{ netbird_dashboard_oidc_scopes | join(' ') }}
# F-080: AUTH_REDIRECT_URI must be a real route in the dashboard's
# static export. /peers is the canonical netbirdio default and IS a
# real page; /auth is the docker-compose template default but does NOT
# exist as a static file in the image (returns 404 → OAuth callback
# loses the code). Keep /peers unless an operator-fired change.
AUTH_REDIRECT_URI=/peers
AUTH_SILENT_REDIRECT_URI=/silent-auth
NETBIRD_TOKEN_SOURCE={{ netbird_dashboard_token_source }}

# -- Auth0 compatibility (off; we use Hydra) -------------------------------
USE_AUTH0={{ netbird_dashboard_use_auth0 }}

# -- Self URL (used in HTML head + login flows) ----------------------------
NEXTAUTH_URL={{ netbird_dashboard_self_url }}

# -- Hot-load backend (left default) ---------------------------------------
NETBIRD_HOTLOAD=false

# -- Identifying tags for log correlation ----------------------------------
SITE_ID={{ site_id }}
ROUTER_ROLE={{ router_role | lower }}
