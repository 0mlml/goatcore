[Unit]
Description=NTP health agent — chrony verdict daemon
Documentation=https://github.com/usareur-af/goatcore/blob/main/docs/design/universal-ntp-hygiene.md
After=network.target chrony.service
Requires=chrony.service

[Service]
Type=simple
ExecStart={{ ntp_health_agent_install_dir }}/ntp-health-agent \
  -chrony-socket {{ ntp_health_agent_chrony_socket }} \
  -unix-socket {{ ntp_health_agent_unix_socket }} \
  -http-addr {{ ntp_health_agent_http_addr }} \
  -poll-interval {{ ntp_health_agent_poll_interval }}{% if ntp_health_agent_attestation_enabled %} \
  -attestation-key {{ ntp_health_agent_key_dir }}/attestation.key \
  -attestation-validity {{ ntp_health_agent_attestation_validity }}{% endif %}

Restart=on-failure
RestartSec=5s

User=root
# Supplementary group gives access to chronyd's control socket.
SupplementaryGroups=_chrony

RuntimeDirectory=ntp-health-agent
RuntimeDirectoryMode=0755

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/run
ReadOnlyPaths={{ ntp_health_agent_key_dir }}

[Install]
WantedBy=multi-user.target
