[Unit]
Description=NTP admit sidecar — blocks peer enrollment when NTP is unhealthy
Documentation=https://github.com/usareur-af/goatcore/blob/main/docs/design/universal-ntp-hygiene.md
After=network.target ntp-health-agent.service
Requires=ntp-health-agent.service

[Service]
Type=simple
ExecStart={{ ntp_admit_sidecar_install_dir }}/ntp-admit-sidecar \
  -listen {{ ntp_admit_sidecar_listen }} \
  -backend {{ ntp_admit_sidecar_backend }} \
  -ntp-socket {{ ntp_admit_sidecar_ntp_socket }} \
  -ntp-timeout {{ ntp_admit_sidecar_ntp_timeout }} \
  -rate-limit-max {{ ntp_admit_sidecar_rate_limit_max }} \
  -rate-limit-window {{ ntp_admit_sidecar_rate_limit_window }}

Restart=on-failure
RestartSec=3s

User=root
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
