# Managed by ansible (roles/netbird-admin-reconcile). Do not edit on the host.
[Unit]
Description=Periodic Kratos->netbird admin-role reconcile

[Timer]
# A person's netbird user row only exists after their own first dashboard
# sign-in, so the promotion cannot happen at onboarding time. This timer is
# what closes that window without an operator in the loop.
OnBootSec=2min
OnUnitActiveSec={{ netbird_admin_reconcile_interval | default('5min') }}
AccuracySec=30s
Persistent=true

[Install]
WantedBy=timers.target
