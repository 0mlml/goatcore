# Managed by ansible (roles/netbird-admin-reconcile). Do not edit on the host.
[Unit]
Description=Reconcile Kratos admin groups into netbird-mgmt user roles
Documentation=file:///usr/local/sbin/netbird-admin-reconcile.sh
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
Environment="KRATOS_ADMIN_URL=http://127.0.0.1:{{ kratos_admin_host_port | default(4434) }}"
Environment="NETBIRD_MGMT_ADMIN_GROUPS={{ netbird_mgmt_admin_groups | join(',') }}"
Environment="NETBIRD_MGMT_ROLE_MAP={{ netbird_mgmt_role_map_env }}"
Environment="TEXTFILE_DIR={{ netbird_admin_reconcile_textfile_dir }}"
ExecStart=/usr/local/sbin/netbird-admin-reconcile.sh
