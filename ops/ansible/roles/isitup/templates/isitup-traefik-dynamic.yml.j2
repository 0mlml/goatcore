# Rendered by ops/ansible/roles/isitup/ at /etc/traefik/dynamic/isitup-{{ site_id }}.yml.
# DO NOT EDIT ON HOST — overwritten on next ansible-playbook run.
#
# Single router → oauth2-proxy-isitup, which acts as a reverse proxy in front
# of the nginx `isitup` container. Browser flow:
#   1. Unauthenticated → oauth2-proxy redirects to /oauth2/start → Hydra → Kratos
#      → callback → cookie set → 302 to original URL.
#   2. Authenticated → oauth2-proxy forwards request to isitup:80 nginx.
#
# `OAUTH2_PROXY_UPSTREAMS=http://isitup:80` (set in isitup.env) wires the
# nginx as oauth2-proxy's backend.
#
# No tls.domains here — the master Let's Encrypt SAN list lives on signal
# in mgmt-dynamic.yml; the cert Traefik already minted there is
# SNI-matched against {{ isitup_fqdn }}.

http:
  routers:
    isitup-{{ site_id }}:
      rule: "Host(`{{ isitup_fqdn }}`)"
      entryPoints:
        - websecure
      service: isitup-{{ site_id }}
{% if (isitup_traefik_mesh_only_middleware | default('') | length > 0) or (isitup_traefik_ratelimit_middleware | default('') | length > 0) %}
      middlewares:
{% if isitup_traefik_mesh_only_middleware | default('') | length > 0 %}
        # Mesh-only gating — opt-in per site (default off). Non-mesh
        # clients get 403 before ever being redirected to oauth2-proxy.
        - "{{ isitup_traefik_mesh_only_middleware }}"
{% endif %}
{% if isitup_traefik_ratelimit_middleware | default('') | length > 0 %}
        # Browsing rate ceiling, 50 r/s per source peer — `goat-ratelimit`
        # from mgmt-dynamic.yml, attached per router (the
        # entrypoint keeps only the 3000 r/s control-plane ceiling). See
        # docs/design/surface-overload-protection.md §3.1.
        - "{{ isitup_traefik_ratelimit_middleware }}"
{% endif %}
{% endif %}
      tls:
        certResolver: le

  services:
    isitup-{{ site_id }}:
      loadBalancer:
        servers:
          - url: "http://oauth2-proxy-isitup:4180"
