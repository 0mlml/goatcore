{#- data/meta.json — what the status page knows about each row beyond its probe
    result. Keyed by row id, the same id current.json carries. Rendered from the
    `isitup_rows` fact, the same list services.env is rendered from. -#}
{%- set _meta = {} -%}
{%- for r in isitup_rows -%}
{%-   set _ = _meta.update({r.id: {'lifecycle': r.lifecycle, 'source': r.source, 'owner': r.owner, 'retire_after': r.retire_after}}) -%}
{%- endfor -%}
{{ {'rows': _meta} | to_nice_json }}
