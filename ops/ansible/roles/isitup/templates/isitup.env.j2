# Rendered by ops/ansible/roles/isitup/ — DO NOT EDIT ON HOST.
# Mode 0600 root:root.
#
# Consumed by oauth2-proxy-isitup container in docker-compose.isitup.yml.

# --- OIDC provider (site Hydra) ---
OAUTH2_PROXY_PROVIDER=oidc
OAUTH2_PROXY_OIDC_ISSUER_URL={{ isitup_oidc_issuer_url }}
OAUTH2_PROXY_CLIENT_ID={{ isitup_oidc_client_id }}
OAUTH2_PROXY_CLIENT_SECRET={{ isitup_oidc_client_secret }}

# Scopes — must match isitup-oidc-client role's view of the client record.
# `offline_access` requests a refresh_token so oauth2-proxy can silently
# refresh the session at the COOKIE_REFRESH=1h boundary below; without it
# the access_token expires (Hydra default ~1h), refresh fails, and the
# user gets bounced through the full login flow every ~1h.
OAUTH2_PROXY_SCOPE=openid profile email groups offline_access

# --- Cookie / session ---
# Random 32-byte secret base64-encoded. Sourced from NOVA_ISITUP_COOKIE_SECRET.
OAUTH2_PROXY_COOKIE_SECRET={{ isitup_cookie_secret }}
# Scope cookie to the isitup hostname so a stolen cookie can't be replayed
# against dashboard.* / oauth2.* / auth.* on sibling subdomains.
OAUTH2_PROXY_COOKIE_DOMAINS={{ isitup_cookie_domain }}
OAUTH2_PROXY_COOKIE_SECURE=true
OAUTH2_PROXY_COOKIE_HTTPONLY=true
OAUTH2_PROXY_COOKIE_SAMESITE=lax
OAUTH2_PROXY_COOKIE_EXPIRE=8h

# --- Listener / routing ---
OAUTH2_PROXY_HTTP_ADDRESS=0.0.0.0:4180
OAUTH2_PROXY_REVERSE_PROXY=true
OAUTH2_PROXY_WHITELIST_DOMAINS={{ isitup_fqdn }}
OAUTH2_PROXY_REDIRECT_URL=https://{{ isitup_fqdn }}/oauth2/callback

# --- Upstream: oauth2-proxy acts as a reverse proxy in front of nginx.
#     A single Traefik router sends every isitup-host request here; oauth2-
#     proxy handles the OAuth2 redirect for unauthenticated browsers and
#     forwards authenticated requests to the isitup nginx backend. ---
OAUTH2_PROXY_UPSTREAMS=http://isitup:80

# --- Authz: any authenticated Kratos identity may view. Per-group gating
#     lands as a follow-on when isitup gets per-group UI. ---
OAUTH2_PROXY_EMAIL_DOMAINS=*

# --- Pass identity downstream to nginx so future isitup features can
#     read X-Auth-Request-* ---
OAUTH2_PROXY_PASS_USER_HEADERS=true
OAUTH2_PROXY_SET_XAUTHREQUEST=true
OAUTH2_PROXY_SET_AUTHORIZATION_HEADER=false

# --- Skip provider-button page; jump straight to Hydra. ---
OAUTH2_PROXY_SKIP_PROVIDER_BUTTON=true

# --- Logging ---
OAUTH2_PROXY_REQUEST_LOGGING=true
OAUTH2_PROXY_AUTH_LOGGING=true
OAUTH2_PROXY_STANDARD_LOGGING=true
# Parallel login flows (a page and its favicon/XHRs racing through
# /oauth2/start together) each mint a CSRF cookie; without per-request
# cookies the later flow overwrites the earlier one's and the first
# callback 403s ("CSRF token mismatch, potential attack") even though
# authentication succeeded.
OAUTH2_PROXY_COOKIE_CSRF_PER_REQUEST=true
OAUTH2_PROXY_COOKIE_CSRF_EXPIRE=15m

# API_ROUTES — the other half of the line above, and without it that line is a
# slow-acting lockout.
#
# The comment above anticipated a page and its XHRs racing through /oauth2/start
# ONCE. It did not anticipate that this page POLLS: index.html runs
# `setInterval(load…)` over /data/current.json, /data/history.json and
# /data/netview.json forever. Every poll made with an invalid session is a fresh
# "No valid authentication in request. Initiating login." — and with per-request
# CSRF that is a fresh 15-minute cookie, every few seconds, with nobody ever
# completing the flow to clear it.
#
# Those three paths alone produce hundreds of login-initiations an hour — on the
# order of a hundred live CSRF cookies per 15-minute window. nginx ships
# `large_client_header_buffers 4 8k` by default,
# so the Cookie header bursts that buffer within minutes and the ONLY thing the
# operator sees is `400 Request Header Or Cookie Too Large`, served by nginx
# before any of this stack is consulted. It does not resolve on its own; the user
# is locked out of the host until they manually clear cookies for it.
#
# api_routes makes a request matching the regex return 401 instead of starting an
# OIDC flow. A polling XHR then fails the way an XHR should fail, mints nothing,
# and the page recovers on the next reload. Interactive navigations are
# unaffected and still redirect to login.
OAUTH2_PROXY_API_ROUTES=^/data/

# SESSION_COOKIE_MINIMAL — F-310.
#
# With no session store configured oauth2-proxy defaults to `cookie` and packs
# the WHOLE session into it: id_token + access_token + refresh_token, plus the
# groups claim the fence gates on. That exceeds the browser's per-cookie limit,
# the cookie is dropped, and the session evaporates a minute or two after a
# successful login — every refresh re-authenticates. oauth2-proxy logs NO
# warning for this: it warns when it SPLITS a cookie, never when the browser
# then declines to keep it, so the failure is invisible server-side.
#
# Without this a session with an 8 h expiry re-authenticates within minutes;
# with it, dozens of authenticated requests need only a login or two.
#
# `minimal` keeps email + user + groups and drops the three tokens. Verified
# compatible with SET_XAUTHREQUEST (tested against v7.6.0: the proxy starts and
# validates) — the X-Auth-Request-* headers are built from session fields, not
# from the tokens, so in-app group scoping is unaffected.
#
# COOKIE_REFRESH is REMOVED where it was set: it is mutually exclusive with
# minimal, because a refresh needs the refresh token minimal does not keep.
# Consequence stated rather than discovered — the session now lives to
# COOKIE_EXPIRE instead of being silently renewed, and Kratos's 24 h SSO makes
# the eventual re-auth a redirect, not a password prompt.
OAUTH2_PROXY_SESSION_COOKIE_MINIMAL=true
