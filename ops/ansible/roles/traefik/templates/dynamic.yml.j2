# Traefik dynamic config — rendered by ops/ansible/roles/traefik
# Source-of-truth: ops/ansible/roles/traefik/templates/dynamic.yml.j2
# Decision: ADR 0407 / docs/design/internal-tls-ca.md §6.2
#
# DO NOT EDIT THIS FILE ON THE HOST — it will be overwritten on next
# Ansible run. To change routes or TLS options, edit the .j2 template
# in the repo + re-run the traefik role.
#
# Traefik's file-watcher (--providers.file.watch=true) picks up changes
# without a service restart.

tls:
  options:
    default:
      # FIPS 140-3-aligned TLS 1.3 only — internal endpoints behind
      # wg-cp0; no need to support legacy clients. Cipher list mirrors
      # the FIPS-PQC path (ops/ansible/templates/traefik-dynamic.yml.j2
      # legacy template's TLS 1.2 list intentionally NOT carried
      # forward — internal traffic gets stricter posture).
      minVersion: VersionTLS13
      cipherSuites:
        - TLS_AES_256_GCM_SHA384
        - TLS_CHACHA20_POLY1305_SHA256
      # Certs are listed under tls.certificates below — Traefik picks
      # the cert whose SAN matches the SNI server name.
  certificates:
{% for svc in traefik_services %}
    - certFile: "{{ traefik_tls_root }}/{{ svc.name }}/cert.pem"
      keyFile: "{{ traefik_tls_root }}/{{ svc.name }}/key.pem"
{% endfor %}

http:
  middlewares:
    # goat-entrypoint-ceiling — the universal ceiling (tier 1), defined here
    # so every host on the traefik-role path carries it whether or not the
    # site declares any middlewares of its own. Same rule and same numbers as
    # the ACME path's copy in mgmt-dynamic.yml.j2; see
    # docs/design/surface-overload-protection.md §3.1 for the two tiers and
    # §4 for why the definition exists twice (two independent config paths,
    # neither reachable from the other) and what keeps them honest.
    #
    # Sized for on-host callers that reach :443 through docker-proxy as ONE
    # source IP, such as the hub's own netbird client (measurement in
    # mgmt-dynamic.yml.j2): 3000 r/s, burst 6000. Attach it to the whole
    # entrypoint with
    #   --entrypoints.websecure.http.middlewares=goat-entrypoint-ceiling@file
    # on the Traefik command set for this host. Defining it costs nothing
    # when unattached, and a definition that is present cannot fail-close a
    # router the way a missing one can.
    goat-entrypoint-ceiling:
      rateLimit:
        average: {{ traefik_entrypoint_ratelimit_average | default(3000) }}
        burst: {{ traefik_entrypoint_ratelimit_burst | default(6000) }}
        period: 1s
        sourceCriterion:
          ipStrategy:
            depth: 0

    # goat-ratelimit — the browsing-surface ceiling (tier 2): 50 r/s per
    # source peer, attached PER ROUTER to the request routers a person drives
    # from a browser, never to control-plane, ingest or stream routers. See
    # mgmt-dynamic.yml.j2 for why it is not an entrypoint limiter.
    goat-ratelimit:
      rateLimit:
        average: {{ goat_ratelimit_average | default(50) }}
        burst: {{ goat_ratelimit_burst | default(100) }}
        period: 1s
        sourceCriterion:
          ipStrategy:
            depth: 0

    # goat-inflight — the CONCURRENCY ceiling, per source peer. Same rule and
    # same number as the ACME path's copy in mgmt-dynamic.yml.j2, for the same
    # §4 reason; check-shared-traefik-middlewares-agree.sh keeps the two equal.
    #
    # goat-ratelimit above counts requests per second, which is the right
    # ceiling only while requests cost roughly the same. F-371 was the case
    # where they did not: portal authentication walked every vendor row
    # running bcrypt, so ONE request cost 11.7 CPU-seconds. A caller issuing
    # about one request per second — 2% of the rate ceiling, invisible to it —
    # held 8-12 of a 14-core host. Rate says how OFTEN work arrives; in-flight
    # depth says how much is being done at once, and expensive requests are
    # exactly the ones that pile up there.
    #
    # Defined here but attached PER ROUTER, never at the entrypoint like
    # goat-entrypoint-ceiling and goat-compress: an in-flight cap holds a slot for the
    # whole life of a request, and streaming routes hold connections open for
    # minutes on purpose (ADR 1133), so a universal one would throttle peers
    # for using those surfaces as designed. Attach it to request routers that
    # can do real work per call; leave stream routers without it.
    #
    # Defining it unattached costs nothing, and — as with goat-ratelimit above
    # — a definition that is PRESENT cannot fail-close a router the way a
    # missing one can. That is why it lands on every host rather than only the
    # ones with a router referencing it today.
    goat-inflight:
      inFlightReq:
        amount: {{ goat_inflight_amount | default(24) }}
        sourceCriterion:
          ipStrategy:
            depth: 0

    # goat-compress — universal response compression, attached at the
    # ENTRYPOINT beside goat-entrypoint-ceiling so it covers every router on :443,
    # including surfaces that do not exist yet. Same reasoning as the
    # ratelimit: per-router attachment is a thing to remember once per
    # service, and the one everybody forgets is the one that needs it.
    #
    # WHY THIS EXISTS: without it nothing on the fleet compresses anything.
    # The payloads are text: panoscope's snapshot JSON compresses about 10x, other
    # surfaces 3-5x, the portal's HTML about 3x. panoscope's frontend polls
    # /api/snapshot on a tier-gated cadence (ADR 1123), so one open
    # browser tab is a standing load for as long as it stays open.
    #
    # Compression is NEGOTIATED: a client that sends no Accept-Encoding
    # it can satisfy gets the identity encoding, so this cannot break a
    # consumer that does not understand it.
    #
    # EXCLUSIONS, and why each one is here:
    #   text/event-stream — SSE. A compressor buffers to fill a window,
    #     and buffering an event stream delays exactly the events the
    #     stream exists to deliver promptly. The portal's SSE route is
    #     the majority of what Traefik counts against `portal`, so this is a
    #     real route. Never remove this line.
    #   application/grpc — Traefik excludes it by default; named here so
    #     a future edit to this list cannot silently drop it. The signal
    #     server holds a gRPC stream per peer.
    #   The already-compressed media types: spending CPU to re-compress
    #     a PNG or a gzip costs bytes rather than saving them.
    goat-compress:
      compress:
        # Below this, the encoding header costs more than the body saves.
        minResponseBodyBytes: {{ goat_compress_min_bytes | default(1024) }}
        excludedContentTypes:
          - text/event-stream
          - application/grpc
          - image/png
          - image/jpeg
          - image/webp
          - image/gif
          - application/zip
          - application/gzip
          - application/octet-stream
{% if traefik_middlewares %}
{{ traefik_middlewares | to_nice_yaml(indent=2, width=200) | indent(4, true) }}
{% endif %}
  routers:
{% for svc in traefik_services %}
    {{ svc.name }}:
{% set host_rule = svc.hosts | map('regex_replace', '^(.*)$', 'Host(`\\1`)') | join(' || ') %}
{% if svc.path_prefixes is defined and svc.path_prefixes %}
{% set path_rule = svc.path_prefixes | map('regex_replace', '^(.*)$', 'PathPrefix(`\\1`)') | join(' || ') %}
      rule: "({{ host_rule }}) && ({{ path_rule }})"
{% else %}
      rule: "{{ host_rule }}"
{% endif %}
{% if svc.priority is defined %}
      priority: {{ svc.priority }}
{% endif %}
      entryPoints:
        - websecure
      service: {{ svc.name }}
      tls: {}
{% if svc.middlewares is defined and svc.middlewares %}
      middlewares:
{% for mw in svc.middlewares %}
        - {{ mw }}
{% endfor %}
{% endif %}
{% endfor %}
  services:
{% for svc in traefik_services %}
    {{ svc.name }}:
      loadBalancer:
        servers:
          - url: "{{ svc.backend }}"
{% endfor %}
