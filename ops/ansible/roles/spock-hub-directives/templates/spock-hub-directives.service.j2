[Unit]
Description=Carry out the goatnet hub's directives at this site (ADR 1205)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile={{ spock_hub_directives_env_file }}
ExecStart={{ spock_hub_directives_install_dir }}/spock-hub-directives.sh
TimeoutStartSec=120
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths={{ spock_hub_directives_textfile_dir }}
PrivateTmp=true
StandardOutput=journal
StandardError=journal
