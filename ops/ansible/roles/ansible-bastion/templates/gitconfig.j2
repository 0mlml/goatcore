[user]
    name = {{ item.name }}
    email = {{ item.email | default(item.name + '@' + ansible_hostname) }}
[init]
    defaultBranch = main
[pull]
    rebase = false
[core]
    pager = less -FRX
[color]
    ui = auto
[push]
    default = simple
{% if item.git_signingkey is defined %}
[user]
    signingkey = {{ item.git_signingkey }}
[commit]
    gpgsign = true
{% endif %}
