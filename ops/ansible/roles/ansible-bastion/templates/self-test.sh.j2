#!/usr/bin/env bash
# Rendered by ops/ansible/roles/ansible-bastion on {{ ansible_date_time.iso8601 }}.
# Source: ops/ansible/roles/ansible-bastion/templates/self-test.sh.j2
#
# Operator-runnable self-test. Verifies the bastion has the tools the
# fleet plays expect. Exit 0 = ready; non-zero with the failed step
# named on stderr. Idempotent + no side effects.

set -euo pipefail

PASS=0
FAIL=0

check() {
    local name=$1
    shift
    if "$@" >/dev/null 2>&1; then
        printf '  [ok]   %s\n' "$name"
        PASS=$((PASS + 1))
    else
        printf '  [FAIL] %s (cmd: %s)\n' "$name" "$*" >&2
        FAIL=$((FAIL + 1))
    fi
}

printf 'goat ansible-bastion self-test (host: %s)\n' "$(hostname)"
printf 'workspace: %s\n\n' "{{ ansible_bastion_workspace }}"

check "ansible installed"      command -v ansible
check "ansible-playbook"       command -v ansible-playbook
check "ansible-lint"           command -v ansible-lint
check "git"                    command -v git
check "direnv"                 command -v direnv
check "jq"                     command -v jq
check "ssh"                    command -v ssh
check "tmux"                   command -v tmux
check "go"                     command -v go
check "shellcheck"             command -v shellcheck
check "workspace writable"     test -w "{{ ansible_bastion_workspace }}"
check "ansible --version OK"   ansible --version

printf '\nresult: %d pass, %d fail\n' "$PASS" "$FAIL"
exit $((FAIL > 0 ? 1 : 0))
