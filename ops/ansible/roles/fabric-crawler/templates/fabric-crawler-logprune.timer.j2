# {{ ansible_managed }}
[Unit]
Description=Hourly reap of fabric-crawler RocksDB LOG.old debris

[Timer]
OnCalendar={{ fabric_crawler_logprune_oncalendar }}
# Survives a host that was down at the scheduled minute — the debris does not
# stop accruing while the box is off.
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
