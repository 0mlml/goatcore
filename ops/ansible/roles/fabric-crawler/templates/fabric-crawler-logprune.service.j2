# {{ ansible_managed }}
[Unit]
Description=Reap RocksDB LOG.old debris from the fabric-crawler secondary dir
Documentation=file://{{ fabric_crawler_compose_dir }}/README-logprune.txt

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/fabric-crawler-logprune.sh
# The tree can hold millions of small files; unlink storms must never contend
# with the router or the crawler for IO on the shared NVMe.
Nice=19
IOSchedulingClass=idle
