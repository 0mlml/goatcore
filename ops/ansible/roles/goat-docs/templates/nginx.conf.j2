# SPDX-License-Identifier: Apache-2.0
# Generated by the goat-docs Ansible role — do not edit on host.
# Serves the unpacked mdBook site and injects a small version badge into every
# HTML page via sub_filter, so a reader can always see which goat-cli release
# these docs track (the pinned tag is goat_docs_release_tag; /version.json is the
# machine-readable form). ngx_http_sub_module is compiled into the official
# nginx image.
server {
    listen {{ goat_docs_internal_port }};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location = /version.json {
        default_type application/json;
        add_header Cache-Control "no-store";
        try_files /version.json =404;
    }

    location / {
        try_files $uri $uri/ =404;
        sub_filter_once on;
        sub_filter_types text/html;
        sub_filter '</body>'
            '<div id="goat-docs-version" title="docs pinned to this goat-cli release; see /version.json" style="position:fixed;bottom:10px;right:10px;z-index:99999;font:12px/1 system-ui,-apple-system,sans-serif;background:#161c19;color:#9aa39d;border:1px solid #2a332d;border-radius:6px;padding:5px 9px;opacity:.85">docs {{ goat_docs_release_tag }}</div></body>';
    }
}
