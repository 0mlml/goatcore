# Generated by the goat-docs Ansible role — do not edit on host.
# nginx:alpine serving {{ goat_docs_www_dir }} (the unpacked mdBook static
# site) read-only. Traefik routes to it via the file-provider config in
# /etc/traefik/dynamic/{{ goat_docs_traefik_dynamic_filename }}.
services:
  {{ goat_docs_container_name }}:
    image: "{{ goat_docs_image }}"
    container_name: "{{ goat_docs_container_name }}"
    restart: unless-stopped
    networks:
      # `mgmt` — Traefik resolves {{ goat_docs_container_name }}:80 over this network.
      - "{{ goat_docs_traefik_network }}"
    expose:
      - "{{ goat_docs_internal_port }}"
    volumes:
      # Read-only bind of the static site. nginx's bundled mime.types maps
      # .html/.css/.js correctly; index.html is mdBook's landing page.
      - "{{ goat_docs_www_dir }}:/usr/share/nginx/html:ro"
      # Custom server block: serves the site + injects a version badge into every
      # HTML page and exposes /version.json (the pinned release tag).
      - "{{ goat_docs_compose_dir }}/nginx.conf:/etc/nginx/conf.d/default.conf:ro"
    # No Traefik docker labels — file-provider routing only.
    labels:
      - "traefik.enable=false"
    logging:
      driver: json-file
      options:
        max-size: "5m"
        max-file: "3"

networks:
  "{{ goat_docs_traefik_network }}":
    external: true
    name: "{{ goat_docs_traefik_network }}"
