# Generated by the goat-docs Ansible role — do not edit on host.
# Rendered to {{ goat_docs_traefik_dynamic_dir }}/{{ goat_docs_traefik_dynamic_filename }}.
#
# File-provider router: upstream addressed by Docker network alias on the
# `mgmt` network, Let's Encrypt cert via the `le` resolver, mesh-only
# gating via the shared middleware. Filename is distinct from the
# neighboring route files (incl. goat-get.yml) so a goat-docs
# redeploy can't stomp them.

http:
  routers:
    {{ goat_docs_traefik_router_name }}:
      rule: "Host(`{{ goat_docs_hostname }}`)"
      entryPoints:
        - websecure
      service: {{ goat_docs_traefik_router_name }}
{% if goat_docs_traefik_mesh_only_middleware | default('') | length > 0 %}
      middlewares:
        # Mesh-only gating — middleware defined in mgmt-dynamic.yml.j2.
        # The site has no
        # application-layer auth; this is the whole auth surface.
        - "{{ goat_docs_traefik_mesh_only_middleware }}"
{% endif %}
{% if goat_docs_traefik_cert_resolver | default('') | length > 0 %}
      tls:
        certResolver: {{ goat_docs_traefik_cert_resolver }}
{% else %}
      tls: {}
{% endif %}

  services:
    {{ goat_docs_traefik_router_name }}:
      loadBalancer:
        servers:
          - url: "http://{{ goat_docs_container_name }}:{{ goat_docs_internal_port }}"
