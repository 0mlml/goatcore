# {{ ansible_managed }}
[Unit]
Description=Cross-sovereign peering WireGuard link (%i)
Documentation=file:///etc/goat-peering-wg/%i.env
After=network-online.target
Wants=network-online.target
# The edge router's published port binds on the link address, so that address has to
# exist before the container engine brings the edge back after a reboot.
Before=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/goat-peering-wg/%i.env
ExecStart=/usr/local/sbin/goat-peering-wg-link up
ExecStop=/usr/local/sbin/goat-peering-wg-link down

[Install]
WantedBy=multi-user.target
