# {{ ansible_managed }}
WG_IFNAME={{ peering_wg_interface }}
WG_KEY_FILE={{ peering_wg_key_path }}
WG_LISTEN_PORT={{ peering_wg_listen_port }}
WG_MTU={{ peering_wg_mtu }}
WG_LINK_ADDR={{ peering_wg_local_link_ip }}/{{ peering_wg_link_prefix_len }}
WG_PEER_KEY={{ _pw_peer_key }}
WG_PEER_ALLOWED={{ peering_wg_remote_link_ip }}/32
{% if not (peering_wg_we_listen | bool) %}
WG_PEER_ENDPOINT={{ _pw_peer_endpoint }}
WG_PEER_KEEPALIVE={{ peering_wg_keepalive }}
{% endif %}
WG_NFT_FILE={{ peering_wg_nft_path }}
