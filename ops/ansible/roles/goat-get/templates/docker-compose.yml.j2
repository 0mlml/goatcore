# Generated by the goat-get Ansible role — do not edit on host.
# nginx:alpine serving {{ goat_get_www_dir }} (the goat-cli release
# binaries + landing index) read-only. Traefik routes to it via the
# file-provider config in /etc/traefik/dynamic/{{ goat_get_traefik_dynamic_filename }}.
services:
  {{ goat_get_container_name }}:
    image: "{{ goat_get_image }}"
    container_name: "{{ goat_get_container_name }}"
    restart: unless-stopped
    networks:
      # `mgmt` — Traefik resolves {{ goat_get_container_name }}:80 over this network.
      - "{{ goat_get_traefik_network }}"
    expose:
      - "{{ goat_get_internal_port }}"
    volumes:
      # Read-only bind of the served tree. nginx default_type is
      # application/octet-stream, so the extensionless `goat-*` binaries
      # download cleanly; index.html renders as text/html.
      - "{{ goat_get_www_dir }}:/usr/share/nginx/html:ro"
    # No Traefik docker labels — file-provider routing only.
    labels:
      - "traefik.enable=false"
    logging:
      driver: json-file
      options:
        max-size: "5m"
        max-file: "3"

networks:
  "{{ goat_get_traefik_network }}":
    external: true
    name: "{{ goat_get_traefik_network }}"
