# goatnet.toml: this goatnet's own facts for the goat CLI.
# Rendered by the goat-get role from this goatnet's group_vars; edit those, not this file.
# `goat context refresh` writes these keys into the context's profile.toml.
schema = "goat/goatnet/v1"
{% for k, v in goat_get_goatnet_facts.items() if (v | string) not in ['', 'none', 'None'] %}
{{ k }} = "{{ v }}"
{% endfor %}
