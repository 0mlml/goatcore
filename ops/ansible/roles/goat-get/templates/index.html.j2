<!DOCTYPE html>
<!-- Generated by the goat-get Ansible role — do not edit on host. -->
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>goat-cli download · {{ goat_get_hostname }}</title>
  <style>
    :root { color-scheme: dark; }
    body { font: 15px/1.6 ui-monospace, SFMono-Regular, Menlo, monospace;
           max-width: 46rem; margin: 3rem auto; padding: 0 1.2rem;
           background: #14110d; color: #e7dcc8; }
    h1 { font-size: 1.4rem; color: #e8b04b; }
    h2 { font-size: 1rem; color: #c9a35a; margin-top: 2rem; }
    a { color: #e8b04b; }
    code, pre { background: #211b13; }
    pre { padding: .9rem 1rem; border-radius: 6px; overflow-x: auto;
          border: 1px solid #3a2f1f; }
    small { color: #9a8c70; }
    /* Platform picker */
    .tabs { display: flex; flex-wrap: wrap; gap: .5rem; margin: 1.2rem 0 .4rem; }
    .tab { font: inherit; cursor: pointer; color: #e7dcc8;
           background: #211b13; border: 1px solid #3a2f1f; border-radius: 6px;
           padding: .4rem .8rem; }
    .tab:hover { border-color: #c9a35a; }
    .tab[aria-selected="true"] { background: #e8b04b; color: #14110d;
                                 border-color: #e8b04b; font-weight: 600; }
    .panel { display: none; }
    .panel.active { display: block; }
    .dl { display: inline-block; margin-top: .3rem; }
    details { margin-top: 2rem; }
    summary { cursor: pointer; color: #c9a35a; }
    .files a { display: inline-block; margin: .15rem .8rem .15rem 0; }
  </style>
</head>
<body>
  <h1>goat-cli — {{ goat_get_release_tag }}</h1>
  <p>The unified operator CLI for the goat fabric. Pick your platform — we
     preselect the one you're on; switch if we guessed wrong.</p>

{# Binary assets only (drop the aggregate SHA256SUMS + the per-asset
   *.sha256 sidecars; both are checksum text, not platform binaries). #}
{% set plats = [] %}
{% for bin in goat_get_assets if bin != 'SHA256SUMS' and not bin.endswith('.sha256') %}
{%   set _ = plats.append(bin[5:] | replace('.exe', '')) %}
{% endfor %}

  <div class="tabs" role="tablist">
{% for bin in goat_get_assets if bin != 'SHA256SUMS' and not bin.endswith('.sha256') %}
{%   set core = bin[5:] | replace('.exe', '') %}
{%   set os = core.split('-')[0] %}
{%   set arch = core.split('-')[1] %}
{%   set os_name = {'darwin': 'macOS', 'linux': 'Linux', 'windows': 'Windows'}[os] %}
{%   set arch_name = ({'arm64': 'Apple Silicon', 'amd64': 'Intel'}[arch] if os == 'darwin' else {'arm64': 'arm64', 'amd64': 'x86-64'}[arch]) %}
    <button class="tab" role="tab" data-plat="{{ core }}" aria-selected="false">{{ os_name }} · {{ arch_name }}</button>
{% endfor %}
  </div>

{% for bin in goat_get_assets if bin != 'SHA256SUMS' and not bin.endswith('.sha256') %}
{%   set core = bin[5:] | replace('.exe', '') %}
{%   set os = core.split('-')[0] %}
{%   set arch = core.split('-')[1] %}
{%   set os_name = {'darwin': 'macOS', 'linux': 'Linux', 'windows': 'Windows'}[os] %}
{%   set arch_name = ({'arm64': 'Apple Silicon', 'amd64': 'Intel'}[arch] if os == 'darwin' else {'arm64': 'arm64', 'amd64': 'x86-64'}[arch]) %}
  <section class="panel" role="tabpanel" data-plat="{{ core }}">
{% if os == 'windows' %}
    <h2>{{ os_name }} · {{ arch_name }} — install (Command Prompt)</h2>
    <pre>curl -fsSL https://{{ goat_get_hostname }}/{{ bin }} -o %USERPROFILE%\goat.exe
%USERPROFILE%\goat.exe --version</pre>
    <p><small>PowerShell:
       <code>iwr https://{{ goat_get_hostname }}/{{ bin }} -OutFile $env:USERPROFILE\goat.exe</code>
       then <code>&amp; $env:USERPROFILE\goat.exe --version</code>.
       Same binary either way; run one of them, not both.</small></p>
    <a class="dl" href="{{ bin }}">↓ {{ bin }}</a>
    <p><small>Move <code>goat.exe</code> somewhere on your <code>PATH</code>, then
       close the window and open a new one (PATH changes only apply to new windows).
       Verify: <code>certutil -hashfile %USERPROFILE%\goat.exe SHA256</code>
       (PowerShell: <code>(Get-FileHash $env:USERPROFILE\goat.exe -Algorithm SHA256).Hash</code>)
       against the <code>{{ bin }}</code> line in
       <a href="SHA256SUMS">SHA256SUMS</a>. The <code>goat client</code>
       tunnel-daemon commands aren't built for Windows yet — manage the mesh
       tunnel with the NetBird client; every other command works.</small></p>
{% else %}
    <h2>{{ os_name }} · {{ arch_name }} — install (one-time)</h2>
    <pre>(
set -eu   # stop on failure without changing your shell options
GOAT_INSTALL_DIR=$(mktemp -d)
trap 'rm -rf "$GOAT_INSTALL_DIR"' EXIT
cd "$GOAT_INSTALL_DIR"
curl -fsSL https://{{ goat_get_hostname }}/{{ bin }} -o {{ bin }}
curl -fsSL https://{{ goat_get_hostname }}/{{ bin }}.sha256 -o {{ bin }}.sha256
EXPECTED_SHA=$(awk '$2 == "{{ bin }}" { print $1 }' {{ bin }}.sha256)
printf '%s  {{ bin }}\n' "$EXPECTED_SHA" | {% if os == 'darwin' %}shasum -a 256{% else %}sha256sum{% endif %} -c - --strict
{% if os == 'darwin' %}codesign --force --sign - {{ bin }}   # macOS: clears the launch hang, after verification
{% endif %}sudo mkdir -p /usr/local/bin
sudo install -m 0755 {{ bin }} /usr/local/bin/goat
/usr/local/bin/goat --version
)</pre>
    <a class="dl" href="{{ bin }}">↓ {{ bin }}</a>
    <p><small><code>/usr/local/bin</code> is normally on the macOS and Linux shell
       <code>PATH</code>. If <code>goat</code> is not found afterward, add
       <code>/usr/local/bin</code> to your shell's <code>PATH</code>. (<code>~/.local/bin</code> is NOT reliably on <code>PATH</code>
       across distros — Arch never adds it, Ubuntu/Debian only if the folder
       already existed when the shell started — which is why this page no
       longer uses it.) Downloads use a fresh private directory and stop on failure.
       The checksum verifies only the selected asset,
       {% if os == 'darwin' %}before <code>codesign</code> re-signs it — re-signing changes the
       on-disk hash, so the checksum only matches the as-downloaded bytes —
       and {% endif %}before it moves into place, so a corrupt or tampered
       download is caught, not silently installed. Already have a
       <code>goat</code> from an older <code>~/.local/bin</code> install? It
       can shadow this one on <code>PATH</code> — remove it with
       <code>rm -f ~/.local/bin/goat</code>.</small></p>
{% endif %}
  </section>
{% endfor %}

  <h2>Load your profile</h2>
  <p><small><code>goat</code> ships trusting no goatnet, so <code>profile
     init</code> refuses until you add the root that signed your bundle —
     this step has to come first, not <code>profile init</code>.</small></p>
  <pre>goat ca add &lt;your-handle&gt;-goat-cli-ca.pem      # trust the CA, once per goatnet — beside the .cbor in your bundle
goat profile init &lt;your-handle&gt;-goat-cli.cbor   # the .cbor from your onboarding bundle
goat doctor                                      # verify reachability</pre>
  <p><small><code>goat ca add</code> prints a SHA-256 fingerprint — check it
     against one an operator gave you out of band before you rely on it.
     <code>goat ca ls</code> shows what's already trusted.</small></p>

{% if goat_get_kmod_enabled | default(false) %}
  <h2>Running a Jetson?</h2>
  <p><a href="{{ goat_get_kmod_www_subdir }}/">WireGuard kernel modules for Jetson → /{{ goat_get_kmod_www_subdir }}/</a>
     — the tegra kernels compile WireGuard out; these per-kernel module sets
     switch netbird from userspace to kernelspace (~2× throughput, lower CPU).</p>
{% endif %}

{% if goat_get_goatbuilder_enabled | default(false) %}
  <h2>Deploying or releasing?</h2>
  <p><a href="{{ goat_get_goatbuilder_www_subdir }}/">goatbuilder for platform admins → /{{ goat_get_goatbuilder_www_subdir }}/</a>
     — the build/release command-line for a goat environment: declare,
     converge, verify. {{ goat_get_goatbuilder_release_tag }}, signed; the same
     assets as the public release.</p>
{% endif %}

{% if goat_get_sdk_enabled | default(false) %}
  <h2>Building on the fabric?</h2>
  <p>The <a href="{{ goat_get_sdk_www_subdir }}/">grant-crypto SDK for developers → /{{ goat_get_sdk_www_subdir }}/</a>
     — the cross-language (Rust / Go / Python / TypeScript) library for
     member-only data encryption on the fabric.</p>
{% endif %}

  <details>
    <summary>All artifacts (air-gapped / manual)</summary>
    <p class="files">
{% for a in goat_get_assets %}      <a href="{{ a }}">{{ a }}</a>
{% endfor %}      <a href="SHA256SUMS">SHA256SUMS</a>
    </p>
  </details>

  <p><small>Served mesh-internally from {{ goat_get_hostname }}. Binaries
     mirror the signed goat-cli {{ goat_get_release_tag }} release.</small></p>

  <script>
    (function () {
      var PLATS = {{ plats | tojson }};
      var tabs = Array.prototype.slice.call(document.querySelectorAll('.tab'));
      var panels = Array.prototype.slice.call(document.querySelectorAll('.panel'));

      function select(plat) {
        tabs.forEach(function (t) {
          t.setAttribute('aria-selected', String(t.dataset.plat === plat));
        });
        panels.forEach(function (p) {
          p.classList.toggle('active', p.dataset.plat === plat);
        });
      }

      function guess() {
        var ua = navigator.userAgent || '';
        var p = navigator.platform || '';
        var arm = /arm|aarch64/i.test(ua);
        var g;
        if (/Win/i.test(p) || /Windows/i.test(ua)) g = 'windows-amd64';
        else if (/Mac/i.test(p) || /Mac OS X/i.test(ua)) g = 'darwin-arm64';
        else if (/Linux|X11/i.test(p) || /Linux/i.test(ua)) g = arm ? 'linux-arm64' : 'linux-amd64';
        // Fall back to the first served platform if the guess isn't available.
        return PLATS.indexOf(g) >= 0 ? g : PLATS[0];
      }

      tabs.forEach(function (t) {
        t.addEventListener('click', function () { select(t.dataset.plat); });
      });
      select(guess());
    })();
  </script>
</body>
</html>
