# Managed by ops/ansible/roles/breakglass-node — do not hand-edit.
#
# breakglass-clock-step-retry.timer — re-fires the clock step every
# {{ breakglass_clock_step_retry_interval_sec }}s until a time source is
# reachable, so a node powered on before its uplink came back self-heals with
# no operator action. The script writes /run/breakglass-clock-step.done and
# stops this timer on success, so it stops firing once the clock is right.
#
# Monotonic (OnBootSec/OnUnitActiveSec) on purpose: a wall-clock OnCalendar
# timer is meaningless while the very clock it exists to fix is wrong.

[Unit]
Description=Retry the HTTPS clock step until a time source is reachable
Documentation=file:///usr/local/sbin/breakglass-clock-step.sh
ConditionPathExists=!/run/breakglass-clock-step.done

[Timer]
OnBootSec={{ breakglass_clock_step_retry_interval_sec }}s
OnUnitActiveSec={{ breakglass_clock_step_retry_interval_sec }}s
Unit=breakglass-clock-step.service
AccuracySec=5s

[Install]
WantedBy=timers.target
