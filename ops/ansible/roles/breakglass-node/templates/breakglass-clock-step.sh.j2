#!/usr/bin/env bash
# Managed by ops/ansible/roles/breakglass-node — DO NOT EDIT ON HOST.
#
# Step this node's clock from HTTPS Date headers, and step it — never slew it.
#
# WHY A STEP AND NOT THE DAEMON. htpdate in daemon mode (-D) adjusts the clock
# by slewing, and a slew cannot cover a large offset. After a power cut wipes an
# RTC-less board's clock, the daemon logs "Adjusting <n> seconds / Time change
# failed" every 30 minutes while both overlay transports fail TLS as "not yet
# valid". -t turns off htpdate's sanity check; it does NOT make the daemon step.
# Only -s does.
#
# WHY IT RESTARTS THE OVERLAY CLIENTS. Once the clock is corrected, tailscaled
# stays logged out ("fetch control key: x509: certificate is not yet valid") and
# netbird stays off management until both are restarted. A node that fixes its
# clock and stays off the mesh has not recovered.
#
# The htpdate DAEMON stays running for steady-state discipline — sub-second
# drift is exactly what a slew is for. This script covers boot and recovery.
set -uo pipefail

SERVERS=({{ breakglass_http_time_servers | join(' ') }})
TOLERANCE={{ breakglass_clock_step_tolerance_sec }}
MIN_YEAR={{ breakglass_clock_min_year }}
CLIENTS=({{ breakglass_clock_step_restart_units | join(' ') }})
DONE_SENTINEL=/run/breakglass-clock-step.done
RETRY_TIMER=breakglass-clock-step-retry.timer
LOG_PREFIX="breakglass-clock-step:"

log() { logger -t breakglass-clock-step -s -- "$LOG_PREFIX $*"; }

# htpdate -q queries without touching the clock and prints "Offset <n> seconds"
# per reachable server (behaviour of htpdate 1.3.7; an
# unreachable server prints "host or service unavailable" and, if none is
# reachable, "No server suitable for synchronization found" with exit 1).
offset_seconds() {
  local out
  out=$(timeout "{{ breakglass_clock_step_query_timeout_sec }}" \
        /usr/sbin/htpdate -q -t "${SERVERS[@]}" 2>/dev/null) || return 1
  awk '/[Oo]ffset/ { for (i = 1; i <= NF; i++) if ($i ~ /^-?[0-9]+\.?[0-9]*$/) { print $i; exit } }' <<<"$out"
}

succeed() {
  touch "$DONE_SENTINEL"
  systemctl stop "$RETRY_TIMER" 2>/dev/null || true
  exit 0
}

offset=$(offset_seconds)
year=$(date -u +%Y)

if [ -z "$offset" ]; then
  # No time source reachable — the cold-boot-before-the-uplink case, not a
  # permanent failure. Do NOT write the sentinel; exit non-zero so the retry
  # timer fires again.
  log "no HTTP time source reachable (tried ${SERVERS[*]}); will retry"
  exit 1
fi

# abs(offset) as an integer — no bc on a minimal image, and the value carries a
# fraction we do not need.
abs_offset=${offset#-}
abs_int=${abs_offset%%.*}
[ -z "$abs_int" ] && abs_int=0

if [ "$abs_int" -le "$TOLERANCE" ] && [ "$year" -ge "$MIN_YEAR" ]; then
  log "clock plausible (offset ${offset}s, year ${year}); nothing to do"
  succeed
fi

log "clock off by ${offset}s (year ${year}) — stepping"
if ! timeout "{{ breakglass_clock_step_set_timeout_sec }}" /usr/sbin/htpdate -s -t "${SERVERS[@]}"; then
  log "step FAILED; will retry"
  exit 1
fi
log "clock stepped; now $(date -u --iso-8601=seconds)"

# Bounce the overlay clients, whose TLS the old clock had broken. Guarded on
# the size of the step so a one-second correction never bounces the mesh.
#
# --no-block IS LOAD-BEARING. This unit is ordered Before=tailscaled.service and
# Before=netbird.service, so a SYNCHRONOUS `systemctl restart` deadlocks: systemd
# stops the client, queues its start job behind this very unit, and this script
# then waits for a job that cannot run until the script exits. TimeoutStartSec
# then kills the script and marks the unit failed, and the client stays down for
# about two minutes, straight after the node has just recovered.
#
# --no-block queues the restart and returns, so the script finishes, the unit
# completes, and systemd runs the start job in the right order straight after.
for unit in "${CLIENTS[@]}"; do
  if systemctl is-enabled --quiet "$unit" 2>/dev/null; then
    log "queueing a restart of ${unit} after a ${offset}s clock step"
    systemctl --no-block restart "$unit" 2>/dev/null || log "restart of ${unit} could not be queued"
  fi
done

# Persist the corrected time immediately, so the next cold boot starts here
# rather than at the board's power-on epoch.
command -v fake-hwclock >/dev/null 2>&1 && fake-hwclock save 2>/dev/null || true

succeed
