# {{ ansible_managed }}
# spiffe-helper for grant-keyd (ZAGROS SPIRE Phase A). Fetches the CN-bearing
# X509-SVID from the SPIRE agent Workload API and writes cert+key+bundle into
# the shared `svid` volume grant-keyd reads. The SVID's Subject CN =
# grant-keyd-trial-peer (the SPIRE entry's first dns_name) so the CN-only Zenoh
# ACL carve (subject `infra-keyd`) admits its keys/** writes.
#
# grant-keyd uses the bundle (spire-bundle.pem) as its trust_bundle to VALIDATE
# member SVIDs, and the cert+key as both its mTLS client identity and its bundle
# signing key.

agent_address         = "/run/spire/sockets/agent.sock"
cmd                   = ""
cmd_args              = ""
cert_dir              = "/svid"
svid_file_name        = "grant-keyd-cert.pem"
svid_key_file_name    = "grant-keyd-key.pem"
svid_bundle_file_name = "spire-bundle.pem"
renew_signal          = ""
