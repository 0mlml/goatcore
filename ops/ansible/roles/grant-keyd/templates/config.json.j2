{
  "signer_id": "{{ grant_keyd_spiffe_path }}",
  "signing_key_pem": "/svid/grant-keyd-key.pem",
  "signer_svid_pem": "/svid/grant-keyd-cert.pem",
  "cert_dir": "/members",
  "trust_bundle": "/svid/spire-bundle.pem",
  "trust_domain": "{{ grant_keyd_trust_domain }}",
  "release_sets": {{ grant_keyd_release_sets | to_json }},
{% if grant_keyd_portal_uri_prefix %}
  "portal_ca_bundle": "/ca/ca-root.pem",
  "portal_uri_prefix": {{ grant_keyd_portal_uri_prefix | to_json }},
{% endif %}
{% if grant_keyd_portal_url %}
  "portal_url": {{ grant_keyd_portal_url | to_json }},
  "portal_token": {{ grant_keyd_portal_token | to_json }},
{% endif %}
  "poll_interval_secs": {{ grant_keyd_poll_interval_secs }},
  "zenoh_connect": ["{{ grant_keyd_zenoh_endpoint }}"],
  "zenoh_tls_root_ca": "/ca/ca-root.pem",
  "zenoh_tls_cert": "/svid/grant-keyd-cert.pem",
  "zenoh_tls_key": "/svid/grant-keyd-key.pem"
}
