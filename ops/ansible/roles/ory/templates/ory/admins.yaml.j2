# Initial admin identities for {{ site_name }} — rendered by the
# `ory` role from `site_admins` in per-site group_vars. Imported via
# `kratos identity import` (idempotent: re-imports of an existing
# identity are a no-op).
#
# password_hash format: bcrypt cost ≥ 12. Operator generates with:
#   htpasswd -nbBC 12 "" 'plaintext-password' | tr -d ':\n' | sed 's/^\$2y/\$2a/'
# (htpasswd uses $2y$ prefix; Kratos expects $2a$ or $2b$; sed swap.)
#
# These are committed only via group_vars/<site>_hosts/vault.yml or
# pulled from .envrc.local at Ansible-run time — never via plaintext
# in repo. The rendered admins.yaml on the target host is mode 0640.
{% for admin in site_admins %}
- traits:
    email: {{ admin.email | to_json }}
    name: {{ admin.name | to_json }}
{% if admin.groups is defined and admin.groups | length > 0 %}
    groups:
{% for g in admin.groups %}
      - {{ g | to_json }}
{% endfor %}
{% endif %}
  credentials:
    password:
      config:
        hashed_password: {{ admin.password_hash | to_json }}
  state: active
  schema_id: default
  verifiable_addresses:
    - value: {{ admin.email | to_json }}
      via: email
      verified: true
      verified_at: "1970-01-01T00:00:00Z"
      status: completed
  recovery_addresses:
    - value: {{ admin.email | to_json }}
      via: email
{% endfor %}
