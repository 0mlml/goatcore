# {{ ansible_managed }}
# ADR 1081 Layer 3 — re-apply host-local egress shaping (cake + DSCP steering)
# at boot. host egress only — NOT fabric QoS (ADR 1033 boundary, ADR 1081 L3).
[Unit]
Description=goat egress shaping (cake + control-plane priority) — ADR 1081 L3
Documentation=file://{{ egress_shaping_script_path }}
# Wait for the network so the default-route iface exists and is up.
After=network-online.target
Wants=network-online.target
ConditionPathExists={{ egress_shaping_script_path }}

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart={{ egress_shaping_script_path }}
# Best-effort teardown on stop/disable: drop the cake qdisc + nft table.
ExecStop={{ egress_shaping_teardown_path }}

[Install]
WantedBy=multi-user.target
