# Rendered by ops/ansible/roles/netbird-boot-selfheal/ — DO NOT EDIT ON HOST.
[Unit]
Description=NetBird boot-wedge self-heal — check every {{ netbird_selfheal_interval }}

[Timer]
# First check shortly after boot (the highest-risk window), then steady cadence
# so a mid-life wedge is also caught.
OnBootSec={{ netbird_selfheal_on_boot_sec }}
OnUnitActiveSec={{ netbird_selfheal_interval }}
AccuracySec=10s

[Install]
WantedBy=timers.target
