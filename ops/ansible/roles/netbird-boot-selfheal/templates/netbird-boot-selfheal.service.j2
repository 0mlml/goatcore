# Rendered by ops/ansible/roles/netbird-boot-selfheal/ — DO NOT EDIT ON HOST.
# Watchdog for the NetBird boot-time wedge. See the role + the script
# header + docs/design/netbird-boot-selfheal.md.
[Unit]
Description=NetBird boot-wedge self-heal check
After=netbird.service
# Don't block anything; this is a passive check.

[Service]
Type=oneshot
EnvironmentFile={{ netbird_selfheal_dir }}/netbird-boot-selfheal.env
ExecStart={{ netbird_selfheal_dir }}/netbird-boot-selfheal.sh
# The check is best-effort by design (netbird may be mid-restart). Never let
# systemd mark it failed-red — that would mask the real signal (the metric).
SuccessExitStatus=0 1
