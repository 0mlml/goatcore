# GENERATED by the names-collector role (ADR 1082 Amendment 2 §7.3).
# Passive self-claims collector — subscribes ops/names/claim/** and writes
# claims.json into the goat-get www dir. Reveal-only; never publishes.
[Unit]
Description=goat self-claims collector (names)
Documentation=docs/design/name-fallback-resolver.md
After=network-online.target docker.service
Wants=network-online.target
# The router must be up for the subscription to attach; the service
# retries on its own if it isn't (Restart below), so this is best-effort.
After=zenoh-router.service

[Service]
Type=simple
# --listen 0 = follow indefinitely: write claims.json on every received
# claim (freshest-per-name). load-existing on start preserves any file the
# get tier already serves, so a restart never blanks the surface.
ExecStart={{ names_collector_goat_bin }} \
    --profile-dir {{ names_collector_ctx_dir }} \
    --context collector \
    names collect --out {{ names_collector_out }} --listen 0
Restart=always
RestartSec=10
# The collector reads its context (0640 key) and writes claims.json in the
# goat-get www dir (root-owned). Runs as root for that write; it holds no
# secret beyond its own clientAuth leaf and never egresses anything but the
# subscription.
User=root
# Light sandboxing — no new privileges, private tmp; it needs network +
# read of its context + write of one file.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ReadWritePaths={{ names_collector_out | dirname }}

[Install]
WantedBy=multi-user.target
