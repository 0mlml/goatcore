# Managed by the luks-unlock Ansible role. Do not edit on the host.
[Unit]
Description=Run goat-unlock-health every {{ luks_health_interval }}

[Timer]
# Start after the post-boot unlock has had its full window, so the first reading
# is not a false "locked" during a normal boot.
OnBootSec={{ ((luks_postboot_unlock_attempts * luks_postboot_unlock_interval) + 120) }}s
OnUnitActiveSec={{ luks_health_interval }}
Persistent=false

[Install]
WantedBy=timers.target
