[Unit]
Description=Mount {{ vol.mount_point }} (LUKS-backed {{ vol.name }})
{# luks_cs_instance_names[vol.name] is the systemd-escaped form of vol.name
   (hyphens hex-escaped to \x2d). Templating systemd-cryptsetup@<vol.name>
   directly produces the wrong unit reference for any vol.name that contains
   a hyphen — see Block 65A.1 cold-boot-drill finding. #}
Requires=systemd-cryptsetup@{{ luks_cs_instance_names[vol.name] }}.service
After=systemd-cryptsetup@{{ luks_cs_instance_names[vol.name] }}.service

[Mount]
What=/dev/mapper/{{ vol.name }}
Where={{ vol.mount_point }}
Type={{ vol.filesystem }}
Options=defaults

[Install]
WantedBy=multi-user.target
{% for req in vol.systemd_requires | default([]) %}
RequiredBy={{ req }}
{% endfor %}
