# Managed by the luks-unlock Ansible role. Do not edit on the host.
[Unit]
Description=Unlock + mount LUKS {{ vol.name }} after boot
# After, never Before, the network: this runs once the system is already up.
# Deliberately NOT ordered before the consumers it starts — putting them behind
# this unit would re-create the boot-transaction coupling this design avoids.
After=network-online.target tangd.socket
Wants=network-online.target
ConditionPathExists=!{{ vol.mount_point }}/.unlock-disabled

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/goat-unlock-{{ vol.name }}.sh
TimeoutStartSec={{ (luks_postboot_unlock_attempts | int) * (luks_postboot_unlock_interval | int) + 120 }}

[Install]
WantedBy=multi-user.target
