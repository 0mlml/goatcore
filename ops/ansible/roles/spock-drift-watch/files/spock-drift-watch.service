[Unit]
Description=Spock ACE drift-watch (Block 52A.3 — interim L2a divergence detector)
Documentation=https://github.com/usareur-af/goatcore/blob/main/docs/design/replication-consistency-observability.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/spock-drift-watch.env
ExecStart=/usr/local/sbin/spock-drift-watch.sh
TimeoutStartSec=300

# Hardening — script needs network (psql to peers) + a writable
# textfile dir; nothing else.
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/node_exporter/textfile
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true

StandardOutput=journal
StandardError=journal
