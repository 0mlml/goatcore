# /etc/spock-drift-watch.env — managed by Ansible, do not edit by hand.
# Block 52A.3 — sourced by /usr/local/sbin/spock-drift-watch.sh.

SPOCK_DRIFT_SITE={{ spock_drift_watch_site | quote }}
SPOCK_DRIFT_TEXTFILE={{ (spock_drift_watch_textfile_dir + '/spock_ace_drift.prom') | quote }}
SPOCK_DRIFT_PEERS={{ spock_drift_watch_peers | to_json | quote }}
SPOCK_DRIFT_TABLES={{ spock_drift_watch_tables | to_json | quote }}

# Peer passwords — one env var per peer, named per peer's `password_env`.
# These are looked up from the running Ansible process's environment
# (typically populated from .envrc.local on the operator's workstation).
{% for peer in spock_drift_watch_peers %}
{% set var_name = peer.password_env %}
{{ var_name }}={{ lookup('env', var_name) | default('', true) | quote }}
{% endfor %}
