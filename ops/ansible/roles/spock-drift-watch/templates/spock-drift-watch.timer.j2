[Unit]
Description=Spock ACE drift-watch timer (Block 52A.3)
Documentation=https://github.com/usareur-af/goatcore/blob/main/docs/design/replication-consistency-observability.md

[Timer]
OnCalendar={{ spock_drift_watch_oncalendar }}
RandomizedDelaySec={{ spock_drift_watch_jitter_sec }}
AccuracySec=10s
Persistent=true
Unit=spock-drift-watch.service

[Install]
WantedBy=timers.target
