# /etc/wireguard/{{ wg_cp0_interface_name }}.conf
# Rendered by ansible/roles/wg-cp0-server (Block 22 / ADR 0313).
# DO NOT EDIT MANUALLY — re-running the role overwrites this file.
#
# Silent control-plane WireGuard listener for {{ inventory_hostname }}.
# Per-relay address: {{ wg_cp0_relay_address }} ({{ wg_cp0_subnet }})
# Listen port:       UDP {{ wg_cp0_listen_port }}
# Allowed peers:     {{ wg_cp0_allowed_peers | length }} configured

[Interface]
PrivateKey = {{ wg_cp0_privkey_b64 }}
Address    = {{ wg_cp0_relay_address }}/{{ wg_cp0_subnet | regex_replace('^.*/(\\d+)$', '\\1') }}
ListenPort = {{ wg_cp0_listen_port }}
# SaveConfig defaults to false (we manage this file via Ansible)

{% for peer in wg_cp0_allowed_peers %}

[Peer]
# {{ peer.name }}
PublicKey  = {{ peer.pubkey }}
AllowedIPs = {{ peer.allowed_ips | join(', ') }}
{% if wg_cp0_persistent_keepalive | int > 0 %}
PersistentKeepalive = {{ wg_cp0_persistent_keepalive }}
{% endif %}
{% endfor %}
