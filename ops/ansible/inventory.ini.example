# goat Ansible Inventory
#
# Copy to inventory.ini and fill in values.
# Never commit inventory.ini (gitignored).

[relay_servers]
# VPS relay instances — add one line per region
# relay-rla ansible_host=203.0.113.2
# relay-rlb ansible_host=<israel-ip>
# relay-rlc ansible_host=<region-3-ip>

[relay_servers:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=/tmp/relay-key.pem

[nethost]
# NETHOST infrastructure node — use mesh IP, not LAN IP
nethost-01 ansible_host=100.127.1.34

[nethost:vars]
ansible_user=goat
ansible_python_interpreter=/usr/bin/python3
# Optional: ansible_ssh_pass=<password> (set via NETHOST_PASS in .envrc.local)
