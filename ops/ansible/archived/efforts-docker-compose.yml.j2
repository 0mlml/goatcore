# Efforts — Docker Compose (Ansible-managed)
# Managed by ops/ansible/efforts.yml — do not edit on host.

services:
  efforts-db:
    image: postgres:16.4-alpine@sha256:5660c2cbfea50c7a9127d17dc4e48543eedd3d7a41a595a2dfa572471e37e64c
    container_name: efforts-db
    restart: unless-stopped
    environment:
      POSTGRES_DB: efforts
      POSTGRES_USER: efforts
      POSTGRES_PASSWORD: ${EFFORTS_PG_PASSWORD}
    volumes:
      - efforts-db-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U efforts -d efforts"]
      interval: 5s
      timeout: 3s
      retries: 5
    networks:
      - efforts-internal

  efforts:
    build: {{ efforts_dir }}/src
    container_name: efforts
    restart: unless-stopped
    ports:
      - "127.0.0.1:8090:8090"
    depends_on:
      efforts-db:
        condition: service_healthy
    environment:
      PORT: "8090"
      DATABASE_URL: "postgres://efforts:${EFFORTS_PG_PASSWORD}@efforts-db:5432/efforts?sslmode=disable"
      SITE_ID: "{{ efforts_site_id | default('primary') }}"
      ALLOW_ORIGIN: "https://explain.{{ netbird_domain }}"
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network={{ traefik_network | default('netbird_netbird') }}"
      - "traefik.http.routers.efforts.rule=Host(`efforts.{{ netbird_domain }}`)"
      - "traefik.http.routers.efforts.entrypoints=websecure"
      - "traefik.http.routers.efforts.tls=true"
      - "traefik.http.routers.efforts.middlewares=mesh-only"
      - "traefik.http.services.efforts.loadbalancer.server.port=8090"
    networks:
      - efforts-internal
      - {{ traefik_network | default('netbird_netbird') }}

volumes:
  efforts-db-data:

networks:
  efforts-internal:
    driver: bridge
  {{ traefik_network | default('netbird_netbird') }}:
    external: true
