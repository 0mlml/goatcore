{
  "name": "grant-crypto",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript/Node binding for the grant-crypto SDK (ADR 1106) over the hand-authored C ABI. Endpoint forward-secrecy: the platform holds no keys; only members decrypt, in-process.",
  "license": "SEE LICENSE IN ../../../../..",
  "type": "commonjs",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/src/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test dist/test/*.test.js",
    "example": "npm run build && node dist/examples/quickstart.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "koffi": "2.16.3"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "24.13.3"
  }
}
