{
  "signer_id": "zagros-key-service",
  "signing_key_pem": "/svid/grant-keyd-key.pem",
  "signer_svid_pem": "/svid/grant-keyd-cert.pem",
  "cert_dir": "/etc/keyd/members",
  "trust_bundle": "/opt/spire/data/server/spire-ca.pem",
  "trust_domain": "zagros.zagros.example",
  "release_sets": {
    "coalition-air": ["coalition-air/a", "coalition-air/b"]
  },
  "poll_interval_secs": 30,
  "metrics_listen": "0.0.0.0:9464",
  "zenoh_connect": ["tls/127.0.0.1:7447"],
  "zenoh_tls_root_ca": "/ca/ca-root.pem",
  "zenoh_tls_cert": "/svid/grant-keyd-cert.pem",
  "zenoh_tls_key": "/svid/grant-keyd-key.pem"
}
