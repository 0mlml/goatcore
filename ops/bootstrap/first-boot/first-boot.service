[Unit]
# Block 68 rapid-bringup first-boot oneshot.
#
# Activated by build-image-* scripts at image build time. Runs once at
# first boot to absorb USB userdata + serial-console secrets, then
# invokes site-bootstrap.yml against localhost. Subsequent boots are
# no-ops by virtue of the /var/lib/goat/first-boot-state.json
# completion marker.
#
# Spec: docs/project/block-68a-config-input-spike.md
Description=goat rapid-bringup first-boot
After=multi-user.target
ConditionPathExists=!/var/lib/goat/first-boot-state.json
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/console
TTYReset=yes

[Service]
Type=oneshot
ExecStart=/opt/goat/repo/ops/bootstrap/first-boot/first-boot.sh
RemainAfterExit=yes
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
