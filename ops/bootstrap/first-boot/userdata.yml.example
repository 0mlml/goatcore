---
# Block 68 rapid-bringup userdata.yml — annotated example.
#
# Operator workflow:
#   1. Copy this file to a fresh USB stick as `userdata.yml` at the root.
#   2. Edit fields per your bringup site.
#   3. Validate against ops/bootstrap/first-boot/userdata-schema.yml.
#   4. Eject + carry to bringup site.
#
# Secrets (PG_PASS, NB_ENCKEY, BKP_KEY, RELAY_SECRET, REPLICATOR_PASS,
# LUKS_PASS) are NOT in this file — they are typed at the serial console
# at first boot. This is deliberate: the image + USB combination
# discloses nothing operational if leaked.
#
# Spec: docs/project/block-68a-config-input-spike.md
# Schema: ops/bootstrap/first-boot/userdata-schema.yml

schema_version: 1

# Site name. Lowercase, hyphenated.
site_id: vega

# `full` = A/B mgmt-pair + obs-host C with full mgmt-stack.
# `postgres-spock-only` = single Orin, postgres-spock only (provisional sites).
mgmt_stack_profile: full

# A/B/C = host's role in a `full`-profile three-Orin site.
# Omit for single-Orin `postgres-spock-only` sites.
router_role: A

# Must match the image flashed to this host.
# orin-mgmt | orin-obs | karbon-mgmt
hardware_class: orin-mgmt

# total-loss = no surviving Spock peer (S1 — empty fresh start).
# spock-join = link to existing peer (S2 — Spock subscription will start).
scenario: spock-join

# wg-cp0 outer-tunnel reachability. Public, not secret.
wg_cp0_endpoint: relay-rla.goat.example:51820
wg_cp0_relay_pubkey: AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Required only when scenario = spock-join.
# URL of the existing peer site's mgmt-API + the Spock publisher endpoint
# (PG endpoint over wg-cp0, per ADR 0833).
peer_site_mgmt_api: https://198.18.0.1:443
peer_site_pg_endpoint: 198.18.0.1:5432
