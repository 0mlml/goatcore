{
  "$id": "https://schemas.proof.local/identity/operator.v1.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "federation-proof identity (traits only; external_subjects lives in metadata_public)",
  "type": "object",
  "properties": {
    "traits": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "title": "Email",
          "ory.sh/kratos": { "credentials": { "password": { "identifier": true } } }
        },
        "name": { "type": "string", "title": "Display name", "maxLength": 80 },
        "groups": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]{0,40}$" },
          "uniqueItems": true
        }
      },
      "required": ["email"],
      "additionalProperties": false
    }
  }
}
