{
  "realm": "goat",
  "enabled": true,
  "sslRequired": "none",
  "browserFlow": "x509 browser",
  "clients": [
    {
      "clientId": "kratos",
      "enabled": true,
      "publicClient": false,
      "secret": "kratos-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": ["http://kratos-idp:4433/self-service/methods/oidc/callback/cac"],
      "protocolMappers": [
        {
          "name": "edipi",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "username", "claim.name": "edipi", "jsonType.label": "String",
            "id.token.claim": "true", "access.token.claim": "true", "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "authenticationFlows": [
    {
      "alias": "x509 browser",
      "description": "Browser flow requiring a CAC x509 client certificate.",
      "providerId": "basic-flow", "topLevel": true, "builtIn": false,
      "authenticationExecutions": [
        { "authenticator": "auth-cookie", "requirement": "ALTERNATIVE", "priority": 10 },
        { "authenticator": "auth-x509-client-username-form", "requirement": "ALTERNATIVE", "priority": 20, "authenticatorConfig": "x509-edipi-config" }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "x509-edipi-config",
      "config": {
        "x509-cert-auth.mapping-source-selector": "Match SubjectDN using regular expression",
        "x509-cert-auth.regular-expression": "CN=[^,]*?\\.([0-9]+)",
        "x509-cert-auth.mapper-selector": "Username or Email",
        "x509-cert-auth.canonical-dn-enabled": "false",
        "x509-cert-auth.timestamp-validation-enabled": "true",
        "x509-cert-auth.crl-checking-enabled": "false",
        "x509-cert-auth.ocsp-checking-enabled": "false"
      }
    }
  ]
}
