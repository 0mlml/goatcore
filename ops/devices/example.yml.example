# Device manifest — canonical template (Phase F.4)
#
# Copy to ops/devices/<handle>.yml (gitignored) and edit.
# Validate:  ops/devices/validate.py ops/devices/<handle>.yml
# Schema:    ops/devices/schema/device-manifest.schema.json
# Mint:      goat admin client onboard <handle>
#
# Per-site fleet config (CA-id, age-identity / piv-slot, trust-anchor,
# snitch-collector) is NOT in this manifest — the wrapper reads those
# from env vars + CLI flags. Keep this manifest device-scoped only.

identity:
  handle: op-laptop        # kebab-case slug; filename = ops/devices/<handle>.yml
  role: operator-laptop           # one of: mgmt-host | orin | pi | operator-laptop |
                                  #          vendor-laptop | vendor-edge | mission-partner | inmate
  status: active                  # active | revoked
  added: 2026-05-31
  added_by: person-900@example.org
  notes: Lead engineer laptop, Apple Silicon M2 Max.

device:
  device_id: op-laptop     # passed to bundle-create -device-id
  site: nova                 # passed to bundle-create -site
  # peer_pubkey omitted — bundle-create generates placeholder.

bundle:
  acl_groups:                     # passed to bundle-create -acl-groups (comma-joined)
    - NOVA
    - NOVA-OPERATOR
  ttl_days: 365                   # default 365; max 730
  activation_days: 14             # default 14 (per ADR 0308 §3.1)
  # mesh_route_subnet: 198.18.0.0/24   # uncomment for mgmt-host Orins
  snitch: false                   # mint snitch_probe_key + embed (Block 61); default false
