# Restart CoreDNS after Netbird assigns the mesh IP.
# CoreDNS binds to the mesh IP (100.127.1.32), which isn't available
# until Netbird connects. This service waits for the IP, then restarts
# the DNS container so it can bind successfully.
#
# Deployed by Ansible (nethost-status.yml or site.yml).

[Unit]
Description=Restart CoreDNS after Netbird mesh IP is available
After=netbird.service
Wants=netbird.service

[Service]
Type=oneshot
# Wait up to 2 minutes for the mesh IP to appear
ExecStart=/bin/bash -c 'for i in $(seq 1 24); do ip addr show | grep -q 100.127.1.32 && break; sleep 5; done && cd /opt/goat/dns && docker compose restart'
RemainAfterExit=true

[Install]
WantedBy=multi-user.target
