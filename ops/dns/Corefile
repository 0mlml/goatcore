# goat — mesh DNS server (CoreDNS)
# Replaces jpillora/dnsmasq. Same mesh-hosts file, port 5353.
# Netbird nameserver group must query 100.127.1.28:5353.

.:5353 {
    # Mirror dnsmasq bind-interfaces: listen only on loopback and mesh interface.
    bind 127.0.0.1 100.127.1.28

    # Serve all records from mesh-hosts (standard /etc/hosts format).
    # reload 5s picks up peer additions without a container restart (like dnsmasq's SIGHUP).
    hosts /etc/mesh-hosts {
        reload 5s
        no_reverse
        fallthrough
    }

    # Forward non-mesh queries to public DNS.
    # Plain UDP matches dnsmasq behavior. DoT upgrade is a P2 item.
    forward . 1.1.1.1 8.8.8.8

    # Cache responses — survives upstream outages for cached entries.
    cache 1000

    log
    errors
}
